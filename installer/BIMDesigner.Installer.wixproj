<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    The Windows installer: an MSI of what dotnet publish made, for every user of the machine,
    with a Start menu shortcut and .bimx files opening in BIMDesigner. Built by build/release.ps1,
    which publishes the app first and signs both; it is not part of the solution, so building
    and testing the app does not need WiX.
  -->

  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.5.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\</PublishDir>
    <OutputName>BIMDesigner-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion);IconFile=$(MSBuildThisFileDirectory)..\BIMDesigner.UI\Assets\BIMDesigner.ico</DefineConstants>
  </PropertyGroup>

</Project>
