<Window x:Class="BIMDesigner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BIMDesigner.UI.Controls"
        xmlns:vm="clr-namespace:BIMDesigner.UI.ViewModels"
        mc:Ignorable="d"
        Title="BIMDesigner" Height="740" Width="1220"
        MinHeight="420" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Closing="OnWindowClosing">

    <Window.InputBindings>
        <!-- New/Open/Save/Undo/Redo/Delete already carry their standard gestures. -->
        <KeyBinding Command="SaveAs" Key="S" Modifiers="Ctrl+Shift"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="OnNewProject"/>
        <CommandBinding Command="Open" Executed="OnOpenProject"/>
        <CommandBinding Command="Save" Executed="OnSaveProject"/>
        <CommandBinding Command="SaveAs" Executed="OnSaveProjectAs"/>
        <CommandBinding Command="Undo" Executed="OnUndo" CanExecute="OnCanUndo"/>
        <CommandBinding Command="Redo" Executed="OnRedo" CanExecute="OnCanRedo"/>
        <CommandBinding Command="Delete" Executed="OnDeleteSelected" CanExecute="OnCanDelete"/>
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            Every keyed style below sets BasedOn. An explicit Style replaces the implicit
            theme style outright, so without it a control silently reverts to WPF's stock
            light template - which is what made these ComboBoxes unreadable.
        -->

        <!-- Section caption: "PROJECT BROWSER", "INSTANCE PARAMETERS". -->
        <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="14,14,14,8"/>
        </Style>

        <!-- The Properties palette, as Revit's: groups that fold shut under a band with a
             chevron, and rows ruled into a two-column grid. -->
        <vm:PaletteGroupState x:Key="PaletteGroupOpen"/>

        <Style x:Key="PaletteGroupHeader" TargetType="ToggleButton">
            <EventSetter Event="Click" Handler="OnPaletteGroupToggled"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Band" Background="{StaticResource Bg.Elevated}" Padding="6,4"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Chevron" Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Text.Muted}"
                                      Width="8" Height="5" Margin="2,0,8,0" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Band" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaletteGroup" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton x:Name="Header" Style="{StaticResource PaletteGroupHeader}"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding Name, Mode=OneTime, Converter={StaticResource PaletteGroupOpen}}"/>
                            <ItemsPresenter x:Name="Rows"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Header" Property="IsChecked" Value="False">
                                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A heading between the palette's sections: Type Properties, Structure. -->
        <Style x:Key="PaletteSectionBand" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.Window}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Toolbar tool buttons behave like radio buttons: one active tool at a time. -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="4" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="OptionCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- The narrow arrow beside a ribbon button that opens its list, as on Revit's Wall button. -->
        <Style x:Key="RibbonDropArrow" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Margin" Value="-2,0,2,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2">
                            <Path Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Text}" Width="8" Height="5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The wall shapes on the Place Wall tab: one of them at a time, apart from the tools. -->
        <Style x:Key="WallShapeRadio" TargetType="RadioButton" BasedOn="{StaticResource RibbonSmallRadio}">
            <Setter Property="GroupName" Value="WallShape"/>
            <EventSetter Event="Click" Handler="OnPlaceWallShape"/>
        </Style>

        <!-- The draw tools of a roof sketch: one at a time. -->
        <Style x:Key="RoofSketchRadio" TargetType="RadioButton" BasedOn="{StaticResource RibbonSmallRadio}">
            <Setter Property="GroupName" Value="RoofSketch"/>
            <EventSetter Event="Click" Handler="OnRoofSketchTool"/>
        </Style>

        <Style x:Key="WallShapeLargeRadio" TargetType="RadioButton">
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="GroupName" Value="WallShape"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="MaxWidth" Value="76"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template" Value="{StaticResource RibbonLargeTemplate}"/>
            <EventSetter Event="Click" Handler="OnPlaceWallShape"/>
        </Style>

        <!-- The strip under a view that says how it is drawn: scale, detail, style. -->
        <Style x:Key="ViewControlBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="ViewControlCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,12,0"/>
        </Style>

        <Style x:Key="ViewControlCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="ViewControlButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,2"/>
        </Style>

        <Style x:Key="ViewControlToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,2"/>
        </Style>

        <!-- The navigation bar under the ViewCube: a column of small square buttons. -->
        <Style x:Key="NavigationBar" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2,4,0"/>
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button">
            <Style.Resources>
                <Style TargetType="Path">
                    <Setter Property="Stroke" Value="{StaticResource Text}"/>
                    <Setter Property="StrokeThickness" Value="1.5"/>
                    <Setter Property="Width" Value="16"/>
                    <Setter Property="Height" Value="16"/>
                </Style>
            </Style.Resources>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One parameter, as a row of the palette's ruled grid: its name on the left, and on
             the right an editor chosen by the parameter itself. -->
        <DataTemplate DataType="{x:Type vm:ParameterRow}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="55*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,0,6,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Computed values: length, area, volume. Not editable by design. -->
                    <TextBlock Grid.Column="1" Text="{Binding Text, Mode=OneWay}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="6,0" Foreground="{StaticResource Text.Muted}"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center" Margin="2,1" Padding="4,1" MinHeight="22"
                             Visibility="{Binding IsEditableText, Converter={StaticResource BoolToVisibility}}"/>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding SelectedChoice}" VerticalAlignment="Center" Margin="2,1" Padding="6,1" MinHeight="22"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"/>

                    <CheckBox Grid.Column="1" IsChecked="{Binding Flag}" VerticalAlignment="Center" Margin="6,0"
                              Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ParameterList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- quick access -->
            <RowDefinition Height="Auto"/>   <!-- ribbon -->
            <RowDefinition Height="Auto"/>   <!-- options bar -->
            <RowDefinition Height="*"/>      <!-- workspace -->
            <RowDefinition Height="Auto"/>   <!-- schedule splitter -->
            <RowDefinition Height="Auto"/>   <!-- schedule view -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ======================== QUICK ACCESS ======================== -->
        <Border Grid.Row="0" Background="{StaticResource Bg.Window}" Padding="6,2">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Open}" Command="Open" ToolTip="Open project (Ctrl+O)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Save}" Command="Save" ToolTip="Save (Ctrl+S)"/>
                <Rectangle Width="1" Margin="5,3" Fill="{StaticResource Line}"/>
                <Button x:Name="QuickUndo" Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Undo}" Command="Undo" ToolTip="Undo (Ctrl+Z)"/>
                <Button x:Name="QuickRedo" Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Redo}" Command="Redo" ToolTip="Redo (Ctrl+Y)"/>
                <Rectangle Width="1" Margin="5,3" Fill="{StaticResource Line}"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Print}" Click="OnPrintSheets" ToolTip="Print (Ctrl+P)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Dimension}" Click="OnQuickDimension" ToolTip="Dimension (M)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Text}" Click="OnQuickText" ToolTip="Text (E)"/>
                <Rectangle Width="1" Margin="5,3" Fill="{StaticResource Line}"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.View3D}" Click="OnToggle3D" ToolTip="3D view (Ctrl+3)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Section}" Click="OnQuickSection" ToolTip="Section (C)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Tile}" Click="OnQuickTile" ToolTip="Tile the plan and the 3D view side by side"/>
            </StackPanel>
        </Border>

        <!-- =========================== RIBBON =========================== -->
        <DockPanel Grid.Row="1" Background="{StaticResource Bg.Window}">
            <!-- The File menu hangs off the blue button, as in CAD ribbons. -->
            <Button x:Name="FileButton" DockPanel.Dock="Left" VerticalAlignment="Top" Content="File"
                    Style="{StaticResource FileTabButton}" Click="OnFileButton">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_New Project" Command="New" InputGestureText="Ctrl+N">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.New}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Open Project..." Command="Open" InputGestureText="Ctrl+O">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Open}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open IF_C..." Click="OnImportIfc"
                                  ToolTip="Read an IFC2x3 or IFC4 model into a new project: its storeys, walls with their layers, doors and windows, floors, roofs, ceilings, rooms and grids - and everything else as its shape"/>
                        <MenuItem Header="Open _Recent" SubmenuOpened="OnRecentOpened"
                                  ToolTip="The projects opened or saved before, newest first - the home screen lists them with a picture of each">
                            <MenuItem Header="No recent projects" IsEnabled="False"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="_Save" Command="Save" InputGestureText="Ctrl+S">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Save}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save _As..." Command="SaveAs" InputGestureText="Ctrl+Shift+S"/>
                        <MenuItem Header="_Close Project" Click="OnCloseProject"
                                  ToolTip="Close this project - asking about anything not saved - and go back to the home screen"/>
                        <Separator/>
                        <MenuItem x:Name="UndoItem" Header="_Undo" Command="Undo" InputGestureText="Ctrl+Z">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Undo}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RedoItem" Header="_Redo" Command="Redo" InputGestureText="Ctrl+Y">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Redo}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Import DW_G or DXF..." Click="OnImportCad"
                                  ToolTip="A DWG or DXF drawing - a survey, a consultant's layout, an existing building's plans - brought onto the storey shown to work over: the drawing tools snap to its lines"/>
                        <MenuItem Header="Export _IFC..." Click="OnExportIfc">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Export}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Export IFC _2x3..." Click="OnExportIfc2x3"
                                  ToolTip="The model as IFC2x3 Coordination View 2.0, for software that does not yet read IFC4"/>
                        <MenuItem Header="Export _COBie..." Click="OnExportCobie"
                                  ToolTip="The building handed over as a COBie spreadsheet: floors, spaces, and what is kept up in them"/>
                        <MenuItem Header="Export _gbXML..." Click="OnExportGbXml"
                                  ToolTip="The building for energy analysis - OpenStudio and EnergyPlus, IES VE, DesignBuilder: each room a space, its walls, floors and roofs at their centre lines with their constructions and U-values, its windows and doors"/>
                        <MenuItem Header="Export Plan to D_WG or DXF..." Click="OnExportPlanCad"
                                  ToolTip="The plan shown, as a DWG or DXF drawing at full size in millimetres, each kind of element on its own layer"/>
                        <MenuItem Header="Export This Sheet to DWG or DX_F..." Click="OnExportSheetCad"
                                  ToolTip="The sheet open, as a DWG or DXF drawing at paper size in millimetres"/>
                        <MenuItem Header="_Export This Sheet to PDF..." Click="OnExportSheetPdf">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Pdf}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Export _Drawing Set to PDF..." Click="OnExportDrawingSetPdf"/>
                        <MenuItem Header="_Print..." Click="OnPrintSheets" InputGestureText="Ctrl+P">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Print}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open .bimx Files with This Copy" Click="OnRegisterFileTypes"
                                  ToolTip="Double-clicking a project file opens it in this copy of BIMDesigner - for a copy run where it was built; the installer does this for everyone"/>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="OnExit"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <TabControl x:Name="Ribbon" Style="{StaticResource RibbonTabs}">
                <!-- ========================= ARCHITECTURE ========================= -->
                <TabItem Header="Architecture" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Select" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="SelectTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Select}"
                                         Content="Modify" IsChecked="True" Checked="OnToolChanged" ToolTip="Select and edit elements (S)"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Build" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WallTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Wall}"
                                             Content="Wall" Checked="OnToolChanged" ToolTip="Draw walls, including curtain walls (W)"/>
                                <Button x:Name="WallMenuButton" Style="{StaticResource RibbonDropArrow}" Click="OnWallMenu"
                                        AutomationProperties.Name="Wall options"
                                        ToolTip="Every way to draw a wall: shapes, place by segment or room, sweeps and reveals, auto join"/>
                                <RadioButton x:Name="DoorTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Door}"
                                             Content="Door" Checked="OnToolChanged" ToolTip="Place a door in a wall (D)"/>
                                <RadioButton x:Name="WindowTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Window}"
                                             Content="Window" Checked="OnToolChanged" ToolTip="Place a window in a wall (N)"/>
                                <RadioButton x:Name="ComponentTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Room}"
                                             Content="Component" Checked="OnToolChanged"
                                             ToolTip="Place a component: furniture, casework, a fixture. Space turns it before you click"/>
                                <!-- Three high, so the tab fits a 1366-wide screen. -->
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="ColumnTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Column}"
                                                 Content="Column" Checked="OnToolChanged"
                                                 ToolTip="Stand an architectural column: the box-out round a structural column, a pier or a pilaster. Space turns it"/>
                                    <RadioButton x:Name="FloorTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Floor}"
                                                 Content="Floor" Checked="OnToolChanged" ToolTip="Lay a floor over an enclosed space (F2)"/>
                                    <RadioButton x:Name="CeilingTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Ceiling}"
                                                 Content="Ceiling" Checked="OnToolChanged" ToolTip="Put a ceiling over an enclosed space (F3)"/>
                                </StackPanel>

                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Roof" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RoofTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Roof}"
                                             Content="Roof" Checked="OnToolChanged"
                                             ToolTip="Roof by Footprint: sketch the roof's outline or pick the walls it sits on, and say which edges slope (F4)"/>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="RoofExtrusionTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.RoofExtrusion}"
                                                 Content="By Extrusion" Checked="OnToolChanged"
                                                 ToolTip="Roof by Extrusion: click the line the profile is drawn on and how far the roof runs back, then draw its section - a gambrel, a barrel vault, any roof the same all along"/>
                                    <RadioButton x:Name="DormerTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.Roof}"
                                                 Content="Dormer" Checked="OnToolChanged"
                                                 ToolTip="Click on a roof's slope: a whole dormer is built there - walls standing on the roof, a gable, shed or hip roof on them joined into the main roof, and the main roof opened under it. Shape and size on the options bar"/>
                                    <RadioButton x:Name="RoofWindowTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.RoofWindow}"
                                                 Content="Roof Window" Checked="OnToolChanged"
                                                 ToolTip="Roof Window: click on a roof's slope - in plan or in 3D - and a roof window goes in it, lined up with the slope, the roof cut away under it"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="FasciaTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.Fascia}"
                                                 Content="Fascia" Checked="OnToolChanged"
                                                 ToolTip="Roof: Fascia. Click a roof's edges one after another: a board runs along them all, covering the ends of the roof, mitred round the corners and up the verges. Esc finishes it"/>
                                    <RadioButton x:Name="GutterTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.Gutter}"
                                                 Content="Gutter" Checked="OnToolChanged"
                                                 ToolTip="Roof: Gutter. Click a roof's eaves one after another: a gutter hangs along them, off the fascia if there is one. Esc finishes it"/>
                                    <RadioButton x:Name="SoffitTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.Soffit}"
                                                 Content="Soffit" Checked="OnToolChanged"
                                                 ToolTip="Roof: Soffit. Click a roof's eaves: a board closes the underside of the overhang, from the fascia back to the wall. Esc finishes it"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="EaveTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.Eave}"
                                                 Content="Eave" Checked="OnToolChanged"
                                                 ToolTip="Eave: click a roof's eaves one after another and an eave is built under them, of the kind its type is - closed under a sloping soffit, open with its rafters on show, exposed rafter tails cut to a shape, a box cornice with frieze and moulding, or abbreviated close to the wall - with brackets, corbels or knee braces if it has them. The roof is cut back to its rafters over it. Esc finishes it"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="DownpipeTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.Downpipe}"
                                                 Content="Downpipe" Checked="OnToolChanged"
                                                 ToolTip="Downpipe: click on a gutter - in plan or in 3D - and a downpipe takes the water from there: an outlet in the gutter's bottom, a swan neck back to the wall, down the wall to the ground and a shoe at its foot. A dormer's lets its water onto the roof below. Section and size come from the gutter's type"/>
                                    <RadioButton x:Name="RoofDrainTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.RoofDrain}"
                                                 Content="Roof Drain" Checked="OnToolChanged"
                                                 ToolTip="Roof Drain: click on a flat roof - in plan or 3D - where a rainwater outlet goes. The roof's insulation is tapered to fall to its drains. Near the edge the water goes out through it to a hopper head and downpipe; further in, down a rainwater pipe inside the building"/>
                                    <RadioButton x:Name="ChimneyTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.Chimney}"
                                                 Content="Chimney" Checked="OnToolChanged"
                                                 ToolTip="Chimney: click where the stack goes - in plan, or on a roof in 3D. It rises from the storey up through the roof, as far above it as the height rule asks (Approved Document J, or the US 3-2-10 rule), capped with a pot on each flue"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Stair &amp; Ramp" Style="{StaticResource RibbonPanel}">
                            <StackPanel>
                                <RadioButton x:Name="StairTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Stair}"
                                             Content="Stair" Checked="OnToolChanged"
                                             ToolTip="Stair: click where its first riser goes, then which way is up. It runs up to the level above - straight, turning on a landing or winders, spiral, curved or split in two - its risers worked out from the storey's height, checked against Approved Document K or the IRC, and cuts its opening in the floor over it"/>
                                <RadioButton x:Name="RampTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Ramp}"
                                             Content="Ramp" Checked="OnToolChanged"
                                             ToolTip="Ramp: click where it starts, then which way it runs - up from the ground to this storey's floor, or down from the edge of a floor, a doorway or a terrace to the ground. It lays out its own flights and landings at the gradient you give it - no flight longer than Approved Document M allows (2 m at 1:12, 5 m at 1:15, 10 m at 1:20) or rising more than the ADA's 30 in - with landings at its turns and its head, kerbs, handrails both sides where asked, and guarding where it stands high. Shape Custom: click along its walking line and double-click"/>
                                <RadioButton x:Name="RailingTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Railing}"
                                             Content="Railing" Checked="OnToolChanged"
                                             ToolTip="Railing: click along where it runs - each corner - and double-click where it ends, or click its first point to take it all the way round. It stands on the balcony, terrace or floor under it and is checked for its height there - 1100 round a balcony or a roof, 900 at a floor's edge inside a home (Approved Document K), 36 in under the IRC - and for gaps a child's head goes through. To guard a whole balcony or terrace, pick it and use Guard Edges"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Curtain" Style="{StaticResource RibbonPanel}">
                            <StackPanel>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.CurtainGrid}"
                                        Content="Curtain Grid" Click="OnEditCurtainGrid"
                                        ToolTip="Add, move or delete the grid lines of the selected curtain wall, and make panels solid, empty or doors"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.WallTypes}"
                                        Content="Wall Types" Click="OnManageWallTypes"
                                        ToolTip="Layered, stacked and curtain wall types"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Mullion}"
                                        Content="Mullion Types" Click="OnMullionTypes"
                                        ToolTip="The mullion types curtain walls are framed with - boxes, capped, round, steel, timber and corner sections - their sizes, offset, cover cap and material, and how stiff each is. A curtain wall type puts one on each of its lines in its Type Properties; Curtain Grid changes one stretch of one line"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Wall" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <RadioButton x:Name="SweepTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Sweep}"
                                                 Content="Sweep" Checked="OnToolChanged"
                                                 ToolTip="Place a skirting, cornice or other profile along a wall, or upright on it"/>
                                    <RadioButton x:Name="RevealTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Reveal}"
                                                 Content="Reveal" Checked="OnToolChanged"
                                                 ToolTip="Cut a groove along a wall, or up it"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Profile}"
                                            Content="Edit Profile" Click="OnEditProfile"
                                            ToolTip="Change the outline of the selected straight wall seen square-on: a gable, steps, a notch"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachTop}"
                                            Content="Attach Top" Click="OnAttachTops"
                                            ToolTip="Take the selected walls up to the floor, ceiling or roof over each"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachBase}"
                                            Content="Attach Base" Click="OnAttachBases"
                                            ToolTip="Stand the selected walls on the floor under each"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Detach}"
                                            Content="Detach" Click="OnDetachWalls"
                                            ToolTip="Detach the tops and bases of the selected walls"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Room &amp; Datum" Style="{StaticResource RibbonPanel}">
                            <StackPanel>
                                <RadioButton x:Name="RoomTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Room}"
                                             Content="Room" Checked="OnToolChanged" ToolTip="Place a room in an enclosed space (R)"/>
                                <RadioButton x:Name="RoomSeparatorTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.RoomSeparator}"
                                             Content="Separator" Checked="OnToolChanged"
                                             ToolTip="Room Separator: draw a line rooms are bounded by where there is no wall - between a kitchen and the living room it opens onto, across an alcove, along an open office"/>
                                <RadioButton x:Name="GridTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Grid}"
                                             Content="Grid" Checked="OnToolChanged" ToolTip="Draw a setting-out gridline (G). Storeys are added and changed under Manage > Levels"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- =========================== STRUCTURE =========================== -->
                <TabItem Header="Structure" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Framing" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="StructuralColumnTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.StructuralColumn}"
                                             Content="Column" Checked="OnToolChanged"
                                             ToolTip="Structural Column: click where it stands, or select gridlines and use At Grids. Steel universal columns, square and round hollow sections - 3 in Schedule 40 pipe the least the IRC takes - timber posts, glulam and concrete. Its Properties give the load it carries and the rules it meets: 30 minutes' fire resistance holding up a floor (Approved Document B), the IRC's sizes, rust paint and decay protection"/>
                                <RadioButton x:Name="BeamTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Beam}"
                                             Content="Beam" Checked="OnToolChanged"
                                             ToolTip="Beam: click where it starts and where it ends - it hangs from this level, its top there, under the floor it carries, and the next starts where it ended. Steel universal beams and wide flanges, C24 timber, GL24h glulam and concrete. A stair's headroom is measured to its underside, and it says when it crosses a doorway below the door's head"/>
                                <RadioButton x:Name="JoistsTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Joists}"
                                             Content="Joists" Checked="OnToolChanged"
                                             ToolTip="Joist layout: click the corners of the outline the joists fill. They run across the short way at the spacing on the option bar - 400 is usual - and stop short of a stairwell or shaft in the floor they carry, trimmers across its ends. Joist Direction in Properties turns them"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Foundation" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PadFootingTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.PadFooting}"
                                             Content="Isolated" Checked="OnToolChanged"
                                             ToolTip="Isolated Foundation: click a structural column and a pad goes under it with a pier up to it - sized for the load it brings down, on the ground the project stands on, and as deep as the rules ask - or click anywhere for a pad on its own"/>
                                <RadioButton x:Name="WallFootingTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.WallFooting}"
                                             Content="Wall" Checked="OnToolChanged"
                                             ToolTip="Wall Foundation: click a wall and a strip footing goes under it with the masonry up to it - as wide as Approved Document A's Table 10 or the IRC's Table R403.1 asks for the load and the ground, and as deep as frost, clay or the frost line asks. The ground is in the plan's Properties"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Floor" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="SlabEdgeTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.SlabEdge}"
                                         Content="Slab Edge" Checked="OnToolChanged"
                                         ToolTip="Run a thickened edge, an edge beam or a kerb along a floor's edges: click them one after another, round the corners; Esc finishes"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Opening" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ShaftTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Shaft}"
                                             Content="Shaft" Checked="OnToolChanged"
                                             ToolTip="Shaft Opening: click where it goes - in plan or on a roof or floor in 3D - and a hole is cut straight down through the roofs, floors and ceilings there: a stairwell, lift shaft or riser. For a chimney stack, use Chimney"/>
                                <RadioButton x:Name="FaceOpeningTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.FaceOpening}"
                                             Content="By Face" Checked="OnToolChanged"
                                             ToolTip="Opening by Face: click on a roof's face - in plan or 3D - and a rectangular opening is cut square to its slope, for a rooflight or hatch trimmed between the rafters"/>
                                <RadioButton x:Name="WallOpeningTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.WallOpening}"
                                             Content="Wall Opening" Checked="OnToolChanged"
                                             ToolTip="Cut a rectangular opening through a wall, curved walls included"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================= SYSTEMS ============================= -->
                <!-- The building services: fittings placed, joined into systems from what feeds
                     them, and each storey's mechanical, electrical and plumbing plans. -->
                <TabItem Header="Systems" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Fittings" Style="{StaticResource RibbonPanel}">
                            <Button x:Name="FittingButton" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Fitting}"
                                    Content="Fitting" Click="OnPlaceFitting"
                                    ToolTip="Place a fitting of the services: a basin, WC, bath, shower or sink; a radiator, underfloor heating, boiler, heat pump, cylinder, stop valve or gas meter; a gas cooker, fire, water heater or dryer; a sprinkler or its valve set; a socket, switch, light, consumer unit or alarm. Each has its connectors - hot and cold, waste, flow and return, power - to join systems by"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Piping" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PipeTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Pipe}"
                                             Content="Pipe" Checked="OnToolChanged"
                                             ToolTip="Pipe: click a fitting's connector, the end of a pipe or a point along one, then where the pipe goes. It runs level at the height on the option bar, rises or drops to the fitting or pipe it ends at, and puts the fitting on its system. Copper, PE-X, stainless or galvanised steel, in their sizes - and for gas in the US, Schedule 40 steel"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.SizePipes}"
                                            Content="Size Pipes" Click="OnSizePipes"
                                            ToolTip="Size the pipes: cold and hot water as BS EN 806-3 asks - each section by the loading units of the draw-offs beyond it, read off Table 3 for its material - heating for the heat beyond each, the water kept to 1.0 m/s and 300 Pa a metre; and gas for the appliances beyond each, within BS 6891's 1 mbar from the meter to every appliance - in the US by the IRC's branch length method on Table G2413.4(1); and sprinklers so the valve set's supply gives the most demanding room's sprinklers their listed flow"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Pipe}"
                                            Content="Long Section" Click="OnDrainSection"
                                            ToolTip="Select a drain below the ground, then see its run from its head to its outfall: the ground over it, its inverts and gradients, its sizes, and each access point's cover level, invert and depth"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Ductwork" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DuctTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Duct}"
                                             Content="Duct" Checked="OnToolChanged"
                                             ToolTip="Duct: click a spigot - a heat recovery unit's, a valve's, an outside terminal's - the end of a duct or a point along one, then where the duct goes. It runs level at the height on the option bar, rises or drops to what it ends at, and puts it on its system. Galvanised spiral, PVC round, PVC flat channel or flexible"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.SizeDucts}"
                                            Content="Size Ducts" Click="OnSizeDucts"
                                            ToolTip="Size the ducts of each ventilation system by equal friction, so the system's designed static pressure keeps within Approved Document F's Table 1.8 for the air it moves"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Environment" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.HeatLoss}"
                                        Content="Heat Loss" Click="OnHeatLoss"
                                        ToolTip="Each room's heat loss at the design conditions, as BS EN 12831-1 works it and MCS MIS 3005-D asks - through its walls, windows, doors, floor and roof, and with the air - what heats it, and the heat sources against the whole building's load"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Radiator}"
                                            Content="Size Radiators" Click="OnSizeRadiators"
                                            ToolTip="Size each room's radiators to its heat loss at its zone's temperatures: the shortest single or double panel radiator, as high as it is, that gives its share"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.EnergyRating}"
                                            Content="Energy Rating" Click="OnEnergyRating"
                                            ToolTip="The home's SAP 10.3 rating and its Future Homes Standard check - its emission, primary energy and fabric energy efficiency rates against the notional home's targets, the limiting U-values, its heating's fuel, its fans and lights, and requirement L3's solar output - and its overheating by Approved Document O's simplified method: its glazing, shading and openings. Worked from the model"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Daylight}"
                                            Content="Daylight" Click="OnDaylight"
                                            ToolTip="Each habitable room's daylight by BS EN 17037 - its daylight factors over the room worked out under the overcast sky through the model, against the standard's levels and, in England, the UK annex's 100, 150 and 200 lux - and the hours of sun its windows let in on 21 March; drawn over the plan as a map"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Builder's Work" Style="{StaticResource RibbonPanel}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.WallOpening}"
                                    Content="Cut Openings" Click="OnCutOpenings"
                                    ToolTip="Cut an opening wherever a pipe or duct passes through a wall or a floor with none: a wall opening or a shaft opening, the service's size and a gap all round it for its fire-stopping"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Electrical" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Electrical}"
                                        Content="Electrical" Click="OnElectrical"
                                        ToolTip="Each consumer unit's supply and maximum demand after diversity - in the US the dwelling's load by NEC Article 220 - its circuits' breakers and cables, what they carry, their voltage drop and earth loop as BS 7671 and the On-Site Guide check them, and each room's light against what it is lit to"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.SizeCircuits}"
                                            Content="Size Circuits" Click="OnSizeCircuits"
                                            ToolTip="Give the circuits selected, or every circuit, the breaker their use usually has and the smallest cable that carries it as installed, keeping the voltage drop and earth loop within the rules"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.LightData}"
                                            Content="Light Data" Click="OnPhotometricFile"
                                            ToolTip="Select a light, then load its maker's photometric file - IES LM-63 or EULUMDAT - into its type: its lumens and watts, and its light in each direction for the room's light point by point"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Systems" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MakeSystemButton" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.MakeSystem}"
                                        Content="Make System" Click="OnMakeSystem"
                                        ToolTip="Select fittings, then make a system of them: cold or hot water, a heating zone, foul water, gas, fire sprinklers, extract air, a circuit or the alarms' interlink. What feeds it - a boiler, cylinder, stop valve, gas meter, sprinkler valve set or consumer unit - is picked with them, or found if the model has only one"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.EditSystem}"
                                            Content="Edit System" Click="OnEditSystem"
                                            ToolTip="Click fittings on and off the system selected - or the one a fitting selected is on. Esc when done"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.EditSystem}"
                                            Content="Pick Source" Click="OnPickSource"
                                            ToolTip="Click the equipment that feeds the system selected: a boiler, a cylinder, the stop valve, the gas meter, a consumer unit"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.SystemBrowser}"
                                            Content="System Browser" Click="OnSystemBrowser"
                                            ToolTip="Every system by discipline, with its fittings and what feeds it; the fittings not connected yet; and what the rules ask that is wanting - Approved Documents G, H, L and B, BS 5839-6, the IRC"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Plans" Style="{StaticResource RibbonPanel}">
                            <StackPanel>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.ServicesPlan}"
                                        Content="Mechanical Plan" Click="OnServicesPlan" CommandParameter="Mechanical"
                                        ToolTip="This storey's mechanical plan: heating, gas and extract air over the building drawn faint, anything not connected in red"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.ServicesPlan}"
                                        Content="Electrical Plan" Click="OnServicesPlan" CommandParameter="Electrical"
                                        ToolTip="This storey's electrical plan: circuits and the alarms' interlink over the building drawn faint, anything not connected in red"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.ServicesPlan}"
                                        Content="Plumbing Plan" Click="OnServicesPlan" CommandParameter="Plumbing"
                                        ToolTip="This storey's plumbing plan: cold and hot water and foul water over the building drawn faint, anything not connected in red"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================== SITE ============================== -->
                <TabItem Header="Site" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Ground" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TerrainTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Terrain}"
                                             Content="Topo-&#10;surface" Checked="OnToolChanged"
                                             ToolTip="Toposurface: click where each spot level goes, at the elevation on the option bar - three make the ground, each after adds to it - or read in a points file (x, y, height). Contoured in plan, cut away under the floors of its storey; an outside stair stands on it, a railing follows it, and it is checked against the walls: 150 below the floor for the damp-proof course, and under the IRC falling 6 in in the first 10 ft"/>
                                <RadioButton x:Name="RegionTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Region}"
                                             Content="Region" Checked="OnToolChanged"
                                             ToolTip="Region of the ground: click its corners - a lawn, paving, gravel, planting - or, ticking Path, click along a path's middle. It lies on the ground, following it, in its own colour - raised as a planting bed, or sunk as a sunken patio, by Raised By in Properties; a path that is the approach to a door is checked for its gradient: 1:20 gently sloping, 1:15 and 1:12 ramps (Approved Document M), and a lawn steeper than 1 in 3 as too steep to mow"/>
                                <Button x:Name="AroundBuildingButton" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.AroundBuilding}"
                                        Content="Around&#10;Building" Click="OnGroundAroundBuilding"
                                        ToolTip="Put the ground round the whole building on this storey, 15 m out on every side, level at the Elevation on the Toposurface option bar - 150 below the floor to start with, under the damp-proof course. Then shape it with spot levels, pads and regions"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Grading" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="PadTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Pad}"
                                         Content="Pad" Checked="OnToolChanged"
                                         ToolTip="Pad: click its corners - a patio, a drive, a terrace, level ground for a shed. The ground is cut down or made up to its height on the option bar and battered back to the ground round it, so many along to one up - or held sheer by a wall; give it a fall in Properties. What is dug out and made up is counted in the ground's Cut and Fill, and it is checked against the house: 150 below the damp-proof course, falling away from the walls"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Plot" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PropertyLineTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.PropertyLine}"
                                             Content="Property&#10;Line" Checked="OnToolChanged"
                                             ToolTip="Property line: click the corners of the plot. Each side's length and bearing is written along it, its area and how much of it the building covers are in Properties, and with a setback the building is checked to be behind it"/>
                                <RadioButton x:Name="SpotElevationTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.SpotElevation}"
                                             Content="Spot&#10;Elevation" Checked="OnToolChanged"
                                             ToolTip="Spot elevation: click where to read a height - the floor, ramp, pad or ground there - written beside it: FFL +0.000, GL -0.450. It reads afresh when what is under it changes"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Massing" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="MassTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Mass}"
                                         Content="Mass" Checked="OnToolChanged"
                                         ToolTip="Draw a mass - the shape of the building before it is one: a box, a circle or an outline, so high, flat-topped, tapered, or with a gable, hip or shed top. Its mass floors give its gross floor area"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Model by Face" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="WallByFaceTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Wall}"
                                                 Content="Wall" Checked="OnToolChanged"
                                                 ToolTip="Wall by Face: click a mass's side, in plan or 3D - a wall of the wall type is made on it, its outside on the face, leaning or gabled as the face is"/>
                                    <RadioButton x:Name="CurtainByFaceTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.CurtainWall}"
                                                 Content="Curtain System" Checked="OnToolChanged"
                                                 ToolTip="Curtain System by Face: click a mass's upright side - a curtain wall is made on it"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="FloorByFaceTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Floor}"
                                                 Content="Floor" Checked="OnToolChanged"
                                                 ToolTip="Floor by Face: click a mass - a floor is made at each of its mass floors"/>
                                    <RadioButton x:Name="RoofByFaceTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Roof}"
                                                 Content="Roof" Checked="OnToolChanged"
                                                 ToolTip="Roof by Face: click a mass - its top is made a roof: flat, pitched as it slopes, or up from its foot to a point"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================ MODIFY ============================ -->
                <TabItem Header="Modify" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Select" Style="{StaticResource RibbonPanel}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Select}"
                                    Content="Modify" Click="OnSelectModify" ToolTip="Back to selecting (S)"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Clipboard" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Paste}"
                                        Content="Paste" Click="OnPaste" ToolTip="Paste onto the current level (Ctrl+V)"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Copy}"
                                            Content="Copy" Click="OnCopy" ToolTip="Copy the selection (Ctrl+C)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Paste}"
                                            Content="Paste in Place" Click="OnPasteInPlace" ToolTip="Paste where it came from (Ctrl+Shift+V)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Select}"
                                            Content="Select All" Click="OnSelectAll" ToolTip="Everything on this level (Ctrl+A)"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Small tools three high, as Revit lays these panels out, so the whole tab fits a 1366-wide screen. -->
                        <HeaderedContentControl Header="Geometry" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <RadioButton x:Name="WallJoinsTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.WallJoins}"
                                                 Content="Wall Joins" Checked="OnToolChanged"
                                                 ToolTip="Pick where walls meet, then make it a butt, mitre or square-off join, change which wall carries on, clean it up or not, or keep the walls from joining"/>
                                    <RadioButton x:Name="JoinGeometryTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.JoinGeometry}"
                                                 Content="Join Geometry" Checked="OnToolChanged"
                                                 ToolTip="Join two parallel walls up to 150 mm apart, so doors and windows in either cut through both"/>
                                    <RadioButton x:Name="JoinRoofTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Roof}"
                                                 Content="Join/Unjoin Roof" Checked="OnToolChanged"
                                                 ToolTip="Click the edge of a roof - a dormer's back edge - then the roof it should run into: it is carried back until it meets it and trimmed there, in valleys. Click a joined roof's edge to unjoin it"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="PaintTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Paint}"
                                                 Content="Paint" Checked="OnToolChanged"
                                                 ToolTip="Put a material on a wall's face without changing its type: click the face in plan, an elevation or the 3D view - the part split off there, or the whole face"/>
                                    <RadioButton x:Name="SplitFaceTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.SplitFace}"
                                                 Content="Split Face" Checked="OnToolChanged"
                                                 ToolTip="Split part of a wall's face off, to paint on its own - a tiled band, a feature panel: click two opposite corners on the face in an elevation or the 3D view"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Modify" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <RadioButton x:Name="SplitTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Split}"
                                                 Content="Split" Checked="OnToolChanged" ToolTip="Split a wall in two where you click (X)"/>
                                    <RadioButton x:Name="SplitGapTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.SplitGap}"
                                                 Content="Split with Gap" Checked="OnToolChanged"
                                                 ToolTip="Split a wall in two with a gap between them where you click - a movement joint. Set the Joint Gap on the options bar"/>
                                    <RadioButton x:Name="TrimTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Trim}"
                                                 Content="Trim / Extend" Checked="OnToolChanged" ToolTip="Click a wall, then the wall to trim or extend it to (T)"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="OffsetTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Offset}"
                                                 Content="Offset" Checked="OnToolChanged" ToolTip="Make a parallel copy of a wall a set distance away (O)"/>
                                    <RadioButton x:Name="MirrorTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Mirror}"
                                                 Content="Mirror" Checked="OnToolChanged" ToolTip="Reflect the selection about a line (I)"/>
                                    <RadioButton x:Name="ArrayTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Array}"
                                                 Content="Array" Checked="OnToolChanged" ToolTip="Repeat the selection at a regular spacing (Y)"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="RotateTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Rotate}"
                                                 Content="Rotate" Checked="OnToolChanged"
                                                 ToolTip="Turn the selection about its middle, or a centre you place: click where the angle starts and ends, or type the angle (Q)"/>
                                    <RadioButton x:Name="ScaleTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Scale}"
                                                 Content="Scale" Checked="OnToolChanged"
                                                 ToolTip="Make walls, floors and grids longer or shorter about a point you click; thicknesses and heights stay the same (K)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}"
                                            Content="Delete" Command="Delete" ToolTip="Delete the selection (Del)"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <RadioButton x:Name="AlignTool" Style="{StaticResource RibbonSmallTool}" Tag="{StaticResource Icon.Align}"
                                                 Content="Align" Checked="OnToolChanged"
                                                 ToolTip="Click a wall's face or centreline, or a gridline, then a wall, gridline, edge or column to bring onto it (L)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Pin}" Content="Pin" Click="OnPin"
                                            ToolTip="Pin the selection where it is: it cannot be moved, rotated, scaled or deleted until unpinned (P)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Unpin}" Content="Unpin" Click="OnUnpin"
                                            ToolTip="Let the selection be moved again (Shift+P)"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Group" Style="{StaticResource RibbonPanel}">
                            <StackPanel>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Group}" Content="Create Group" Click="OnCreateGroup"
                                        ToolTip="Make what is picked a group - a bathroom's fittings, a kitchen run, a typical flat - picked, moved and copied as one. A copy of it is another of the same group: edit one and every one changes"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Group}" Content="Edit Group" Click="OnEditGroup"
                                        ToolTip="Change what is in the group picked - its members picked one by one, what is drawn put in it - then Finish: every other of the same group is made over to match"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}" Content="Ungroup" Click="OnUngroup"
                                        ToolTip="Break up the group picked: what was in it stays, on its own"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Framing" Style="{StaticResource RibbonPanel}">
                            <StackPanel>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Framing}" Content="Frame Walls"
                                        Click="OnFrameWalls"
                                        ToolTip="Frame the selected walls with studs - timber, or steel for a metal stud wall - laid out with their openings: plates, studs at the spacing, kings, jacks, headers, sills, cripples, corner studs and noggings"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Schedule}" Content="Cut List" Click="OnCutList"
                                        ToolTip="List every member of the selected frames - or all of them - by section and length, with how many; export it as CSV"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}" Content="Remove Framing" Click="OnRemoveFraming"
                                        ToolTip="Take the frame out of the selected walls"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Parts" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Parts}" Content="Create Parts"
                                        Click="OnCreateParts"
                                        ToolTip="Make the selected walls into parts, one for each layer, to give their own materials, divide into panels and schedule"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.DivideParts}" Content="Divide Parts"
                                        Click="OnDivideParts"
                                        ToolTip="Divide the selected parts - or every part of the selected walls - into panels of a width and height, with joints between"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}" Content="Exclude" Click="OnExcludeParts"
                                            ToolTip="Leave the selected parts out: not built, shown or scheduled"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Parts}" Content="Restore" Click="OnRestoreParts"
                                            ToolTip="Put back the parts left out of the selected walls"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Wall}" Content="Remove Parts" Click="OnRemoveParts"
                                            ToolTip="Put the selected walls back together, as one wall again"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- =========================== ANNOTATE =========================== -->
                <TabItem Header="Annotate" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Dimension" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DimensionTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Dimension}"
                                             Content="Aligned" Checked="OnToolChanged" ToolTip="Measure between two points or elements (M) - or, with String ticked on the options bar, through many in a row"/>
                                <StackPanel>
                                    <RadioButton x:Name="AngularDimensionTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.AngularDimension}"
                                                 Content="Angular" Checked="OnToolChanged" ToolTip="The angle between two walls or gridlines"/>
                                    <RadioButton x:Name="RadialDimensionTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.RadialDimension}"
                                                 Content="Radial" Checked="OnToolChanged" ToolTip="A curved wall's radius"/>
                                    <RadioButton x:Name="DiameterDimensionTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.RadialDimension}"
                                                 Content="Diameter" Checked="OnToolChanged" ToolTip="A curved wall's diameter"/>
                                </StackPanel>
                                <StackPanel>
                                    <RadioButton x:Name="ArcLengthDimensionTool" Style="{StaticResource RibbonSmallRadio}" Tag="{StaticResource Icon.AngularDimension}"
                                                 Content="Arc Length" Checked="OnToolChanged" ToolTip="A curved wall's length along it"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Tag" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="TagTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Tag}"
                                         Content="Tag" Checked="OnToolChanged" ToolTip="Label an element with one of its parameters (A)"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Text" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="TextTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Text}"
                                         Content="Text" Checked="OnToolChanged" ToolTip="Write a note on the drawing (E)"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Keynote" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="KeynoteTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Keynote}"
                                             Content="Keynote" Checked="OnToolChanged"
                                             ToolTip="A keynote with a leader: an element's type's, the material where it points, or a key of its own - picked on the options bar"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Keynote}" Content="Keynotes" Click="OnShowKeynotes"
                                            ToolTip="The keynote table: load an office's file, or edit the keys; and each material's keynote"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Revisions" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RevisionCloudTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.RevisionCloud}"
                                             Content="Cloud" Checked="OnToolChanged"
                                             ToolTip="Cloud what a revision changed: click round it, double-click the last corner. Two corners make a rectangle"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Revisions}" Content="Revisions" Click="OnShowRevisions"
                                            ToolTip="The project's revisions: their numbers, dates, descriptions, who they went to, and whether issued"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Revisions}" Content="On Sheet" Click="OnRevisionsOnSheet"
                                            ToolTip="Revisions on Sheet: put revisions on the open sheet by hand - those clouded in its views are on it already"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================= VIEW ============================= -->
                <TabItem Header="View" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Graphics" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <RadioButton x:Name="DetailCoarse" GroupName="Detail" Style="{StaticResource RibbonSmallRadio}"
                                                 Tag="{StaticResource Icon.Detail}" Content="Coarse" Click="OnDetailLevelChanged"/>
                                    <RadioButton x:Name="DetailMedium" GroupName="Detail" Style="{StaticResource RibbonSmallRadio}"
                                                 Tag="{StaticResource Icon.Detail}" Content="Medium" Click="OnDetailLevelChanged"/>
                                    <RadioButton x:Name="DetailFine" GroupName="Detail" Style="{StaticResource RibbonSmallRadio}"
                                                 Tag="{StaticResource Icon.Detail}" Content="Fine" IsChecked="True" Click="OnDetailLevelChanged"/>
                                </StackPanel>
                                <ToggleButton x:Name="UnderlayMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Underlay}"
                                              Content="Storey Below" IsChecked="True" Click="OnToggleUnderlay"
                                              ToolTip="Show the storey below faintly under the plan"/>
                                <ToggleButton x:Name="ClearancesMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Room}"
                                              Content="Clearances" Click="OnToggleClearances"
                                              ToolTip="Show the clear space a WC, basin, bath, shower, bed or kitchen needs, as Approved Document M or the ADA asks - red where something is in it. Pick the standard in the plan's Properties"/>
                                <Button x:Name="WallFunctionsButton" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Filter}"
                                        Content="Wall Functions" Click="OnWallFunctionsButton"
                                        ToolTip="Show or hide walls by function, separately in each view">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="WallFunctionsMenu" Opened="OnWallFunctionsMenuOpened">
                                            <MenuItem Header="(views)"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Templates" Style="{StaticResource RibbonPanel}">
                            <StackPanel>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Filter}"
                                        Content="Create from View" Click="OnCreateViewTemplate"
                                        ToolTip="A view template of the view shown, as it is set now: its scale, detail level, walls shown, joins, style"/>
                                <Button x:Name="ApplyTemplateButton" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Filter}"
                                        Content="Apply to View" Click="OnApplyViewTemplate"
                                        ToolTip="Set the view shown from a template, once; to have a template govern it, pick it in the view's Properties">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ApplyTemplateMenu"/>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Filter}"
                                        Content="Manage" Click="OnManageViewTemplates"
                                        ToolTip="The project's view templates: what each sets, and the views each governs"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Create" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ModelMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.View3D}"
                                              Content="3D View" Click="OnToggle3D" ToolTip="Ctrl+3"/>
                                <RadioButton x:Name="CameraTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Camera}"
                                             Content="Camera" Checked="OnToolChanged"
                                             ToolTip="Click where the eye stands, then where it looks: a 3D view in perspective, from eye height above the floor"/>
                                <RadioButton x:Name="CalloutTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Callout}"
                                             Content="Callout" Checked="OnToolChanged"
                                             ToolTip="Click two corners of part of the plan: a view of its own, cropped to the box, at 1:50 and fine detail. On a section, use Callout on the section bar"/>
                                <RadioButton x:Name="InteriorElevationTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.InteriorElevation}"
                                             Content="Elevation" Checked="OnToolChanged"
                                             ToolTip="Interior elevation: click in a room for a marker looking at each of its walls, each view cropped to the room, its floor and ceiling"/>
                                <RadioButton x:Name="WalkthroughTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Walkthrough}"
                                             Content="Walkthrough" Checked="OnToolChanged"
                                             ToolTip="Click along a path and double-click where it ends: a camera follows it at eye height, played in the 3D view"/>
                                <RadioButton x:Name="SectionTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Section}"
                                             Content="Section" Checked="OnToolChanged" ToolTip="Cut a section through the building (C)"/>
                                <StackPanel>
                                    <ToggleButton x:Name="SectionMenuItem" Style="{StaticResource RibbonSmallToggle}" Tag="{StaticResource Icon.Plan}"
                                                  Content="Section View" Click="OnToggleSection" ToolTip="Show or hide the section under the plan"/>
                                    <ToggleButton x:Name="ScheduleMenuItem" Style="{StaticResource RibbonSmallToggle}" Tag="{StaticResource Icon.Schedule}"
                                                  Content="Schedules" Click="OnToggleSchedules" ToolTip="Ctrl+T"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Takeoff}"
                                            Content="Material Takeoff" Click="OnShowTakeoff"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Presentation" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Render}"
                                        Content="Render" Click="OnRender"
                                        ToolTip="A rendering of the 3D view as it looks: the sun where it is at the site on the date and time set, its shadows, the sky's light, glass and reflections, each face in its material's pattern - saved as PNG"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Sheet Composition" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="SheetMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Sheet}"
                                              Content="Sheet" Click="OnToggleSheet" ToolTip="Ctrl+H"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Sheet}"
                                            Content="New Sheet" Click="OnNewSheet"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.PlaceView}"
                                            Content="Place View" Click="OnPlaceViewOnSheet"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}"
                                            Content="Delete Sheet" Click="OnDeleteSheet"/>
                                </StackPanel>

                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Windows" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="TileToggle" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Tile}"
                                              Content="Tile Views" Click="OnToggleTile"
                                              ToolTip="The plan and the 3D view side by side, the section under the plan"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Plan}"
                                        Content="Zoom to Fit" Click="OnZoomToFit" ToolTip="F"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================ MANAGE ============================ -->
                <TabItem Header="Manage" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Settings" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.WallTypes}"
                                        Content="Wall Types" Click="OnManageWallTypes"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Level}"
                                        Content="Levels" Click="OnManageLevels"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Materials}"
                                        Content="Materials" Click="OnMaterials"
                                        ToolTip="The project's materials: their colours, and the pattern each face is laid in - brick, block, stone, boards, tiles, slates, standing seams - at its true size, for the Realistic style and renderings"/>
                                <ToggleButton x:Name="DarkThemeToggle" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Theme}"
                                              Content="Dark Theme" Click="OnToggleDarkTheme"
                                              ToolTip="Light or dark. Takes effect the next time BIMDesigner starts."/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Families" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.AddShapes}"
                                        Content="New Family" Click="OnNewFamily"
                                        ToolTip="Draw a component of your own from simple solids - boxes, cylinders, discs, spheres, cones, wedges - in the family editor"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Open}"
                                        Content="Load 3D Model" Click="OnLoadFamilyModel"
                                        ToolTip="Make a component from a 3D model: an OBJ or STL file"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Project Data" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Schedule}" Content="Project Parameters" Click="OnShowProjectParameters"
                                            ToolTip="Parameters of the project's own on the categories you choose - or shared ones, from a shared parameter file"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Keynote}" Content="Classification" Click="OnShowClassification"
                                            ToolTip="The codes types and rooms are classified by - Uniclass 2015 to start with, or a table loaded from a file"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Tile}" Content="Design Options" Click="OnShowDesignOptions"
                                            ToolTip="Alternatives for part of the building, side by side: which each view shows, and which new work goes into"/>
                                </StackPanel>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Plan}" Content="View Filters" Click="OnShowViewFilters"
                                            ToolTip="Pick things out by their parameters, and hide, colour or fade them in the view shown"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Import &amp; Link" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.ImportCad}"
                                    Content="Import CAD" Click="OnImportCad"
                                    ToolTip="A DWG or DXF drawing - a survey, a consultant's layout, an existing building's plans - brought onto the storey shown to work over, faded under the model. The drawing tools snap to its ends and along its lines; double-click it for its layers"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Link}" Content="Link Model" Click="OnLinkModel"
                                            ToolTip="Link a BIMDesigner project or an IFC file - the structure's, the services', the building next door: drawn with this one in 3D and cut on its plans, clash tested against it, read from its own file and reloaded as it changes"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.ImportCad}" Content="Link DWG" Click="OnLinkCad"
                                            ToolTip="A DWG or DXF drawing linked onto the storey shown: drawn as an imported one is, but read again from its file as the project opens and when it is reloaded"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Link}" Content="Manage Links" Click="OnManageLinks"
                                            ToolTip="The models and drawings linked in: how each stands, to reload from its file or another, unload, or take out"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Export" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Export}"
                                        Content="IFC" Click="OnExportIfc" ToolTip="Export the model as IFC4"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Export}" Content="IFC 2x3" Click="OnExportIfc2x3"
                                            ToolTip="The model as IFC2x3 Coordination View 2.0, for software that does not yet read IFC4"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Schedule}" Content="COBie" Click="OnExportCobie"
                                            ToolTip="The building handed over as a COBie spreadsheet: floors, spaces, and what is kept up in them"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Plan}" Content="Plan DWG" Click="OnExportPlanCad"
                                            ToolTip="The plan shown as a DWG or DXF drawing, full size in millimetres, each kind of element on its own layer"/>
                                </StackPanel>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Pdf}"
                                        Content="PDF Set" Click="OnExportDrawingSetPdf" ToolTip="Every sheet to one PDF"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Print}"
                                        Content="Print" Click="OnPrintSheets" ToolTip="Ctrl+P"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ====================== MODIFY | CATEGORY ====================== -->
                <!-- Shown only while something is selected, holding what can be done to it. -->
                <TabItem Header="Coordinate" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Clashes" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Clash}"
                                        Content="Clash Detective" Click="OnClashDetective"
                                        ToolTip="Clash tests between categories - hard, clearance, duplicates and the programme's sequence - each clash kept as an issue with its status, who has it and when it is due; reported as BCF, a web page or a spreadsheet"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Clash}"
                                            Content="Run All Tests" Click="OnRunClashTests"
                                            ToolTip="Run every clash test now: what is found again keeps its status, what is gone is resolved"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Issues" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Issues}"
                                        Content="Issues" Click="OnIssues"
                                        ToolTip="Issues raised about the model - from the 3D view as it is, from clashes, or brought in from other programs as BCF 2.0, 2.1 or 3.0 - each with its views, the elements it is about, its status, who has it, by when and what has been said; sent back out as BCF"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Versions" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Compare}"
                                        Content="Compare" Click="OnCompare"
                                        ToolTip="Two issues of a model side by side: this project against its last save or another saved project or IFC file, or a linked model against the issue it replaced - what was added, removed, moved or changed, setting by setting, coloured in the plan and 3D, listed and reported as a PDF"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Time (4D)" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Programme}"
                                        Content="Programme" Click="OnConstructionProgramme"
                                        ToolTip="The construction programme: tasks made from the model or read from Microsoft Project, Primavera P6 or Asta, the critical path, a bar chart, earned value against a baseline - and the building played through day by day in the 3D view"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Cost (5D)" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.CostPlan}"
                                        Content="Cost Plan" Click="OnCostPlan"
                                        ToolTip="The model measured and costed at its types' rates, set out by NRM1 in England or UniFormat II in the US, with preliminaries, overheads and profit, fees, risk and inflation - and its spend over the programme"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="ContextTab" Header="Modify" Style="{StaticResource ContextRibbonTab}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Select" Style="{StaticResource ContextRibbonPanel}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Select}"
                                    Content="Modify" Click="OnSelectModify"
                                    ToolTip="Leave the tool you are in and go back to selecting, keeping the selection (S or Esc)"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextPropertiesPanel" Header="Properties" Style="{StaticResource ContextRibbonPanel}">
                            <Button x:Name="ContextEditType" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.EditType}"
                                    Content="Edit Type" Click="OnEditSelectedType"
                                    ToolTip="Change the type the selection is built from, or duplicate it"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Clipboard" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Margin="2,0,0,0">
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Copy}"
                                        Content="Copy" Click="OnCopy" ToolTip="Copy the selection (Ctrl+C)"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Paste}"
                                        Content="Paste" Click="OnPaste" ToolTip="Paste onto the current level (Ctrl+V)"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Paste}"
                                        Content="Paste in Place" Click="OnPasteInPlace" ToolTip="Paste where it came from (Ctrl+Shift+V)"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Modify" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Small buttons three high, as Revit lays its Modify panel out, so the panels after it fit a small screen. -->
                                <StackPanel>
                                    <Button x:Name="ContextSplit" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Split}"
                                            Content="Split" Click="OnContextTool" CommandParameter="Split" ToolTip="Split a wall in two where you click (X)"/>
                                    <Button x:Name="ContextSplitGap" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.SplitGap}"
                                            Content="Split with Gap" Click="OnContextTool" CommandParameter="SplitGap"
                                            ToolTip="Split a wall in two with a gap between them where you click - a movement joint. Set the Joint Gap on the options bar"/>
                                    <Button x:Name="ContextTrim" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Trim}"
                                            Content="Trim / Extend" Click="OnContextTool" CommandParameter="Trim" ToolTip="Click a wall, then the wall to trim or extend it to (T)"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <Button x:Name="ContextOffset" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Offset}"
                                            Content="Offset" Click="OnContextTool" CommandParameter="Offset" ToolTip="Make a parallel copy of a wall a set distance away (O)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Mirror}"
                                            Content="Mirror" Click="OnContextTool" CommandParameter="Mirror" ToolTip="Reflect the selection about a line (I)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Array}"
                                            Content="Array" Click="OnContextTool" CommandParameter="Array" ToolTip="Repeat the selection at a regular spacing (Y)"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Rotate}"
                                            Content="Rotate" Click="OnContextTool" CommandParameter="Rotate"
                                            ToolTip="Turn the selection about its middle, or a centre you place: click where the angle starts and where it ends, or type the angle (Q)"/>
                                    <Button x:Name="ContextScale" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Scale}"
                                            Content="Scale" Click="OnContextTool" CommandParameter="Scale"
                                            ToolTip="Make walls, floors and grids longer or shorter about a point you click; thicknesses and heights stay the same (K)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}"
                                            Content="Delete" Command="Delete" ToolTip="Delete the selection (Del)"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <Button x:Name="ContextPin" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Pin}" Content="Pin" Click="OnPin"
                                            ToolTip="Pin the selection where it is: it cannot be moved, rotated, scaled or deleted until unpinned (P)"/>
                                    <Button x:Name="ContextUnpin" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Unpin}" Content="Unpin" Click="OnUnpin"
                                            ToolTip="Let the selection be moved again (Shift+P)"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextWallPanel" Header="Modify Wall" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,2,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Paint}"
                                            Content="Paint" Click="OnContextTool" CommandParameter="Paint"
                                            ToolTip="Put a material on a wall's face without changing its type: pick it on the options bar, then click the face - in plan, an elevation or the 3D view"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.SplitFace}"
                                            Content="Split Face" Click="OnContextTool" CommandParameter="SplitFace"
                                            ToolTip="Split part of a wall's face off to paint on its own: open an elevation or the 3D view and click two opposite corners on the face"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.EditType}"
                                            Content="Bands" Click="OnWallBands"
                                            ToolTip="Bands of another material up a layer of the wall's type - a tiled band at the foot of the plaster, brick under render: opens Edit Type at its bands"/>
                                </StackPanel>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Lock}"
                                        Content="Lock Ends" Click="OnLockCorners"
                                        ToolTip="Lock the corners where the selected walls meet others, so they stay joined when any of them moves. Click again to unlock"/>
                                <Button x:Name="ContextCurtainGrid" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.CurtainGrid}"
                                        Content="Curtain Grid" Click="OnEditCurtainGrid"
                                        ToolTip="Add, move or delete the grid lines of the selected curtain wall"/>
                                <Button x:Name="ContextSpandrels" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Spandrel}"
                                        Content="Spandrels at Floors" Click="OnSpandrelsAtFloors"
                                        ToolTip="Where a floor runs behind the selected curtain walls: a transom at the floor's top and another at its underside - or the ceiling's - with opaque spandrel panels between, hiding the slab edge, the fire-stopped gap and the ceiling void. Clear glass is left from floor to ceiling"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachTop}"
                                            Content="Attach Top" Click="OnAttachTops"
                                            ToolTip="Take the selected walls up to the floor, ceiling or roof over each - a gable end up to the ridge, glass and all"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachBase}"
                                            Content="Attach Base" Click="OnAttachBases"
                                            ToolTip="Stand the selected walls on the floor under each"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Detach}"
                                            Content="Detach Top/Base" Click="OnDetachWalls"
                                            ToolTip="Detach the tops and bases of the selected walls"/>
                                    <Button x:Name="ContextAlignFaces" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Wall}"
                                            Content="Align Faces" Click="OnAlignWallFaces"
                                            ToolTip="Run the selected wall flush with the face of the wall it meets end to end, instead of standing in the middle of a thicker one. Click again for the other face"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextFramingPanel" Header="Framing" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ContextFrameWalls" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Framing}" Content="Frame Walls"
                                        Click="OnFrameWalls"
                                        ToolTip="Frame the selected walls with studs - timber, or steel for a metal stud wall - laid out with their openings. The frames are selected after, so their Spacing, Section and plates are in Properties"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Schedule}" Content="Cut List" Click="OnCutList"
                                            ToolTip="List every member of the selected frames by section and length, with how many; export it as CSV"/>
                                    <Button x:Name="ContextRemoveFraming" Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}" Content="Remove Framing" Click="OnRemoveFraming"
                                            ToolTip="Take the frame out of the selected walls"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextPartsPanel" Header="Parts" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ContextCreateParts" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Parts}" Content="Create Parts"
                                        Click="OnCreateParts"
                                        ToolTip="Make the selected walls into parts, one for each layer, to give their own materials, divide into panels and schedule"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.DivideParts}" Content="Divide Parts"
                                        Click="OnDivideParts"
                                        ToolTip="Divide the selected parts - or every part of the selected walls - into panels of a width and height, with joints between"/>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}" Content="Exclude" Click="OnExcludeParts"
                                            ToolTip="Leave the selected parts out: not built, shown or scheduled"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Parts}" Content="Restore" Click="OnRestoreParts"
                                            ToolTip="Put back the parts left out of the selected walls"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Wall}" Content="Remove Parts" Click="OnRemoveParts"
                                            ToolTip="Put the selected walls back together, as one wall again"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextShapePanel" Header="Shape" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ContextAddPoint" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.AddPoint}"
                                              Content="Add Point" Click="OnAddWallPoint"
                                              ToolTip="Click on a wall to add a corner point, then drag the round grip to pull the wall straight to wherever you put it. Double-clicking the wall does the same; double-click a point to take it out"/>
                                <Button x:Name="ContextStraighten" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Straighten}"
                                        Content="Straighten" Click="OnStraightenWalls"
                                        ToolTip="Take every point and bend off the selected walls, back to a straight line between their ends"/>
                                <Button x:Name="ContextMergeWalls" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Wall}"
                                        Content="Merge Walls" Click="OnMergeWalls"
                                        ToolTip="Make one wall of walls of the same type that run on from each other in a straight line - the joint between them goes. With one wall selected, the walls running on from its ends join it"/>
                                <Button x:Name="ContextAddShapes" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.AddShapes}"
                                        Content="Add Shapes" Click="OnAddShapesButton"
                                        ToolTip="Put the selected walls of a room into an exact shape - a rectangle, a square or a regular polygon - of the size you type">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ShapesMenu" Opened="OnShapesMenuOpened">
                                            <MenuItem x:Name="ShapeRectangleItem" Header="_Rectangle" Click="OnShapeRectangle"
                                                      ToolTip="Four walls: square the corners, to a width and a depth">
                                                <MenuItem.Icon><Image Source="{StaticResource Icon.ShapeRectangle}" Width="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="ShapeSquareItem" Header="_Square" Click="OnShapeSquare"
                                                      ToolTip="Four walls: square the corners, all four sides the same length">
                                                <MenuItem.Icon><Image Source="{StaticResource Icon.ShapeSquare}" Width="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="ShapePolygonItem" Header="Regular _Polygon" Click="OnShapePolygon"
                                                      ToolTip="Three or more walls round a room: every side the same length and every corner the same angle - a triangle, pentagon, hexagon, octagon">
                                                <MenuItem.Icon><Image Source="{StaticResource Icon.ShapePolygon}" Width="16"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextModePanel" Header="Mode" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Profile}"
                                        Content="Edit Profile" Click="OnEditProfile"
                                        ToolTip="Change the outline of the selected straight wall seen square-on"/>
                                <Button x:Name="ContextResetProfile" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.ResetProfile}"
                                        Content="Reset Profile" Click="OnResetProfile"
                                        ToolTip="Take the edited outline off the selected walls, back to the plain rectangle"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextMassPanel" Header="Mass" Style="{StaticResource ContextRibbonPanel}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Level}"
                                        Content="Mass Floors" Click="OnMassFloors"
                                        ToolTip="Cut the mass by a mass floor at every level it rises through - or take them off: its gross floor area is theirs, and Floor by Face makes floors of them"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Mass}"
                                        Content="Update to Face" Click="OnUpdateMassToFace"
                                        ToolTip="Bring the walls, curtain walls, floors and roof made from this mass's faces back to them, after the mass has changed - one step to undo"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextSlabPanel" Header="Mode" Style="{StaticResource ContextRibbonPanel}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.EditFootprint}"
                                        Content="Edit Boundary" Click="OnEditRoofFootprint"
                                        ToolTip="Open the floor's or ceiling's sketch again: pick more walls, move or delete lines, draw holes inside it, set a floor's span. Double-clicking it does the same"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextRoofPanel" Header="Mode" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ContextEditFootprint" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.EditFootprint}"
                                        Content="Edit Footprint" Click="OnEditRoofFootprint"
                                        ToolTip="Open the roof's sketch again: pick more walls, move or delete lines, change which ones slope. Double-clicking the roof does the same"/>
                                <Button x:Name="ContextEditProfile" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Profile}"
                                        Content="Edit Profile" Click="OnEditRoofProfile"
                                        ToolTip="Open the extruded roof's section again: move its points, start again from a gambrel or a vault, raise or lower its base. Double-clicking the roof does the same"/>
                                <Button x:Name="ContextAddDormer" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Roof}"
                                        Content="Add Dormer" Click="OnAddDormer"
                                        ToolTip="Then click on this roof's slope: walls, a dormer roof joined into this one, and the opening under it, all in one go"/>
                                <Button x:Name="ContextAddFascia" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Fascia}"
                                        Content="Fascia" Click="OnAddFasciaAllRound"
                                        ToolTip="A fascia all round the selected roof, covering the ends of its build-up: along the eaves and up the verges, mitred at the corners"/>
                                <Button x:Name="ContextAddGutters" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Gutter}"
                                        Content="Gutters" Click="OnAddGuttersAllRound"
                                        ToolTip="Gutters along every eave of the selected roof, hung off its fascia"/>
                                <Button x:Name="ContextAddSoffits" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Soffit}"
                                        Content="Soffits" Click="OnAddSoffitsAllRound"
                                        ToolTip="Soffits under every eave of the selected roof that overhangs its wall, closing the overhang back to the wall"/>
                                <Button x:Name="ContextAddEaves" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Eave}"
                                        Content="Eaves" Click="OnAddEavesAllRound"
                                        ToolTip="An eave under every eave of the selected roof, of the eave type picked for the Eave tool: its rafters, and the soffit, frieze, moulding and brackets its kind has"/>
                                <Button x:Name="ContextAddRoofDrain" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.RoofDrain}"
                                        Content="Roof Drain" Click="OnAddRoofDrain"
                                        ToolTip="Then click on the roof where a drain goes: the flat roof falls to its drains"/>
                                <Button x:Name="ContextAddDownpipes" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Downpipe}"
                                        Content="Downpipes" Click="OnAddDownpipes"
                                        ToolTip="A downpipe at each end of each gutter on the selected roof - or of the selected gutter - and at the corners of one that goes all round, where there is not one already"/>
                                <Button x:Name="ContextAddRoofWindow" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.RoofWindow}"
                                        Content="Roof Window" Click="OnAddRoofWindow"
                                        ToolTip="Then click on the roof's slope: a roof window goes in it there, lined up with the slope, the roof cut away under it"/>
                                <Button x:Name="ContextAddShaft" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Shaft}"
                                        Content="Shaft" Click="OnAddShaft"
                                        ToolTip="Then click on the roof: a chimney or flue opening is cut straight down through it there"/>
                                <Button x:Name="ContextDormerOpening" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.WallOpening}"
                                        Content="Dormer Opening" Click="OnDormerOpening"
                                        ToolTip="Then click a dormer's roof - joined to this one, on walls attached to it: this roof is cut away under the dormer, between its walls. Click the same dormer again to close the opening"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextFoundationPanel" Header="Foundation" Style="{StaticResource ContextRibbonPanel}">
                            <Button x:Name="ContextAddFootings" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.WallFooting}"
                                    Content="Footings" Click="OnAddFootings"
                                    ToolTip="A strip footing under each selected wall and a pad under each selected structural column that has none - each as wide and deep as the rules ask for its load and the ground"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextColumnPanel" Header="Column" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Wall}"
                                        Content="Align Faces" Click="OnAlignWallFaces"
                                        ToolTip="Set the selected column flush with the face of the wall it stands in, instead of straddling the wall's line. Click again for the other face"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Profile}"
                                        Content="Edit Section" Click="OnEditColumnProfile"
                                        ToolTip="Draw the column's cross-section: cut shapes out of it, add shapes to it, and watch it in 3D as you go"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextPersonPanel" Header="Person" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Walkthrough}"
                                        Content="Walk As Them" Click="OnWalkAsThem"
                                        ToolTip="See through their eyes in 3D and walk where they can - a wheelchair user stopped by steps, steep slopes and narrow doorways. They go where you go: when you stop, they are left standing there"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextGroundPanel" Header="Grading" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ContextRecordGround" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Terrain}"
                                        Content="Record Existing" Click="OnRecordExistingGround"
                                        ToolTip="Record the ground as it is now as the existing ground: grade it after - drag its points in plan, raise them in 3D - and its Cut and Fill are measured from this, its old contours shown dashed"/>
                                <Button x:Name="ContextForgetGround" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Terrain}"
                                        Content="Let Go" Click="OnForgetExistingGround"
                                        ToolTip="Let go of the recorded existing ground: Cut and Fill are measured from the ground as it is, the building's dig only"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextGuardPanel" Header="Guarding" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Railing}"
                                        Content="Guard Edges" Click="OnGuardEdges"
                                        ToolTip="A railing along every edge of the selected floor, balcony or roof terrace that drops too far with nothing there - more than 600 in a home - as high as its rules ask: 1100 round a balcony or a roof, 900 at a floor's edge inside. The edges against walls, those a floor carries on from, and where a stair comes up are left open"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Railing}"
                                        Content="All Round" Click="OnGuardAllRound"
                                        ToolTip="One railing all the way round the selected floor, balcony or terrace - every side, the side against the house too - open only where a stair comes up through it"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextStoreyPanel" Header="Storey" Style="{StaticResource ContextRibbonPanel}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Level}"
                                    Content="Make Storey" Click="OnMakeStorey"
                                    ToolTip="The walls running up through the selected floor or flat roof split at it - the part under it stopping at its underside, the part over it standing on its top, its edge showing between - and, where it has a room over it at a height no level is at, a level made on its top that moves with it. Done by itself when a floor is put in across walls, a wall is put up through a floor, or either is moved through the other"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextJulietPanel" Header="Guarding" Style="{StaticResource ContextRibbonPanel}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Railing}"
                                    Content="Juliet Balcony" Click="OnJulietBalcony"
                                    ToolTip="A railing across the selected doors and windows, in front of the wall, from the sill: guarding where a door or a low window on an upper floor opens onto a drop - 1100 high from the floor across a door, 800 across a window (Approved Document K). Their Guarding in Properties says which want one"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextHostPanel" Header="Work Plane" Style="{StaticResource ContextRibbonPanel}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Door}"
                                    Content="Pick New" Click="OnPickNewHost"
                                    ToolTip="Move the selection onto another host: a door or window into another wall, or a component onto another face or onto the level. Placement above says what will be taken"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextCurtainPanel" Header="Curtain Wall" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.CurtainWall}"
                                        Content="Select Wall" Click="OnSelectCurtainHost"
                                        ToolTip="Select the curtain wall this panel is part of: its type, its height, and everything that edits a wall"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.CurtainGrid}"
                                        Content="Curtain Grid" Click="OnEditCurtainGrid"
                                        ToolTip="Add, move or delete the grid lines of the curtain wall this panel is part of, and make panels solid, empty or doors"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Wall}"
                                        Content="Merge Walls" Click="OnMergeWalls"
                                        ToolTip="Make one wall of this curtain wall and any of the same type running on from its ends in a straight line: the joint line between them goes"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachTop}"
                                            Content="Attach Top" Click="OnAttachTops"
                                            ToolTip="Take the curtain wall up to the roof or floor over it. Under a pitched roof its glass follows the slope, up to the ridge of a gable"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Detach}"
                                            Content="Detach Top/Base" Click="OnDetachWalls"
                                            ToolTip="Detach the curtain wall's top and base, back to its own height"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextSweepPanel" Header="Profile" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ContextAddRemoveWalls" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.AddRemoveWalls}"
                                              Content="Add/Remove Walls" Click="OnAddRemoveSweepWalls"
                                              ToolTip="Click walls to carry the sweep on to them, or take it off them"/>
                                <ToggleButton x:Name="ContextModifyReturns" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Returns}"
                                              Content="Modify Returns" Click="OnModifySweepReturns"
                                              ToolTip="Click an end of the sweep to cut it straight or return it round the wall end"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ==================== MODIFY | PLACE WALL ==================== -->
                <!-- Shown while the Wall tool is on: how the walls are drawn, as Revit's contextual tab. -->
                <TabItem x:Name="PlaceWallTab" Header="Modify | Place Wall" Style="{StaticResource ContextRibbonTab}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Draw" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeLine" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawLine}"
                                                 Content="Line" CommandParameter="Line" ToolTip="One straight wall at a time, chained click to click"/>
                                    <RadioButton x:Name="ShapeArc" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawArc}"
                                                 Content="Arc" CommandParameter="Arc" ToolTip="Start, end, then a point the arc passes through"/>
                                    <RadioButton x:Name="ShapeTangentArc" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawTangentArc}"
                                                 Content="Tangent Arc" CommandParameter="TangentArc" ToolTip="Carries on smoothly from the end of a wall: click the end, then where the arc ends"/>
                                    <RadioButton x:Name="ShapeCentreEndsArc" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawCentreArc}"
                                                 Content="Centre-Ends Arc" CommandParameter="CentreEndsArc" ToolTip="The centre, the start (which sets the radius), then where it ends"/>
                                    <RadioButton x:Name="ShapeFilletArc" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawFilletArc}"
                                                 Content="Fillet Arc" CommandParameter="FilletArc" ToolTip="Click two walls: their corner is rounded off at the radius on the options bar"/>
                                    <RadioButton x:Name="ShapeTrapezoid" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawTrapezoid}"
                                                 Content="Trapezoid Wall" CommandParameter="Trapezoid" ToolTip="A wall thicker at one end than the other: click its start and end; the thicknesses are on the options bar"/>
                                    <RadioButton x:Name="ShapePolygonOutline" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawPolygonWall}"
                                                 Content="Polygon Wall" CommandParameter="PolygonOutline" ToolTip="A wall of any shape in plan: click its corners, then the first, a double click or Enter"/>
                                    <RadioButton x:Name="ShapePick" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawPick}"
                                                 Content="Pick Lines" CommandParameter="Pick" ToolTip="Click a gridline to put a wall along it"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeRectangle" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawRectangle}"
                                                 Content="Rectangle" CommandParameter="Rectangle" ToolTip="Two opposite corners; Shift for a square"/>
                                    <RadioButton x:Name="ShapePolygon" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawPolygon}"
                                                 Content="Polygon" CommandParameter="Polygon" ToolTip="The centre, then a corner; sides on the option bar"/>
                                    <RadioButton x:Name="ShapeCircle" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawCircle}"
                                                 Content="Circle" CommandParameter="Circle" ToolTip="The centre, then a point on the circle"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeOval" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawOval}"
                                                 Content="Oval" CommandParameter="Oval" ToolTip="Two opposite corners of its box"/>
                                    <RadioButton x:Name="ShapeEllipse" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawEllipse}"
                                                 Content="Ellipse" CommandParameter="Ellipse" ToolTip="Two opposite corners of its box"/>
                                    <RadioButton x:Name="ShapePartialEllipse" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawHalfEllipse}"
                                                 Content="Partial Ellipse" CommandParameter="PartialEllipse" ToolTip="Both ends of an axis, then a point it passes through"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeSpline" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawSpline}"
                                                 Content="Spline" CommandParameter="Spline" ToolTip="Click points the wall curves through; Enter or a double click finishes"/>
                                    <RadioButton x:Name="ShapeFreehand" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawFreehand}"
                                                 Content="Freehand" CommandParameter="Freehand" ToolTip="Hold the mouse button and draw the wall"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Placement" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ShapeBySegment" Style="{StaticResource WallShapeLargeRadio}" Tag="{StaticResource Icon.PlaceBySegment}"
                                             Content="Place by Segment" CommandParameter="BySegment"
                                             ToolTip="Click beside a wall: a new wall runs along that face, on the side clicked"/>
                                <RadioButton x:Name="ShapeByRoom" Style="{StaticResource WallShapeLargeRadio}" Tag="{StaticResource Icon.PlaceByRoom}"
                                             Content="Place by Room" CommandParameter="ByRoom"
                                             ToolTip="Click inside a room: a new wall goes along every face round it"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Join" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="PlaceAutoJoin" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.AutoJoin}"
                                              Content="Auto Join" Click="OnPlaceWallJoinChanged"
                                              ToolTip="Join a new wall to the walls its faces lie against: their doors and windows cut through both"/>
                                <ToggleButton x:Name="PlaceLock" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Lock}"
                                              Content="Lock" Click="OnPlaceWallJoinChanged"
                                              ToolTip="Auto Join and Lock: the joined walls also move together"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- Roof sketch mode: Revit's Modify | Create Roof Footprint. Only the sketch's own
                     tools work while it is open; Finish makes the roof, Cancel throws it away. -->
                <TabItem x:Name="RoofSketchTab" Header="Modify | Create Roof Footprint" Style="{StaticResource ContextRibbonTab}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Mode" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Finish}"
                                        Content="Finish" Click="OnFinishRoofSketch"
                                        ToolTip="Make the roof from the sketch. The outline must close; if it does not, the lines at fault turn red and the status bar says why"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Cancel}"
                                        Content="Cancel" Click="OnCancelRoofSketch"
                                        ToolTip="Throw the sketch away and leave the model as it was"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Draw" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="RoofSketchPickWalls" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.PickWalls}"
                                                 Content="Pick Walls" CommandParameter="PickWalls"
                                                 ToolTip="Hover just outside a wall and click: the roof edge goes along that face, out by the overhang, and follows the wall if it moves. TAB picks the whole chain of joined walls"/>
                                    <RadioButton x:Name="RoofSketchPickLines" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.DrawPick}"
                                                 Content="Pick Lines" CommandParameter="PickLines"
                                                 ToolTip="Click the edge of a floor, ceiling or another roof, a wall's face or a grid line to take it as a roof line. Offset on the options bar sets it off toward the cursor"/>
                                    <RadioButton x:Name="RoofSketchLine" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.DrawLine}"
                                                 Content="Line" CommandParameter="Line"
                                                 ToolTip="Click points round the roof's edge, chained. Shift keeps a line level or plumb"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="RoofSketchRectangle" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.DrawRectangle}"
                                                 Content="Rectangle" CommandParameter="Rectangle" ToolTip="Two opposite corners"/>
                                    <RadioButton x:Name="RoofSketchPolygon" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.DrawPolygon}"
                                                 Content="Polygon" CommandParameter="Polygon" ToolTip="The centre, then a corner; sides on the options bar"/>
                                    <RadioButton x:Name="RoofSketchCircle" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.DrawCircle}"
                                                 Content="Circle" CommandParameter="Circle"
                                                 ToolTip="The centre, then a point on it. A sloping circle makes a cone - a turret roof"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="RoofSketchArc" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.DrawArc}"
                                                 Content="Arc" CommandParameter="Arc"
                                                 ToolTip="Start, end, then a point the arc passes through. A sloping arc rises as part of a cone - a round end, a bay"/>
                                    <RadioButton x:Name="RoofSketchFillet" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.DrawFilletArc}"
                                                 Content="Fillet Arc" CommandParameter="Fillet"
                                                 ToolTip="Round off a corner: type the radius on the options bar, then click the two lines, each on the part to keep"/>
                                    <RadioButton x:Name="RoofSketchArrow" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.SlopeArrow}"
                                                 Content="Slope Arrow" CommandParameter="SlopeArrow"
                                                 ToolTip="A slope drawn in plan: click a line of the outline for the tail, then where it rises toward. One arrow on a flat roof makes it fall one way; two from the ends of a split eave to its middle make a dormer"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Modify" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="RoofSketchModify" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.Select}"
                                                 Content="Select Lines" CommandParameter="Modify"
                                                 ToolTip="Click sketch lines to select them (Ctrl adds), then delete them or change them on the options bar"/>
                                    <RadioButton x:Name="RoofSketchSplit" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.Split}"
                                                 Content="Split" CommandParameter="Split"
                                                 ToolTip="Click a line where it should divide. Split an eave in three and give the middle to two slope arrows for a dormer"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}"
                                            Content="Delete" Click="OnDeleteSketchLines" ToolTip="Delete the selected sketch lines and arrows (Del)"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="RoofSketchOffset" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.Offset}"
                                                 Content="Offset" CommandParameter="Offset"
                                                 ToolTip="Type a distance on the options bar, then click a line on the side it should move toward - the lines either side follow it. Tick Copy to add a copy instead"/>
                                    <RadioButton x:Name="RoofSketchTrim" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.Trim}"
                                                 Content="Trim/Extend" CommandParameter="TrimExtend"
                                                 ToolTip="Click two lines, each on the part to keep: both are cut back or run on to meet at a corner"/>
                                    <RadioButton x:Name="RoofSketchAlign" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.Offset}"
                                                 Content="Align" CommandParameter="Align"
                                                 ToolTip="Click the line to align to, then a line running the same way: it is brought onto the first, and the lines at its ends follow"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="RoofSketchMove" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.Copy}"
                                                 Content="Move" CommandParameter="Move"
                                                 ToolTip="Move the selected lines: click where from, then where to. Tick Copy on the options bar to copy them"/>
                                    <RadioButton x:Name="RoofSketchMirror" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.Mirror}"
                                                 Content="Mirror" CommandParameter="Mirror"
                                                 ToolTip="Mirror the selected lines about a line clicked with two points - copied, unless Copy is unticked"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Floor" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Margin="2,0">
                                <RadioButton x:Name="RoofSketchSpan" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.SlopeArrow}"
                                             Content="Span Direction" CommandParameter="SpanDirection" Visibility="Collapsed"
                                             ToolTip="Click a line of the outline: the floor spans along it, as its joists or deck run, and its span symbol is drawn in plan"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="RoofSketchToolsPanel" Header="Tools" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Margin="2,0">
                                <RadioButton x:Name="RoofSketchAlignEaves" Style="{StaticResource RoofSketchRadio}" Tag="{StaticResource Icon.AttachTop}"
                                             Content="Align Eaves" CommandParameter="AlignEaves"
                                             ToolTip="Each eave's height is shown beside it. Click the eave to match, then the eaves to bring to the same height - by their plate height, or by their overhang (options bar)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>


        <!-- =================== OPTIONS BAR (active tool) =================== -->
        <Border Grid.Row="2" Background="{StaticResource Bg.Elevated}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal">
                <!-- Selecting: says what is picked, as the contextual tab does. -->
                <TextBlock x:Name="ModifyCaption" Text="Modify" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,18,0" Visibility="Collapsed"/>
                <TextBlock x:Name="TypeLabel" Text="Wall type" Style="{StaticResource OptionLabel}"/>
                <ComboBox x:Name="WallTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveWallTypeChanged"
                          ToolTip="The assembly new walls are built from"/>

                <ComboBox x:Name="DoorTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveDoorTypeChanged"
                          Visibility="Collapsed" ToolTip="The type new doors are placed as"/>

                <ComboBox x:Name="WindowTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveWindowTypeChanged"
                          Visibility="Collapsed" ToolTip="The type new windows are placed as"/>

                <ComboBox x:Name="RoofWindowTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveRoofWindowTypeChanged"
                          Visibility="Collapsed" ToolTip="The roof window type put in the roof"/>

                <ComboBox x:Name="ColumnTypePicker" Style="{StaticResource OptionCombo}" MinWidth="220"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveColumnTypeChanged"
                          Visibility="Collapsed" ToolTip="The type new columns are placed as"/>

                <StackPanel x:Name="ColumnOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="ColumnDirectionPicker" Style="{StaticResource OptionCombo}" MinWidth="90"
                              SelectionChanged="OnColumnPlacementChanged"
                              ToolTip="Height takes the column up from this storey; Depth takes it down from it"/>
                    <ComboBox x:Name="ColumnLevelPicker" Style="{StaticResource OptionCombo}" MinWidth="140"
                              SelectionChanged="OnColumnPlacementChanged"
                              ToolTip="The level the column reaches. Unconnected leaves it standing its own height"/>
                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Grid}"
                            Content="At Grids" Click="OnColumnsAtGrids"
                            ToolTip="Stand a column at every intersection of the selected gridlines"/>
                </StackPanel>

                <ComboBox x:Name="ComponentTypePicker" Style="{StaticResource OptionCombo}" MinWidth="280"
                          SelectionChanged="OnActiveComponentTypeChanged"
                          Visibility="Collapsed" ToolTip="The family new components are placed from"/>
                <CheckBox x:Name="TagOnPlacementBox" Content="Tag on Placement" VerticalAlignment="Center" Margin="0,0,18,0"
                          Visibility="Collapsed" Click="OnTagOnPlacementChanged"
                          ToolTip="Tag each door or window with its mark as it is placed. Space flips which side it hinges; point at the side of the wall it should open toward"/>

                <ComboBox x:Name="SlabTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveSlabTypeChanged"
                          Visibility="Collapsed" ToolTip="The build-up new slabs are placed as"/>

                <!-- The roof sketch's options bar: what new lines do, and - with lines selected - what those do. -->
                <StackPanel x:Name="RoofOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <CheckBox x:Name="RoofDefinesSlopeBox" Content="Defines slope" VerticalAlignment="Center" Margin="12,0,12,0"
                              Click="OnRoofDefinesSlopeChanged"
                              ToolTip="The roof rises from this line. Off, the roof is cut off here - a gable end. All four lines of a box sloping make a hip roof; two opposite ones a gable"/>
                    <TextBlock x:Name="RoofSlopeLabel" Text="Slope" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="RoofSlopeBox" MinWidth="70" VerticalAlignment="Center"
                             LostFocus="OnRoofSlopeChanged" KeyDown="OnRoofSlopeKey"
                             ToolTip="The pitch the roof rises at from a sloping line"/>
                    <TextBlock x:Name="RoofOverhangLabel" Text="Overhang" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="RoofOverhangBox" MinWidth="70" VerticalAlignment="Center"
                             LostFocus="OnRoofOverhangChanged" KeyDown="OnRoofOverhangKey"
                             ToolTip="How far a picked roof edge stands out from its wall - the eaves. The roof still bears on the wall, so the overhang drops below the plate"/>
                    <CheckBox x:Name="RoofExtendToCoreBox" Content="Extend to wall core" VerticalAlignment="Center" Margin="12,0,0,0"
                              Click="OnRoofExtendToCoreChanged"
                              ToolTip="Measure the overhang from the wall's core instead of its finish face"/>
                    <TextBlock x:Name="RoofOffsetLabel" Text="Offset" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="RoofOffsetBox" MinWidth="70" VerticalAlignment="Center"
                             LostFocus="OnRoofOffsetChanged" KeyDown="OnRoofOffsetKey"
                             ToolTip="How far Pick Lines sets a picked line off, and how far Offset moves a line - toward the side the cursor is on"/>
                    <CheckBox x:Name="RoofOffsetCopyBox" Content="Copy" VerticalAlignment="Center" Margin="12,0,0,0"
                              Click="OnRoofOffsetCopyChanged"
                              ToolTip="Offset adds a copy of the line instead of moving it"/>
                    <ComboBox x:Name="RoofAlignPicker" Style="{StaticResource OptionCombo}" MinWidth="130" Margin="12,0,0,0"
                              SelectionChanged="OnRoofAlignModeChanged"
                              ToolTip="Adjust Height brings an eave to the height by raising or lowering its plate. Adjust Overhang keeps the plate and runs the eave out or in until it lands there - for lines picked from walls"/>
                    <TextBlock x:Name="RoofSidesLabel" Text="Sides" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="RoofSidesBox" MinWidth="44" VerticalAlignment="Center"
                             LostFocus="OnRoofSidesChanged" KeyDown="OnRoofSidesKey"
                             ToolTip="How many sides a polygon outline has"/>

                    <!-- A slope arrow's settings: Revit's Specify, and the heights at its two ends. -->
                    <StackPanel x:Name="RoofArrowOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Specify" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox x:Name="RoofArrowSpecifyPicker" Style="{StaticResource OptionCombo}" MinWidth="110"
                                  SelectionChanged="OnRoofArrowSpecifyChanged"
                                  ToolTip="Slope: a pitch rising from the tail. Height at Tail: a height at each end, the pitch worked out between them"/>
                        <TextBlock Text="Tail" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="RoofArrowTailBox" MinWidth="70" VerticalAlignment="Center"
                                 LostFocus="OnRoofArrowTailChanged" KeyDown="OnRoofArrowTailKey"
                                 ToolTip="Height of the surface at the arrow's tail, above the roof's base (Height Offset at Tail)"/>
                        <TextBlock x:Name="RoofArrowHeadLabel" Text="Head" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="RoofArrowHeadBox" MinWidth="70" VerticalAlignment="Center"
                                 LostFocus="OnRoofArrowHeadChanged" KeyDown="OnRoofArrowHeadKey"
                                 ToolTip="Height of the surface at the arrow's head, above the roof's base (Height Offset at Head)"/>
                    </StackPanel>
                </StackPanel>

                <!-- The Dormer tool: what the next dormer clicked onto a roof is. -->
                <StackPanel x:Name="DormerOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Dormer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="DormerShapePicker" Style="{StaticResource OptionCombo}" MinWidth="90"
                              SelectionChanged="OnDormerOptionChanged"
                              ToolTip="Gable: two slopes to a ridge running up the roof. Shed: one shallow slope falling to the front. Hip: slopes on the front and both sides"/>
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="DormerWidthBox" MinWidth="70" VerticalAlignment="Center" LostFocus="OnDormerOptionChanged" KeyDown="OnDormerOptionKey"
                             ToolTip="Across the dormer, between its side walls' centres"/>
                    <TextBlock Text="Height" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="DormerHeightBox" MinWidth="70" VerticalAlignment="Center" LostFocus="OnDormerOptionChanged" KeyDown="OnDormerOptionKey"
                             ToolTip="How high the front wall stands above the roof, up to its eaves. Lowered to what fits under the ridge where it would not"/>
                    <TextBlock Text="Slope" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="DormerSlopeBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnDormerOptionChanged" KeyDown="OnDormerOptionKey"
                             ToolTip="The pitch of the dormer's own roof"/>
                    <TextBlock Text="Overhang" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="DormerOverhangBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnDormerOptionChanged" KeyDown="OnDormerOptionKey"
                             ToolTip="How far the dormer's roof stands out past its walls"/>
                </StackPanel>

                <StackPanel x:Name="StairOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Stair" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="StairDirectionPicker" Style="{StaticResource OptionCombo}" MinWidth="120" Margin="0,0,8,0"
                              SelectionChanged="OnStairOptionChanged"
                              ToolTip="Auto: click where it starts, then the way it runs - out over open space off the edge of a floor, deck or terrace it goes down to the level below, its head where you clicked; otherwise up to the level above. Up from here: its foot where you click. Down from here: its head where you click"/>
                    <ComboBox x:Name="StairTypePicker" Style="{StaticResource OptionCombo}" MinWidth="210"
                              DisplayMemberPath="Name" SelectionChanged="OnStairOptionChanged"
                              ToolTip="How it is built and set out: timber with closed or open risers or a cut string, concrete, or oak treads on a steel spine, on steel stringers or floating from a wall"/>
                    <ComboBox x:Name="StairShapePicker" Style="{StaticResource OptionCombo}" MinWidth="110" Margin="8,0,0,0"
                              SelectionChanged="OnStairOptionChanged"
                              ToolTip="Straight; two flights turning a quarter or a half between them; a spiral round a column; a curve; one wide flight up to a landing that splits two ways; three flights turning a quarter twice; Custom - click along its walking line, each place it turns, and double-click where it ends; or for a loft conversion, alternating treads or a ladder"/>
                    <ComboBox x:Name="StairCornerPicker" Style="{StaticResource OptionCombo}" MinWidth="90" Margin="8,0,0,0"
                              SelectionChanged="OnStairOptionChanged"
                              ToolTip="What the turn turns on: a landing; winders round a newel - three for a quarter turn, six round two newels for a half; or balanced winders, with no newel, the turn shared among the treads either side"/>
                    <ComboBox x:Name="StairTurnPicker" Style="{StaticResource OptionCombo}" MinWidth="90" Margin="8,0,0,0"
                              SelectionChanged="OnStairOptionChanged"
                              ToolTip="Which way it turns, going up"/>
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="StairWidthBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnStairOptionChanged" KeyDown="OnStairWidthKey"
                             ToolTip="Its clear width between its strings"/>
                    <TextBlock x:Name="StairRadiusLabel" Text="Inside radius" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="StairRadiusBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnStairOptionChanged" KeyDown="OnStairWidthKey"
                             ToolTip="How far its inside edge is from its centre: a spiral's column, a curve's well. 0 for the usual - a 120 column, or 1500"/>
                </StackPanel>

                <StackPanel x:Name="RampOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Ramp" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="RampDirectionPicker" Style="{StaticResource OptionCombo}" MinWidth="120" Margin="0,0,8,0"
                              SelectionChanged="OnRampOptionChanged"
                              ToolTip="Auto: click where it starts, then the way it runs - off the edge of a floor, a doorway or a terrace it goes down to the ground, its head where you clicked; otherwise up from the ground to this storey's floor. Up from here: its foot where you click. Down from here: its head where you click"/>
                    <ComboBox x:Name="RampTypePicker" Style="{StaticResource OptionCombo}" MinWidth="190"
                              DisplayMemberPath="Name" SelectionChanged="OnRampOptionChanged"
                              ToolTip="How it is built: solid concrete, a concrete slab, a timber deck, or concrete with glass guarding"/>
                    <ComboBox x:Name="RampShapePicker" Style="{StaticResource OptionCombo}" MinWidth="110" Margin="8,0,0,0"
                              SelectionChanged="OnRampOptionChanged"
                              ToolTip="Straight; two runs at a quarter turn on a landing; a switchback, doubling back on a landing; or Custom - click along its walking line, each place it turns, and double-click"/>
                    <ComboBox x:Name="RampTurnPicker" Style="{StaticResource OptionCombo}" MinWidth="90" Margin="8,0,0,0"
                              SelectionChanged="OnRampOptionChanged"
                              ToolTip="Which way it turns, going up"/>
                    <ComboBox x:Name="RampBuildingPicker" Style="{StaticResource OptionCombo}" MinWidth="120" Margin="8,0,0,0"
                              SelectionChanged="OnRampOptionChanged"
                              ToolTip="A dwelling's ramp is held to Approved Document M Volume 1 - 900 wide, landings 1200; any other building's to Volume 2 - 1500 between kerbs, landings 1500, handrails both sides and a kerb. Under the ADA, the same rules for both"/>
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="RampWidthBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnRampOptionChanged" KeyDown="OnRampOptionKey"
                             ToolTip="Its clear width between its kerbs or handrails"/>
                    <TextBlock Text="Gradient 1 :" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="RampGradientBox" MinWidth="40" VerticalAlignment="Center" LostFocus="OnRampOptionChanged" KeyDown="OnRampOptionKey"
                             ToolTip="How steep it is, as one in so many: 12 is the steepest a ramp may be; 15 and 20 are gentler, with longer flights between landings. 20 or more is a sloping path, not a ramp"/>
                    <TextBlock Text="Rise" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="RampRiseBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnRampOptionChanged" KeyDown="OnRampOptionKey"
                             ToolTip="How high it rises. Auto: from the ground up to this storey's floor - or, going down from a floor's edge, down to the ground; 450 where there is no ground to measure to"/>
                </StackPanel>

                <StackPanel x:Name="RailingOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Railing" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="RailingDrawPicker" Style="{StaticResource OptionCombo}" MinWidth="110" Margin="0,0,8,0"
                              SelectionChanged="OnRailingOptionChanged"
                              ToolTip="By points: click along where it runs. Arcs: each length an arc - click its end, then a point it bows through. Pick edges: click the edges of a floor, balcony or terrace - each next to one already railed joins it at the corner, all round makes one railing all the way round"/>
                    <ComboBox x:Name="RailingTypePicker" Style="{StaticResource OptionCombo}" MinWidth="230"
                              DisplayMemberPath="Name" SelectionChanged="OnRailingOptionChanged"
                              ToolTip="How high it stands and what fills it: balusters, glass, or rails along"/>
                    <TextBlock Text="In" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="RailingBuildingPicker" Style="{StaticResource OptionCombo}" MinWidth="100"
                              SelectionChanged="OnRailingOptionChanged"
                              ToolTip="The building it guards in: a dwelling - 900 at a floor's edge inside, 1100 round a balcony or a roof - or another, where it is 1100 everywhere and guards any drop over 380"/>
                </StackPanel>

                <StackPanel x:Name="PipeOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Pipe" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PipeTypePicker" Style="{StaticResource OptionCombo}" MinWidth="170"
                              DisplayMemberPath="Name" SelectionChanged="OnPipeOptionChanged"
                              ToolTip="What it is made of: copper to BS EN 1057, PE-X, stainless or galvanised steel - each with its own sizes"/>
                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="PipeSizePicker" Style="{StaticResource OptionCombo}" MinWidth="110" SelectionChanged="OnPipeOptionChanged"
                              ToolTip="Its size, outside diameter by wall: or the size of the fitting a run starts from. Size Pipes sets each as BS EN 806-3 asks"/>
                    <TextBlock Text="Offset" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="PipeOffsetBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnPipeOptionChanged"
                             ToolTip="How high above this level the run goes along, to its centre: low along the walls, or up in the ceiling's void"/>
                    <TextBlock Text="Carries" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="PipeKindPicker" Style="{StaticResource OptionCombo}" MinWidth="110" SelectionChanged="OnPipeOptionChanged"
                              ToolTip="What a run started away from any fitting or pipe carries; one started at a fitting or a pipe carries what it does"/>
                    <TextBlock x:Name="PipeFallLabel" Text="Fall (mm/m)" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="PipeFallBox" MinWidth="44" VerticalAlignment="Center" LostFocus="OnPipeOptionChanged"
                             ToolTip="How much a foul or rainwater pipe falls toward where it drains: mm a metre - 18 to 90 for a branch (a basin's long branch 18 to 22), 1 in 80 - 12.5 - at the flattest for a drain with a WC; in a US project inches a foot - 1/4&quot; for a drain 3&quot; and under, 1/8&quot; for one 3&quot; to 6&quot; (IRC Table P3005.3)"/>
                </StackPanel>

                <StackPanel x:Name="DuctOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Duct" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="DuctTypePicker" Style="{StaticResource OptionCombo}" MinWidth="180"
                              DisplayMemberPath="Name" SelectionChanged="OnDuctOptionChanged"
                              ToolTip="What it is: galvanised spiral, rigid PVC round, PVC flat channel - or flexible, for the last connection to a valve only"/>
                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="DuctSizePicker" Style="{StaticResource OptionCombo}" MinWidth="110" SelectionChanged="OnDuctOptionChanged"
                              ToolTip="Its size: or as much as the spigot a run starts from. Size Ducts sets each for its system's pressure"/>
                    <TextBlock Text="Offset" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="DuctOffsetBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnDuctOptionChanged"
                             ToolTip="How high above this level the run goes along, to its centre: in the loft, or a ceiling's void"/>
                    <TextBlock Text="Carries" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="DuctKindPicker" Style="{StaticResource OptionCombo}" MinWidth="110" SelectionChanged="OnDuctOptionChanged"
                              ToolTip="What a run started away from any spigot or duct carries; one started at a spigot or a duct carries what it does"/>
                </StackPanel>

                <StackPanel x:Name="BeamOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Beam" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="BeamTypePicker" Style="{StaticResource OptionCombo}" MinWidth="200"
                              DisplayMemberPath="Name" SelectionChanged="OnBeamOptionChanged"
                              ToolTip="Its section: a steel universal beam or wide flange, C24 timber, GL24h glulam, or concrete"/>
                    <TextBlock Text="Offset" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="BeamOffsetBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnBeamOptionChanged"
                             ToolTip="How far above this level its top is: 0 for its top at the level, under the floor; minus to hang it lower"/>
                </StackPanel>

                <StackPanel x:Name="TerrainOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Elevation" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="GroundElevationBox" MinWidth="70" VerticalAlignment="Center" LostFocus="OnGroundOptionChanged"
                             ToolTip="How high the next spot level is above this level, mm - minus for below it"/>
                    <Button Content="Import Points..." Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center" Click="OnImportGroundPoints"
                            ToolTip="Read spot levels from a points file: x, y and height on each line, comma, semicolon, tab or space between them. Where two fall on the same place, the higher is kept"/>
                    <ComboBox x:Name="GroundUnitsPicker" Style="{StaticResource OptionCombo}" MinWidth="110" Margin="8,0,0,0"
                              ToolTip="What the points file is measured in"/>
                </StackPanel>

                <StackPanel x:Name="RegionOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Region" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="RegionSurfacePicker" Style="{StaticResource OptionCombo}" MinWidth="100" SelectionChanged="OnRegionOptionChanged"
                              ToolTip="What it is laid as"/>
                    <CheckBox x:Name="RegionPathBox" Content="Path" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnRegionOptionChanged"
                              ToolTip="Draw a path along its middle, so wide, rather than an outline"/>
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="PathWidthBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnRegionOptionChanged"
                             ToolTip="How wide the path is: 900 at least for an approach to a door (Approved Document M)"/>
                </StackPanel>

                <StackPanel x:Name="PadOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Pad" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PadSurfacePicker" Style="{StaticResource OptionCombo}" MinWidth="100" SelectionChanged="OnPadOptionChanged"
                              ToolTip="What it is laid as"/>
                    <TextBlock Text="Height" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="PadOffsetBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnPadOptionChanged"
                             ToolTip="How high it is above this level, mm - minus for below: 150 below the floor keeps the damp-proof course clear"/>
                    <TextBlock Text="Batter 1 :" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="PadBatterBox" MinWidth="40" VerticalAlignment="Center" LostFocus="OnPadOptionChanged"
                             ToolTip="The side slope it is battered back to the ground at, so many along to one up: 2 for earth, 3 for a slope to mow; 0 for a sheer edge, held by a wall"/>
                </StackPanel>

                <StackPanel x:Name="MassOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Mass" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="MassFootprintPicker" Width="90" VerticalAlignment="Center" SelectionChanged="OnMassOptionChanged"
                              ToolTip="How its footprint is drawn: two corners of a box, a circle's centre and a point on it, or an outline's corners"/>
                    <TextBlock Text="Top" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <ComboBox x:Name="MassTopPicker" Width="90" VerticalAlignment="Center" SelectionChanged="OnMassOptionChanged"
                              ToolTip="Flat; tapered to a smaller top or a point; or sloping up to a gable, a hip or a shed"/>
                    <TextBlock Text="Height" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="MassHeightBox" MinWidth="64" VerticalAlignment="Center" LostFocus="OnMassOptionChanged"
                             ToolTip="How high it rises - to its top, or its eaves under a sloping top - mm"/>
                    <TextBlock x:Name="MassPitchLabel" Text="Pitch" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="MassPitchBox" MinWidth="44" VerticalAlignment="Center" LostFocus="OnMassOptionChanged"
                             ToolTip="The pitch of a gable, hip or shed top, degrees"/>
                    <TextBlock x:Name="MassScaleLabel" Text="Top scale" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="MassScaleBox" MinWidth="44" VerticalAlignment="Center" LostFocus="OnMassOptionChanged"
                             ToolTip="How big a tapered top is beside its footprint: 0 to a point, 0.5 half as big"/>
                </StackPanel>

                <StackPanel x:Name="PropertyLineOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Property line" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Setback" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox x:Name="SetbackBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnPropertyLineOptionChanged"
                             ToolTip="How far in from it the building is to be kept, mm - as a planning condition or a covenant sets it; 0 for none"/>
                </StackPanel>

                <StackPanel x:Name="JoistOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Joists" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="JoistTypePicker" Style="{StaticResource OptionCombo}" MinWidth="200"
                              DisplayMemberPath="Name" SelectionChanged="OnJoistOptionChanged"
                              ToolTip="The joists' section: C24 timber, glulam, steel"/>
                    <TextBlock Text="Spacing" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="JoistSpacingBox" MinWidth="60" VerticalAlignment="Center" LostFocus="OnJoistOptionChanged"
                             ToolTip="Centre to centre: 400 is usual for a floor, 600 for a roof; 16 in (406) in the US"/>
                </StackPanel>

                <StackPanel x:Name="ChimneyOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Chimney" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ChimneyTypePicker" Style="{StaticResource OptionCombo}" MinWidth="300"
                              DisplayMemberPath="Name" SelectionChanged="OnChimneyOptionChanged"
                              ToolTip="How it is built: a brick stack with pots, a block system chimney, a twin-wall steel flue, a gas vent, a steel or industrial stack"/>
                    <TextBlock Text="At its foot" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="ChimneyFireplacePicker" Style="{StaticResource OptionCombo}" MinWidth="90" SelectionChanged="OnChimneyOptionChanged"
                              ToolTip="An open fireplace or a stove opening into the room through the front of the breast - or nothing. Put by a wall, its back goes to the wall"/>
                </StackPanel>

                <StackPanel x:Name="FaceOpeningOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Opening" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox x:Name="FaceOpeningWidthBox" MinWidth="70" VerticalAlignment="Center" LostFocus="OnFaceOpeningOptionChanged" KeyDown="OnFaceOpeningOptionKey"
                             ToolTip="Across the slope"/>
                    <TextBlock Text="Length" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="FaceOpeningLengthBox" MinWidth="70" VerticalAlignment="Center" LostFocus="OnFaceOpeningOptionChanged" KeyDown="OnFaceOpeningOptionKey"
                             ToolTip="Up the slope, measured on the roof's face rather than in plan"/>
                </StackPanel>

                <StackPanel x:Name="ShaftOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Shaft" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ShaftShapePicker" Style="{StaticResource OptionCombo}" MinWidth="100"
                              SelectionChanged="OnShaftOptionChanged"
                              ToolTip="Rectangle: a chimney, stairwell or lift shaft. Round: a flue or pipe sleeve"/>
                    <TextBlock x:Name="ShaftWidthLabel" Text="Width" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="ShaftWidthBox" MinWidth="70" VerticalAlignment="Center" LostFocus="OnShaftOptionChanged" KeyDown="OnShaftOptionKey"
                             ToolTip="Across the shaft, along the project's X axis; a round one's diameter"/>
                    <TextBlock x:Name="ShaftDepthLabel" Text="Depth" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="ShaftDepthBox" MinWidth="70" VerticalAlignment="Center" LostFocus="OnShaftOptionChanged" KeyDown="OnShaftOptionKey"
                             ToolTip="Across the shaft, along the project's Y axis"/>
                </StackPanel>

                <ComboBox x:Name="RoofEdgeTypePicker" Style="{StaticResource OptionCombo}" MinWidth="220"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveRoofEdgeTypeChanged"
                          Visibility="Collapsed" ToolTip="The fascia or gutter type to run along the edges picked"/>

                <ComboBox x:Name="SweepTypePicker" Style="{StaticResource OptionCombo}" MinWidth="220"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveSweepTypeChanged"
                          Visibility="Collapsed" ToolTip="The sweep or reveal type to place"/>

                <TextBlock Text="Level" Style="{StaticResource OptionLabel}" Margin="16,0,8,0"/>
                <ComboBox x:Name="LevelPicker" Style="{StaticResource OptionCombo}" MinWidth="140"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveLevelChanged"
                          ToolTip="The level new walls are hosted on"/>

                <TextBlock x:Name="LocationLineLabel" Text="Location line" Style="{StaticResource OptionLabel}"/>
                <ComboBox x:Name="LocationLinePicker" Style="{StaticResource OptionCombo}" MinWidth="175"
                          SelectionChanged="OnActiveLocationLineChanged"
                          ToolTip="Which line of the assembly you are drawing to"/>

                <WrapPanel x:Name="WallDrawOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="HeightModePicker" Style="{StaticResource OptionCombo}" MinWidth="80"
                              SelectedIndex="0" SelectionChanged="OnNewWallHeightChanged"
                              ToolTip="Height: the wall rises from its level. Depth: it hangs down from it, like a foundation wall.">
                        <ComboBoxItem Content="Height"/>
                        <ComboBoxItem Content="Depth"/>
                    </ComboBox>
                    <ComboBox x:Name="NewWallTopPicker" Style="{StaticResource OptionCombo}" MinWidth="170"
                              SelectionChanged="OnNewWallHeightChanged"
                              ToolTip="Up to a level, so the wall follows it, or unconnected at the height given"/>
                    <TextBox x:Name="NewWallHeightBox" MinWidth="80" VerticalAlignment="Center" Text="3000 mm"
                             Margin="0,0,18,0" LostFocus="OnNewWallHeightChanged"
                             ToolTip="The unconnected height, or the depth below the level"/>
                    <TextBlock Text="Shape" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="WallShapePicker" Style="{StaticResource OptionCombo}" MinWidth="90"
                              SelectedIndex="0" SelectionChanged="OnWallShapeChanged"
                              ToolTip="One wall at a time, straight or arc, or a whole shape of walls placed with two clicks">
                        <ComboBoxItem Content="Line" Tag="Line"/>
                        <ComboBoxItem Content="Arc" Tag="Arc"/>
                        <ComboBoxItem Content="Tangent arc" Tag="TangentArc"/>
                        <ComboBoxItem Content="Centre-ends arc" Tag="CentreEndsArc"/>
                        <ComboBoxItem Content="Fillet arc" Tag="FilletArc"/>
                        <ComboBoxItem Content="Trapezoid wall" Tag="Trapezoid"/>
                        <ComboBoxItem Content="Polygon wall" Tag="PolygonOutline"/>
                        <ComboBoxItem Content="Rectangle" Tag="Rectangle"/>
                        <ComboBoxItem Content="Polygon" Tag="Polygon"/>
                        <ComboBoxItem Content="Circle" Tag="Circle"/>
                        <ComboBoxItem Content="Oval" Tag="Oval"/>
                        <ComboBoxItem Content="Ellipse" Tag="Ellipse"/>
                        <ComboBoxItem Content="Partial ellipse" Tag="PartialEllipse"/>
                        <ComboBoxItem Content="Pick lines" Tag="Pick"/>
                        <ComboBoxItem Content="Spline" Tag="Spline"/>
                        <ComboBoxItem Content="Freehand" Tag="Freehand"/>
                        <ComboBoxItem Content="By segment" Tag="BySegment"/>
                        <ComboBoxItem Content="By room" Tag="ByRoom"/>
                    </ComboBox>
                    <CheckBox x:Name="ChainRadiusBox" Content="Radius" VerticalAlignment="Center" Margin="0,0,6,0"
                              Click="OnArcRadiusChanged"
                              ToolTip="Round off every corner of a chain of straight walls at this radius. A fillet arc always uses it"/>
                    <TextBox x:Name="ArcRadiusBox" MinWidth="80" VerticalAlignment="Center" Text="1000 mm" Margin="0,0,18,0"
                             LostFocus="OnArcRadiusChanged" KeyDown="OnArcRadiusKey"
                             ToolTip="The radius of a fillet arc, and of the rounded corners of a chain with Radius ticked"/>
                    <StackPanel x:Name="TrapezoidOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Start" Style="{StaticResource OptionLabel}"/>
                        <TextBox x:Name="TrapezoidStartBox" MinWidth="70" VerticalAlignment="Center" Text="300 mm"
                                 LostFocus="OnTrapezoidOptionChanged" ToolTip="How thick it is where it starts"/>
                        <TextBlock Text="End" Style="{StaticResource OptionLabel}"/>
                        <TextBox x:Name="TrapezoidEndBox" MinWidth="70" VerticalAlignment="Center" Text="150 mm"
                                 LostFocus="OnTrapezoidOptionChanged" ToolTip="How thick it is where it ends"/>
                        <TextBlock Text="Straight face" Style="{StaticResource OptionLabel}"/>
                        <ComboBox x:Name="TrapezoidSidePicker" Style="{StaticResource OptionCombo}" MinWidth="80" Margin="0,0,18,0"
                                  SelectionChanged="OnTrapezoidOptionChanged"
                                  ToolTip="Which face runs straight along the line clicked - the other splays - or both splay evenly"/>
                    </StackPanel>
                    <StackPanel x:Name="PolygonOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Sides" Style="{StaticResource OptionLabel}"/>
                        <TextBox x:Name="PolygonSidesBox" MinWidth="44" VerticalAlignment="Center" Text="6"
                                 Margin="0,0,12,0" LostFocus="OnPolygonSidesChanged"
                                 ToolTip="3 for a triangle, up to 32"/>
                        <CheckBox x:Name="PolygonInscribedBox" Content="Click a corner" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,18,0" Click="OnPolygonInscribedChanged"
                                  ToolTip="On: the second click is a corner. Off: it is the middle of a side."/>
                    </StackPanel>
                    <TextBlock Text="Offset" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="WallOffsetBox" MinWidth="90" VerticalAlignment="Center"
                             Text="0 mm" LostFocus="OnWallOffsetChanged" KeyDown="OnWallOffsetKeyDown"
                             ToolTip="Build the wall this far off the line you click, toward its exterior. Negative goes the other way."/>
                    <CheckBox x:Name="AutoJoinBox" Content="Auto Join" VerticalAlignment="Center" Margin="4,0,10,0"
                              Click="OnAutoJoinChanged"
                              ToolTip="Join a new wall to the walls its faces lie against: their doors and windows cut through both"/>
                    <CheckBox x:Name="LockJoinBox" Content="Lock" VerticalAlignment="Center" Margin="0,0,14,0"
                              Click="OnLockJoinChanged"
                              ToolTip="Auto Join and Lock: the joined walls also move together"/>
                    <TextBlock Text="Space flips" Style="{StaticResource OptionLabel}" Opacity="0.6"/>
                </WrapPanel>

                <!-- Editing tool settings, shown only while their tool is active. -->
                <StackPanel x:Name="SweepOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Placement" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="SweepPlacementPicker" Style="{StaticResource OptionCombo}" MinWidth="110"
                              SelectedIndex="0" SelectionChanged="OnSweepPlacementChanged"
                              ToolTip="Horizontal runs along the wall at a height; vertical stands full height where you click">
                        <ComboBoxItem Content="Horizontal"/>
                        <ComboBoxItem Content="Vertical"/>
                    </ComboBox>
                    <TextBlock x:Name="SweepHeightLabel" Text="Offset from base" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="SweepHeightBox" MinWidth="80" VerticalAlignment="Center" Text="0 mm"
                             LostFocus="OnSweepHeightChanged" ToolTip="How high above the wall's base, e.g. 0 for a skirting, 900 for a dado rail"/>
                </StackPanel>

                <!-- Wall Opening: the size of the next opening cut. -->
                <StackPanel x:Name="WallOpeningOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Width" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="OpeningWidthBox" MinWidth="80" VerticalAlignment="Center" Text="1000 mm" Margin="0,0,14,0"
                             LostFocus="OnOpeningSizeChanged"/>
                    <TextBlock Text="Height" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="OpeningHeightBox" MinWidth="80" VerticalAlignment="Center" Text="1000 mm" Margin="0,0,14,0"
                             LostFocus="OnOpeningSizeChanged"/>
                    <TextBlock Text="Sill" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="OpeningSillBox" MinWidth="80" VerticalAlignment="Center" Text="900 mm"
                             LostFocus="OnOpeningSizeChanged" ToolTip="How high its underside is above the wall's base; 0 for a pass-through to the floor"/>
                </StackPanel>

                <!-- The Wall Joins tool: what the picked junctions become. -->
                <WrapPanel x:Name="JunctionOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Configuration" Style="{StaticResource OptionLabel}"/>
                    <RadioButton x:Name="JunctionButt" Content="Butt" GroupName="JunctionType" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Click="OnJunctionTypeChanged" ToolTip="One wall carries on, the others stop against it"/>
                    <RadioButton x:Name="JunctionMitre" Content="Miter" GroupName="JunctionType" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Click="OnJunctionTypeChanged" ToolTip="Each wall cut on the angle between them"/>
                    <RadioButton x:Name="JunctionSquareOff" Content="Square Off" GroupName="JunctionType" VerticalAlignment="Center" Margin="0,0,14,0"
                                 Click="OnJunctionTypeChanged" ToolTip="A wall end squared to 90 degrees past the other"/>
                    <Button x:Name="JunctionPrevious" Content="Previous" Padding="10,3" Margin="0,0,6,0" Click="OnJunctionPrevious"
                            ToolTip="The other way to put this join together: which wall carries on"/>
                    <Button x:Name="JunctionNext" Content="Next" Padding="10,3" Margin="0,0,18,0" Click="OnJunctionNext"
                            ToolTip="The other way to put this join together: which wall carries on"/>
                    <TextBlock Text="Display" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="JunctionDisplayPicker" Style="{StaticResource OptionCombo}" MinWidth="140"
                              SelectionChanged="OnJunctionDisplayChanged"
                              ToolTip="Clean the join so the walls read as one, draw them butting, or do as the view says">
                        <ComboBoxItem Content="Use View Setting"/>
                        <ComboBoxItem Content="Clean Join"/>
                        <ComboBoxItem Content="Don't Clean Join"/>
                    </ComboBox>
                    <RadioButton x:Name="JunctionAllow" Content="Allow Join" GroupName="JunctionAllowed" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Click="OnJunctionAllowedChanged"/>
                    <RadioButton x:Name="JunctionDisallow" Content="Disallow Join" GroupName="JunctionAllowed" VerticalAlignment="Center"
                                 Click="OnJunctionAllowedChanged" ToolTip="Keep these wall ends from joining anything, to leave a gap"/>
                </WrapPanel>

                <!-- Modify Returns: what a click on a sweep's end turns it into. -->
                <StackPanel x:Name="SweepReturnOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <RadioButton x:Name="StraightCutChoice" Content="Straight Cut" GroupName="SweepReturn" VerticalAlignment="Center"
                                 Margin="4,0,12,0" Click="OnSweepReturnChoiceChanged"
                                 ToolTip="The clicked end stops square at the wall end"/>
                    <RadioButton x:Name="ReturnChoice" Content="Return" GroupName="SweepReturn" VerticalAlignment="Center" IsChecked="True"
                                 Click="OnSweepReturnChoiceChanged"
                                 ToolTip="The clicked end turns 90 degrees round the wall end back to the wall face"/>
                </StackPanel>

                <StackPanel x:Name="AttachColumnOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Attachment Style" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="ColumnAttachmentStylePicker" Style="{StaticResource OptionCombo}" MinWidth="130"
                              SelectionChanged="OnColumnAttachmentChanged"
                              ToolTip="Cut Column stops the column at the face it meets; Do Not Cut carries it on through the target"/>
                    <TextBlock Text="Offset" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="ColumnAttachmentOffsetBox" MinWidth="80" VerticalAlignment="Center"
                             Text="0 mm" LostFocus="OnColumnAttachmentOffsetChanged"
                             ToolTip="How far the attached end stops short of the target's face"/>
                </StackPanel>

                <StackPanel x:Name="PickNewHostOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Placement" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="PickNewHostModePicker" Style="{StaticResource OptionCombo}" MinWidth="150"
                              SelectionChanged="OnPickNewHostModeChanged"
                              ToolTip="What Pick New will take as the new host: only a face that stands up, any face, or the level the plan is on"/>
                </StackPanel>

                <StackPanel x:Name="DimensionOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Style" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="DimensionTypePicker" Style="{StaticResource OptionCombo}" MinWidth="170" DisplayMemberPath="Name"
                              SelectionChanged="OnDimensionTypeChanged"
                              ToolTip="The dimension style: its marks, text, witness lines and units. Edit Type on a dimension to change one"/>
                    <CheckBox x:Name="DimensionStringBox" Content="String" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnDimensionStringChanged"
                              ToolTip="Measure through many walls and gridlines in a row: click each in turn, double-click where the line goes"/>
                    <TextBlock Text="Prefer" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="DimensionPreferPicker" Style="{StaticResource OptionCombo}" MinWidth="130" SelectionChanged="OnDimensionPreferChanged"
                              ToolTip="What a click on a wall measures to: its centreline, the face nearer the click, the middle of its core, or the nearer face of its core"/>
                </StackPanel>

                <StackPanel x:Name="RevisionCloudOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Revision" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="CloudRevisionPicker" Style="{StaticResource OptionCombo}" MinWidth="240" SelectionChanged="OnCloudRevisionChanged"
                              ToolTip="The revision the cloud is of. An issued revision cannot be clouded"/>
                    <CheckBox x:Name="CloudTagBox" Content="Tag" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnCloudTagChanged"
                              ToolTip="A triangle with the revision's number beside the cloud"/>
                    <Button Content="Revisions..." Padding="10,3" VerticalAlignment="Center" Click="OnShowRevisions"/>
                </StackPanel>

                <StackPanel x:Name="KeynoteOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Keynote of" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="KeynoteSourcePicker" Style="{StaticResource OptionCombo}" MinWidth="130" SelectionChanged="OnKeynoteSourceChanged"
                              ToolTip="The element's type, the material where it points, or a key picked here"/>
                    <TextBlock x:Name="KeynoteKeyLabel" Text="Key" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="KeynoteKeyPicker" Style="{StaticResource OptionCombo}" MinWidth="320" MaxDropDownHeight="420" SelectionChanged="OnKeynoteKeyChanged"/>
                    <Button Content="Keynotes..." Padding="10,3" VerticalAlignment="Center" Click="OnShowKeynotes"/>
                </StackPanel>

                <StackPanel x:Name="OffsetOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Distance" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="OffsetDistanceBox" MinWidth="90" VerticalAlignment="Center"
                             Text="1000 mm" LostFocus="OnOffsetDistanceChanged"
                             ToolTip="How far away the parallel copy goes, e.g. 1500, 1.5 m"/>
                </StackPanel>

                <StackPanel x:Name="MirrorOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <CheckBox x:Name="MirrorKeepOriginalBox" Content="Keep originals" IsChecked="True"
                              VerticalAlignment="Center" Click="OnMirrorKeepOriginalChanged"
                              ToolTip="Mirror copies and leave the selection where it is"/>
                </StackPanel>

                <StackPanel x:Name="PaintOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Material" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="PaintMaterialPicker" Style="{StaticResource OptionCombo}" MinWidth="220"
                              DisplayMemberPath="Name" SelectionChanged="OnPaintOptionChanged"
                              ToolTip="What is put on the face"/>
                    <CheckBox x:Name="RemovePaintBox" Content="Remove Paint" Margin="12,0,0,0" VerticalAlignment="Center"
                              Click="OnPaintOptionChanged" ToolTip="Take paint off where you click instead"/>
                </StackPanel>

                <StackPanel x:Name="SplitGapOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Joint Gap" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="JointGapBox" MinWidth="80" VerticalAlignment="Center" Text="25 mm"
                             LostFocus="OnJointGapChanged" KeyDown="OnJointGapKey"
                             ToolTip="How wide the joint is: from 1.6 mm to 305 mm"/>
                </StackPanel>

                <StackPanel x:Name="RotateOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Angle" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="RotateAngleBox" MinWidth="70" VerticalAlignment="Center" KeyDown="OnRotateAngleKey"
                             ToolTip="Type an angle and press Enter to turn the selection by it about the centre: anticlockwise, or negative for clockwise"/>
                    <ToggleButton x:Name="RotateCentreButton" Content="Place Centre" Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center"
                                  Click="OnPlaceRotateCentre" ToolTip="Click where it turns about, instead of the middle of the selection"/>
                    <CheckBox x:Name="RotateCopyBox" Content="Copy" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnRotateCopyChanged"
                              ToolTip="Turn copies and leave the selection where it is"/>
                </StackPanel>

                <StackPanel x:Name="ScaleOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Scale" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="ScaleFactorBox" MinWidth="60" VerticalAlignment="Center" Text="2" LostFocus="OnScaleFactorChanged"
                             KeyDown="OnScaleFactorKey" ToolTip="How much bigger: 2 doubles it, 0.5 halves it"/>
                </StackPanel>

                <StackPanel x:Name="ArrayOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Count" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="ArrayCountBox" MinWidth="60" VerticalAlignment="Center"
                             Text="3" LostFocus="OnArrayCountChanged"
                             ToolTip="How many in total, including the original"/>
                    <CheckBox x:Name="ArrayRadialBox" Content="Radial" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnArrayRadialChanged"
                              ToolTip="Repeat round a centre - chairs round a table - instead of along a line: click the centre"/>
                    <TextBlock x:Name="ArrayAngleLabel" Text="Angle" Style="{StaticResource OptionLabel}" Margin="12,0,6,0" Visibility="Collapsed"/>
                    <TextBox x:Name="ArrayAngleBox" MinWidth="60" VerticalAlignment="Center" Visibility="Collapsed"
                             Text="360°" LostFocus="OnArrayAngleChanged"
                             ToolTip="How far round, anticlockwise: 360 spaces them evenly all the way round; less puts the last that far round from the first"/>
                </StackPanel>

                <!-- Editing a group: whatever tool is in hand, until it is finished. -->
                <StackPanel x:Name="GroupEditOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="GroupEditLabel" Text="Editing group" Style="{StaticResource OptionLabel}" FontWeight="SemiBold"/>
                    <Button Content="Add" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center" Click="OnAddToGroup"
                            ToolTip="Put what is picked in the group - with what is hosted in it"/>
                    <Button Content="Remove" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center" Click="OnRemoveFromGroup"
                            ToolTip="Take what is picked out of the group: it stays where it is, on its own"/>
                    <Button Content="Finish" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center" Click="OnFinishGroup"
                            ToolTip="Finish editing: every other of the same group is made over to match"/>
                    <Button Content="Cancel" Padding="10,3" VerticalAlignment="Center" Click="OnCancelGroup"
                            ToolTip="Stop editing, with what was done since it began undone"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ========================= WORKSPACE ========================= -->
        <!--
            Palettes docked on the left - properties over the project browser - and the views
            filling the rest, as desktop BIM tools lay themselves out.
        -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="140"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="2*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Properties, generated from the selected element's own parameters -->
                <Border Grid.Row="0" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaletteTitle}">
                            <TextBlock Text="Properties" FontWeight="SemiBold"/>
                        </Border>

                    <TextBlock x:Name="NoSelectionHint" DockPanel.Dock="Top" Margin="14,0,14,14" Visibility="Collapsed"
                               TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Text.Muted}"
                               Text="Nothing selected."/>

                    <ScrollViewer x:Name="PropertyScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- The type selector: a picture of what it is, its family and type, and the list of types. -->
                            <Border Background="{StaticResource Bg.Elevated}" Padding="10,10,10,8"
                                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Width="50" Height="50" Background="{StaticResource Bg.Field}" CornerRadius="3"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <Image x:Name="SelectedTypeImage" Width="34" Height="34"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedFamilyName" Foreground="{StaticResource Text.Muted}"
                                                   FontSize="{StaticResource UiFontSizeSmall}"/>
                                        <TextBlock x:Name="SelectedTypeName" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <ComboBox x:Name="SelectedTypePicker" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                              DisplayMemberPath="Name" SelectionChanged="OnSelectedTypeChanged"
                                              ToolTip="Change the type of the selection. Every element of a type shares its type properties."/>
                                </Grid>
                            </Border>

                            <!-- Which of the selection these properties are for, and its type's own editor. -->
                            <Border Padding="8,6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PropertyCategoryPicker" SelectionChanged="OnPropertyCategoryChanged"
                                              ToolTip="Which of the selected elements these properties are for"/>
                                    <Button x:Name="EditTypeButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,3"
                                            Click="OnEditSelectedType"
                                            ToolTip="Edit the type: its layers, or its type properties, or duplicate it to make a new one">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource Icon.EditType}" Width="14" Height="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Edit Type" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- This element's own parameters, in folding groups. -->
                            <ItemsControl x:Name="InstanceParameterList" Style="{StaticResource ParameterList}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource PaletteGroup}"/>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>

                            <!-- The type's parameters: shared by every element of it. -->
                            <StackPanel x:Name="TypeSection">
                                <Border Style="{StaticResource PaletteSectionBand}">
                                    <StackPanel>
                                        <TextBlock Text="Type Properties" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TypeHint" TextWrapping="Wrap" FontSize="{StaticResource UiFontSizeSmall}"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="TypeParameterList" Style="{StaticResource ParameterList}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource PaletteGroup}"/>
                                    </ItemsControl.GroupStyle>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The assembly the type is built from. Walls and slabs. -->
                            <StackPanel x:Name="StructureSection" Margin="0,0,0,16">
                                <Border Style="{StaticResource PaletteSectionBand}">
                                    <StackPanel>
                                        <TextBlock Text="Structure" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StructureHint" FontSize="{StaticResource UiFontSizeSmall}"
                                                   Foreground="{StaticResource Text.Muted}" Text="Exterior face to interior face."/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="LayerList" Margin="10,4,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="9" RadiusX="2" RadiusY="2"
                                                           Margin="0,3,10,3" Fill="{Binding Swatch}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MaterialName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding MaterialName}"/>
                                                    <TextBlock Text="{Binding FunctionName}"
                                                               FontSize="{StaticResource UiFontSizeSmall}"
                                                               Foreground="{StaticResource Text.Muted}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Thickness}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource Line}" ResizeDirection="Rows"/>

                <!-- Project browser -->
                <Border Grid.Row="2" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaletteTitle}">
                            <TextBlock Text="Project Browser" FontWeight="SemiBold"/>
                        </Border>
                        <TreeView x:Name="ProjectBrowser" Margin="4,4,4,8"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Line}" ResizeBehavior="PreviousAndNext"/>

            <!--
                The views. The plan, with the section under it and a sheet over it, fills the
                first column; the 3D view either covers it or, tiled, takes a column of its own.
            -->
            <Grid x:Name="ViewArea" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition x:Name="TileSplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="TileColumn" Width="0"/>
                </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 2D plan view: drawn in C#, not composed from XAML controls -->
                <Border Grid.Row="0" Background="{StaticResource Bg.Field}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ViewTitle}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource Icon.Plan}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PlanTitle" Text="Floor Plan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- The view control bar: how this plan is drawn and what it is placed on a sheet at. -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ViewControlBar}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="PlanScalePicker" Style="{StaticResource ViewControlCombo}" MinWidth="78"
                                          SelectionChanged="OnPlanScaleChanged"
                                          ToolTip="View scale: what this plan is placed on a sheet at"/>
                                <Image Source="{StaticResource Icon.Detail}" Width="14" Height="14" Margin="0,0,4,0" ToolTip="Detail level"/>
                                <ComboBox x:Name="PlanDetailPicker" Style="{StaticResource ViewControlCombo}" MinWidth="78"
                                          SelectionChanged="OnPlanDetailChanged"
                                          ToolTip="Detail level: coarse draws walls as outlines, fine shows every layer">
                                    <ComboBoxItem Content="Coarse"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Fine"/>
                                </ComboBox>
                                <ToggleButton x:Name="PlanUnderlayToggle" Style="{StaticResource ViewControlToggle}" IsChecked="True"
                                              Content="Storey Below" Click="OnPlanUnderlayToggled"
                                              ToolTip="Show the storey below faintly under the plan"/>
                                <ToggleButton x:Name="PlanClearancesToggle" Style="{StaticResource ViewControlToggle}"
                                              Content="Clearances" Click="OnPlanClearancesToggled"
                                              ToolTip="Show the clear space fittings need - red where something is in it"/>
                                <ComboBox x:Name="PlanGroundPicker" Style="{StaticResource OptionCombo}" MinWidth="120" Margin="6,0,0,0"
                                          SelectionChanged="OnPlanGroundColouringChanged"
                                          ToolTip="Colour the ground: by slope - level, gently sloping, as steep as a ramp, too steep to mow, steeper than earth stands - by height, or by what is cut and filled against the ground as it was"/>
                                <Button Style="{StaticResource ViewControlButton}" Content="Zoom to Fit" Click="OnPlanZoomToFit"
                                        ToolTip="Frame the whole plan (F)"/>
                            </StackPanel>
                        </Border>
                        <controls:PlanView x:Name="Plan"/>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="SectionSplitter" Grid.Row="1" Height="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{StaticResource Line}" ResizeDirection="Rows"
                              Visibility="Collapsed"/>

                <Border x:Name="SectionPanel" Grid.Row="2" Height="300" Visibility="Collapsed"
                        Background="{StaticResource Bg.Field}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,7" Background="{StaticResource Bg.Elevated}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBlock Text="Section" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox x:Name="SectionPicker" Style="{StaticResource OptionCombo}"
                                              MinWidth="180" SelectionChanged="OnActiveSectionChanged"
                                              ToolTip="Which section marker this view cuts along"/>
                                    <TextBlock x:Name="SectionSummary" VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SectionCalloutButton" Content="Callout" Padding="12,5" Margin="0,0,8,0"
                                            Click="OnSectionCallout"
                                            ToolTip="Drag a box round part of the section: a detail of it, a view of its own at 1:20"/>
                                    <Button Content="Flip" Padding="12,5" Margin="0,0,8,0"
                                            Click="OnFlipSection"
                                            ToolTip="Look the other way along the cut"/>
                                    <Button Content="Zoom to Fit" Padding="12,5" Margin="0,0,8,0"
                                            Click="OnZoomSectionToFit"/>
                                    <Button Content="Close" Padding="12,5" Click="OnCloseSection"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <controls:SectionView x:Name="Section"/>
                            <controls:ProjectedView x:Name="Projected" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!--
                    A sheet covers the whole drawing area rather than sharing it. A sheet is
                    a different thing to be looking at, not another panel of the model: you
                    are looking at the drawing set, and it needs the room.
                -->
                <Border x:Name="SheetPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                        Background="{StaticResource Bg.Field}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,7" Background="{StaticResource Bg.Elevated}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <!--
                                Two columns, not two StackPanels sharing one cell. Overlapping
                                panels look fine on a wide window and silently stack the right
                                buttons on top of the left ones when it narrows - which hides
                                a button behind another button that still takes the click.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sheet" Style="{StaticResource OptionLabel}"/>
                                        <ComboBox x:Name="SheetPicker" Style="{StaticResource OptionCombo}"
                                                  MinWidth="160" SelectionChanged="OnActiveSheetChanged"
                                                  ToolTip="Which sheet of the drawing set is open"/>

                                        <TextBlock Text="Place" Style="{StaticResource OptionLabel}"/>
                                        <ComboBox x:Name="SheetViewPicker" Style="{StaticResource OptionCombo}"
                                                  MinWidth="140" Margin="0,0,8,0" DisplayMemberPath="Display"
                                                  ToolTip="A view from the project to drop onto this sheet"/>
                                        <Button Content="Add" Padding="14,5" Margin="0,0,18,0"
                                                Click="OnPlaceViewOnSheet"
                                                ToolTip="Place the chosen view on this sheet"/>
                                        <Button Content="Picture..." Padding="10,5" Margin="0,0,18,0"
                                                Click="OnPlaceSheetImage"
                                                ToolTip="Put a picture on this sheet - a rendering, a photograph, a logo: a PNG, JPEG, BMP, GIF or TIFF file. It is kept in the project, drawn over the views, printed in the PDF and written beside a DWG"/>

                                        <TextBlock Text="Scale" Style="{StaticResource OptionLabel}"/>
                                        <ComboBox x:Name="ViewportScalePicker" Style="{StaticResource OptionCombo}"
                                                  MinWidth="90" IsEnabled="False"
                                                  SelectionChanged="OnViewportScaleChanged"
                                                  ToolTip="The scale the selected view is drawn at"/>

                                        <TextBlock Text="Width" Style="{StaticResource OptionLabel}" Margin="12,0,6,0"/>
                                        <TextBox x:Name="SheetImageWidthBox" MinWidth="60" VerticalAlignment="Center" IsEnabled="False"
                                                 LostFocus="OnSheetImageWidthChanged" KeyDown="OnSheetImageWidthKey"
                                                 ToolTip="How wide the selected picture is printed on the sheet, mm - its height follows its own proportions"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Export PDF" Padding="8,4" Margin="0,0,6,0"
                                            Click="OnExportSheetPdf"
                                            ToolTip="Write this sheet out as a PDF"/>
                                    <Button Content="Export DWG" Padding="8,4" Margin="0,0,6,0"
                                            Click="OnExportSheetCad"
                                            ToolTip="Write this sheet out as a DWG or DXF drawing, at paper size in millimetres"/>
                                    <Button x:Name="RemoveViewportButton" Content="Remove" Padding="8,4" ToolTip="Take the selected view or picture off this sheet (Delete)"
                                            Margin="0,0,6,0" IsEnabled="False" Click="OnRemoveViewport"/>
                                    <Button Content="Zoom to Fit" Padding="8,4" Margin="0,0,6,0"
                                            Click="OnZoomSheetToFit"/>
                                    <Button Content="Close" Padding="8,4" Click="OnCloseSheet"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:SheetView x:Name="SheetSurface"/>
                    </DockPanel>
                </Border>

            </Grid>

                <GridSplitter x:Name="TileSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{StaticResource Line}" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>

                <Border x:Name="ModelPanel" Grid.Column="0" Panel.ZIndex="2" Visibility="Collapsed"
                        Background="{StaticResource Bg.Field}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,7" Background="{StaticResource Bg.Elevated}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Show" Style="{StaticResource OptionLabel}"/>
                                        <CheckBox x:Name="ShowRoofsBox" Content="Roofs" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Lift the roofs off to look inside"/>
                                        <CheckBox x:Name="ShowCeilingsBox" Content="Ceilings" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"/>
                                        <CheckBox x:Name="ShowFloorsBox" Content="Floors" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"/>
                                        <CheckBox x:Name="ShowGroundBox" Content="Ground Plane" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Hide the ground to see what is below ground level"/>
                                        <CheckBox x:Name="ShowWallsBox" Content="Walls" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Take the walls away - to see their frames"/>
                                        <CheckBox x:Name="ShowFramingBox" Content="Framing" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="The studs inside framed walls"/>
                                        <CheckBox x:Name="ShowStairsBox" Content="Stairs" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Stairs, their handrails and the guarding round their stairwells"/>
                                        <CheckBox x:Name="ShowRampsBox" Content="Ramps" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Ramps, their kerbs, handrails and guarding"/>
                                        <CheckBox x:Name="ShowRailingsBox" Content="Railings" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Railings round balconies, terraces and floors' edges"/>
                                        <CheckBox x:Name="ShowBeamsBox" Content="Beams" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Beams under the floors and roofs they carry"/>
                                        <CheckBox x:Name="ShowTerrainBox" Content="Terrain" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="The ground: the toposurface the building is set into"/>
                                        <CheckBox x:Name="ShowEdgesBox" Content="Edges" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,22,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Draw the model's edges over the shading"/>

                                        <TextBlock Text="Storeys" Style="{StaticResource OptionLabel}"/>
                                        <ItemsControl x:Name="StoreyToggles" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Close" Padding="12,5" Click="OnClose3D"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- The view control bar: how this view is drawn, as under every Revit view. -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ViewControlBar}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ModelCaption" Text="3D View" Style="{StaticResource ViewControlCaption}"/>
                                    <Image Source="{StaticResource Icon.View3D}" Width="14" Height="14" Margin="0,0,4,0"
                                           ToolTip="Visual style"/>
                                    <ComboBox x:Name="VisualStylePicker" Style="{StaticResource ViewControlCombo}"
                                              MinWidth="110" SelectionChanged="OnVisualStyleChanged"
                                              ToolTip="Visual style: shaded, flat colours, see-through, wireframe - every edge, those behind too - or hidden line, white faces and black edges"/>
                                    <CheckBox x:Name="PerspectiveBox" Content="Perspective" VerticalAlignment="Center" Margin="6,0,8,0"
                                              Click="OnPerspectiveChanged"
                                              ToolTip="In perspective, as the eye sees; or orthographic, every line its true direction, as an axonometric is drawn"/>
                                    <ToggleButton x:Name="SectionBoxToggle" Style="{StaticResource ViewControlToggle}" Content="Section Box"
                                                  Click="OnToggleSectionBox"
                                                  ToolTip="Show only what is inside a box round the model; pull its faces in by the handles on them"/>
                                    <Button x:Name="BoxSelectionButton" Style="{StaticResource ViewControlButton}" Content="Box Selection"
                                            Click="OnBoxSelection"
                                            ToolTip="A section box round what is selected (BX)"/>
                                    <ToggleButton x:Name="WalkToggle" Style="{StaticResource ViewControlToggle}" Content="Walk"
                                                  Click="OnToggleWalk"
                                                  ToolTip="Walk through the model at eye height: W A S D or the arrows, Shift to hurry, drag to look round, Esc to stop"/>
                                    <ComboBox x:Name="WalkAsPicker" Style="{StaticResource ViewControlCombo}" Width="130"
                                              SelectionChanged="OnWalkAsChanged"
                                              ToolTip="Who walks: an adult, eyes at 1750; a child, at 1100; or a wheelchair user, eyes at 1200 - stopped by any step over 15 mm (1/2 in under US codes), anything steeper than 1:12 and any doorway narrower than 700"/>
                                    <Button x:Name="SaveViewButton" Style="{StaticResource ViewControlButton}" Content="Save View"
                                            Click="OnSave3DView"
                                            ToolTip="Keep this view by a name of its own - its camera, style, section box and what it shows - to open again or place on a sheet"/>
                                    <StackPanel x:Name="WalkthroughBar" Orientation="Horizontal" Visibility="Collapsed">
                                        <Button x:Name="PlayButton" Style="{StaticResource ViewControlButton}" Content="Play"
                                                Click="OnPlayWalkthrough" ToolTip="Play the walkthrough from this frame; Esc stops it"/>
                                        <Button Style="{StaticResource ViewControlButton}" Content="|&lt;" Click="OnWalkthroughFirst" ToolTip="The first frame"/>
                                        <Button Style="{StaticResource ViewControlButton}" Content="&lt;" Click="OnWalkthroughBack" ToolTip="Back a key frame"/>
                                        <Button Style="{StaticResource ViewControlButton}" Content="&gt;" Click="OnWalkthroughForward" ToolTip="On a key frame"/>
                                        <Button x:Name="ExportWalkthroughButton" Style="{StaticResource ViewControlButton}" Content="Export Video"
                                                Click="OnExportWalkthrough" ToolTip="Save the walkthrough as a video - a Motion-JPEG AVI - every frame of it, the size the 3D view is"/>
                                        <TextBlock x:Name="FrameText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource ViewControlButton}" Content="Zoom to Fit" Click="OnZoom3DToFit"
                                            ToolTip="Frame the whole model (F)"/>
                                    <Button Style="{StaticResource ViewControlButton}" Content="Reset" Click="OnReset3DView"
                                            ToolTip="Back to the three-quarter view (Home)"/>
                                </StackPanel>
                                <TextBlock x:Name="ModelHelp" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                           Text="Drag to orbit  ·  right-drag to pan  ·  scroll to zoom  ·  click to select"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <controls:ModelView x:Name="Model3D"/>

                            <!-- The ViewCube and navigation bar, top right, as in Revit. -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                                <controls:ViewCube x:Name="Cube"/>
                                <Border Style="{StaticResource NavigationBar}">
                                    <StackPanel>
                                        <Button Style="{StaticResource NavigationButton}" Click="OnZoom3DToFit" ToolTip="Zoom to fit (F)"
                                                AutomationProperties.Name="Zoom to Fit">
                                            <Path Data="M1,5 L1,1 L5,1 M11,1 L15,1 L15,5 M15,11 L15,15 L11,15 M5,15 L1,15 L1,11 M5,5 L11,5 L11,11 L5,11 Z"/>
                                        </Button>
                                        <Button Style="{StaticResource NavigationButton}" Click="OnZoom3DIn" ToolTip="Zoom in"
                                                AutomationProperties.Name="Zoom In">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8"/>
                                        </Button>
                                        <Button Style="{StaticResource NavigationButton}" Click="OnZoom3DOut" ToolTip="Zoom out"
                                                AutomationProperties.Name="Zoom Out">
                                            <Path Data="M2,8 L14,8"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>


        <!-- ======================== SCHEDULE VIEW ======================== -->
        <GridSplitter x:Name="ScheduleSplitter" Grid.Row="4" Height="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{StaticResource Line}" ResizeDirection="Rows"
                      Visibility="Collapsed"/>

        <Border x:Name="SchedulePanel" Grid.Row="5" Height="280" Visibility="Collapsed"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,8" Background="{StaticResource Bg.Elevated}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                            <TextBlock Text="Schedule" Style="{StaticResource OptionLabel}"/>
                            <ComboBox x:Name="SchedulePicker" Style="{StaticResource OptionCombo}"
                                      MinWidth="220" SelectionChanged="OnScheduleChanged"/>
                            <Button Content="New..." Padding="10,4" Margin="0,0,6,0" Click="OnNewSchedule"
                                    ToolTip="A schedule of your own: its category, fields, filters, sorting, grouping, calculated values and colours"/>
                            <Button Content="Edit..." Padding="10,4" Margin="0,0,6,0" Click="OnEditSchedule"
                                    ToolTip="This schedule's fields, filters, sorting and grouping, calculated values and colours"/>
                            <Button Content="Duplicate" Padding="10,4" Margin="0,0,6,0" Click="OnDuplicateSchedule"/>
                            <Button Content="Delete" Padding="10,4" Margin="0,0,12,0" Click="OnDeleteSchedule"
                                    ToolTip="Deletes the schedule, and takes it off any sheet it is on"/>
                            <TextBlock x:Name="ScheduleSummary" VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Muted}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ScheduleProblem" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="#C0392B" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ExportCsvButton" Content="Export CSV..." Padding="12,5"
                                    Margin="0,0,8,0" Click="OnExportSchedule"/>
                            <Button Content="Close" Padding="12,5" Click="OnCloseSchedule"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12,7"
                        Background="{StaticResource Bg.Elevated}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="ScheduleTotals" Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <DataGrid x:Name="ScheduleGrid" CellEditEnding="OnScheduleCellEdited"
                          SelectionChanged="OnScheduleSelectionChanged"
                          PreviewKeyDown="OnScheduleKeyDown">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg.Elevated}" Padding="10,5" Margin="0,4,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}"
                                                   Foreground="{StaticResource Accent}"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ========================= STATUS BAR ========================= -->
        <Border Grid.Row="6" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusX" Text="X: 0 mm" MinWidth="96" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusY" Text="Y: 0 mm" MinWidth="96" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusGrid" Text="Grid: 100 mm" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusZoom" Text="Zoom 100%" MinWidth="86" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusDetail" Text="Detail: Fine" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusSaved" Text="Unsaved project" Style="{StaticResource StatusText}"/>
                    <Button x:Name="StatusClearances" Style="{StaticResource ViewControlButton}" Visibility="Collapsed"
                            Margin="0,0,26,0" Click="OnClearanceWarnings"
                            ToolTip="Fittings with something in the clear space they need - click to list them"/>
                </StackPanel>

                <TextBlock x:Name="StatusHint" Grid.Column="2" Text="Ready"
                           Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
