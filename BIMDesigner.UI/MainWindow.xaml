<Window x:Class="BIMDesigner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BIMDesigner.UI.Controls"
        xmlns:vm="clr-namespace:BIMDesigner.UI.ViewModels"
        mc:Ignorable="d"
        Title="BIMDesigner 0.1" Height="740" Width="1220"
        MinHeight="420" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Closing="OnWindowClosing">

    <Window.InputBindings>
        <!-- New/Open/Save/Undo/Redo/Delete already carry their standard gestures. -->
        <KeyBinding Command="SaveAs" Key="S" Modifiers="Ctrl+Shift"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="OnNewProject"/>
        <CommandBinding Command="Open" Executed="OnOpenProject"/>
        <CommandBinding Command="Save" Executed="OnSaveProject"/>
        <CommandBinding Command="SaveAs" Executed="OnSaveProjectAs"/>
        <CommandBinding Command="Undo" Executed="OnUndo" CanExecute="OnCanUndo"/>
        <CommandBinding Command="Redo" Executed="OnRedo" CanExecute="OnCanRedo"/>
        <CommandBinding Command="Delete" Executed="OnDeleteSelected" CanExecute="OnCanDelete"/>
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            Every keyed style below sets BasedOn. An explicit Style replaces the implicit
            theme style outright, so without it a control silently reverts to WPF's stock
            light template - which is what made these ComboBoxes unreadable.
        -->

        <!-- Section caption: "PROJECT BROWSER", "INSTANCE PARAMETERS". -->
        <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="14,14,14,8"/>
        </Style>

        <!-- The Properties palette, as Revit's: groups that fold shut under a band with a
             chevron, and rows ruled into a two-column grid. -->
        <vm:PaletteGroupState x:Key="PaletteGroupOpen"/>

        <Style x:Key="PaletteGroupHeader" TargetType="ToggleButton">
            <EventSetter Event="Click" Handler="OnPaletteGroupToggled"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Band" Background="{StaticResource Bg.Elevated}" Padding="6,4"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Chevron" Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Text.Muted}"
                                      Width="8" Height="5" Margin="2,0,8,0" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Band" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaletteGroup" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton x:Name="Header" Style="{StaticResource PaletteGroupHeader}"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding Name, Mode=OneTime, Converter={StaticResource PaletteGroupOpen}}"/>
                            <ItemsPresenter x:Name="Rows"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Header" Property="IsChecked" Value="False">
                                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A heading between the palette's sections: Type Properties, Structure. -->
        <Style x:Key="PaletteSectionBand" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.Window}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Toolbar tool buttons behave like radio buttons: one active tool at a time. -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="4" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="OptionCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- The narrow arrow beside a ribbon button that opens its list, as on Revit's Wall button. -->
        <Style x:Key="RibbonDropArrow" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Margin" Value="-2,0,2,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2">
                            <Path Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Text}" Width="8" Height="5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The wall shapes on the Place Wall tab: one of them at a time, apart from the tools. -->
        <Style x:Key="WallShapeRadio" TargetType="RadioButton" BasedOn="{StaticResource RibbonSmallRadio}">
            <Setter Property="GroupName" Value="WallShape"/>
            <EventSetter Event="Click" Handler="OnPlaceWallShape"/>
        </Style>

        <Style x:Key="WallShapeLargeRadio" TargetType="RadioButton">
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="GroupName" Value="WallShape"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="MaxWidth" Value="76"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template" Value="{StaticResource RibbonLargeTemplate}"/>
            <EventSetter Event="Click" Handler="OnPlaceWallShape"/>
        </Style>

        <!-- The strip under a view that says how it is drawn: scale, detail, style. -->
        <Style x:Key="ViewControlBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="ViewControlCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,12,0"/>
        </Style>

        <Style x:Key="ViewControlCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="ViewControlButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,2"/>
        </Style>

        <Style x:Key="ViewControlToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,2"/>
        </Style>

        <!-- The navigation bar under the ViewCube: a column of small square buttons. -->
        <Style x:Key="NavigationBar" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2,4,0"/>
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button">
            <Style.Resources>
                <Style TargetType="Path">
                    <Setter Property="Stroke" Value="{StaticResource Text}"/>
                    <Setter Property="StrokeThickness" Value="1.5"/>
                    <Setter Property="Width" Value="16"/>
                    <Setter Property="Height" Value="16"/>
                </Style>
            </Style.Resources>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One parameter, as a row of the palette's ruled grid: its name on the left, and on
             the right an editor chosen by the parameter itself. -->
        <DataTemplate DataType="{x:Type vm:ParameterRow}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="55*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,0,6,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Computed values: length, area, volume. Not editable by design. -->
                    <TextBlock Grid.Column="1" Text="{Binding Text, Mode=OneWay}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="6,0" Foreground="{StaticResource Text.Muted}"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center" Margin="2,1" Padding="4,1" MinHeight="22"
                             Visibility="{Binding IsEditableText, Converter={StaticResource BoolToVisibility}}"/>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding SelectedChoice}" VerticalAlignment="Center" Margin="2,1" Padding="6,1" MinHeight="22"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"/>

                    <CheckBox Grid.Column="1" IsChecked="{Binding Flag}" VerticalAlignment="Center" Margin="6,0"
                              Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ParameterList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- quick access -->
            <RowDefinition Height="Auto"/>   <!-- ribbon -->
            <RowDefinition Height="Auto"/>   <!-- options bar -->
            <RowDefinition Height="*"/>      <!-- workspace -->
            <RowDefinition Height="Auto"/>   <!-- schedule splitter -->
            <RowDefinition Height="Auto"/>   <!-- schedule view -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ======================== QUICK ACCESS ======================== -->
        <Border Grid.Row="0" Background="{StaticResource Bg.Window}" Padding="6,2">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Open}" Command="Open" ToolTip="Open project (Ctrl+O)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Save}" Command="Save" ToolTip="Save (Ctrl+S)"/>
                <Rectangle Width="1" Margin="5,3" Fill="{StaticResource Line}"/>
                <Button x:Name="QuickUndo" Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Undo}" Command="Undo" ToolTip="Undo (Ctrl+Z)"/>
                <Button x:Name="QuickRedo" Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Redo}" Command="Redo" ToolTip="Redo (Ctrl+Y)"/>
                <Rectangle Width="1" Margin="5,3" Fill="{StaticResource Line}"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Print}" Click="OnPrintSheets" ToolTip="Print (Ctrl+P)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Dimension}" Click="OnQuickDimension" ToolTip="Dimension (M)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Text}" Click="OnQuickText" ToolTip="Text (E)"/>
                <Rectangle Width="1" Margin="5,3" Fill="{StaticResource Line}"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.View3D}" Click="OnToggle3D" ToolTip="3D view (Ctrl+3)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Section}" Click="OnQuickSection" ToolTip="Section (C)"/>
                <Button Style="{StaticResource QuickButton}" Tag="{StaticResource Icon.Tile}" Click="OnQuickTile" ToolTip="Tile the plan and the 3D view side by side"/>
            </StackPanel>
        </Border>

        <!-- =========================== RIBBON =========================== -->
        <DockPanel Grid.Row="1" Background="{StaticResource Bg.Window}">
            <!-- The File menu hangs off the blue button, as in CAD ribbons. -->
            <Button x:Name="FileButton" DockPanel.Dock="Left" VerticalAlignment="Top" Content="File"
                    Style="{StaticResource FileTabButton}" Click="OnFileButton">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_New Project" Command="New" InputGestureText="Ctrl+N">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.New}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Open Project..." Command="Open" InputGestureText="Ctrl+O">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Open}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="_Save" Command="Save" InputGestureText="Ctrl+S">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Save}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save _As..." Command="SaveAs" InputGestureText="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem x:Name="UndoItem" Header="_Undo" Command="Undo" InputGestureText="Ctrl+Z">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Undo}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RedoItem" Header="_Redo" Command="Redo" InputGestureText="Ctrl+Y">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Redo}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Export _IFC..." Click="OnExportIfc">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Export}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Export This Sheet to PDF..." Click="OnExportSheetPdf">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Pdf}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Export _Drawing Set to PDF..." Click="OnExportDrawingSetPdf"/>
                        <MenuItem Header="_Print..." Click="OnPrintSheets" InputGestureText="Ctrl+P">
                            <MenuItem.Icon><Image Source="{StaticResource Icon.Print}" Width="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="OnExit"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <TabControl x:Name="Ribbon" Style="{StaticResource RibbonTabs}">
                <!-- ========================= ARCHITECTURE ========================= -->
                <TabItem Header="Architecture" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Select" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="SelectTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Select}"
                                         Content="Modify" IsChecked="True" Checked="OnToolChanged" ToolTip="Select and edit elements (S)"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Build" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WallTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Wall}"
                                             Content="Wall" Checked="OnToolChanged" ToolTip="Draw walls, including curtain walls (W)"/>
                                <Button x:Name="WallMenuButton" Style="{StaticResource RibbonDropArrow}" Click="OnWallMenu"
                                        AutomationProperties.Name="Wall options"
                                        ToolTip="Every way to draw a wall: shapes, place by segment or room, sweeps and reveals, auto join"/>
                                <RadioButton x:Name="DoorTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Door}"
                                             Content="Door" Checked="OnToolChanged" ToolTip="Place a door in a wall (D)"/>
                                <RadioButton x:Name="WindowTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Window}"
                                             Content="Window" Checked="OnToolChanged" ToolTip="Place a window in a wall (N)"/>
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Column}"
                                             Content="Column" IsEnabled="False" ToolTip="Columns are not built yet"/>
                                <RadioButton x:Name="RoofTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Roof}"
                                             Content="Roof" Checked="OnToolChanged" ToolTip="Roof an enclosed space, flat roofs only (F4)"/>
                                <RadioButton x:Name="CeilingTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Ceiling}"
                                             Content="Ceiling" Checked="OnToolChanged" ToolTip="Put a ceiling over an enclosed space (F3)"/>
                                <RadioButton x:Name="FloorTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Floor}"
                                             Content="Floor" Checked="OnToolChanged" ToolTip="Lay a floor over an enclosed space (F2)"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.CurtainGrid}"
                                        Content="Curtain Grid" Click="OnEditCurtainGrid"
                                        ToolTip="Add, move or delete the grid lines of the selected curtain wall, and make panels solid, empty or doors"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.WallTypes}"
                                        Content="Wall Types" Click="OnManageWallTypes"
                                        ToolTip="Layered, stacked and curtain wall types"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Wall" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SweepTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Sweep}"
                                             Content="Sweep" Checked="OnToolChanged"
                                             ToolTip="Place a skirting, cornice or other profile along a wall, or upright on it"/>
                                <RadioButton x:Name="RevealTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Reveal}"
                                             Content="Reveal" Checked="OnToolChanged"
                                             ToolTip="Cut a groove along a wall, or up it"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Profile}"
                                        Content="Edit Profile" Click="OnEditProfile"
                                        ToolTip="Change the outline of the selected straight wall seen square-on: a gable, steps, a notch"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachTop}"
                                            Content="Attach Top" Click="OnAttachTops"
                                            ToolTip="Take the selected walls up to the floor, ceiling or roof over each"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachBase}"
                                            Content="Attach Base" Click="OnAttachBases"
                                            ToolTip="Stand the selected walls on the floor under each"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Detach}"
                                            Content="Detach" Click="OnDetachWalls"
                                            ToolTip="Detach the tops and bases of the selected walls"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Room &amp; Area" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="RoomTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Room}"
                                         Content="Room" Checked="OnToolChanged" ToolTip="Place a room in an enclosed space (R)"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Datum" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Level}"
                                        Content="Level" Click="OnManageLevels" ToolTip="Add, rename, move and delete storeys"/>
                                <RadioButton x:Name="GridTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Grid}"
                                             Content="Grid" Checked="OnToolChanged" ToolTip="Draw a setting-out gridline (G)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================ MODIFY ============================ -->
                <TabItem Header="Modify" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Select" Style="{StaticResource RibbonPanel}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Select}"
                                    Content="Modify" Click="OnSelectModify" ToolTip="Back to selecting (S)"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Clipboard" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Paste}"
                                        Content="Paste" Click="OnPaste" ToolTip="Paste onto the current level (Ctrl+V)"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Copy}"
                                            Content="Copy" Click="OnCopy" ToolTip="Copy the selection (Ctrl+C)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Paste}"
                                            Content="Paste in Place" Click="OnPasteInPlace" ToolTip="Paste where it came from (Ctrl+Shift+V)"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Select}"
                                            Content="Select All" Click="OnSelectAll" ToolTip="Everything on this level (Ctrl+A)"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Modify" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SplitTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Split}"
                                             Content="Split" Checked="OnToolChanged" ToolTip="Split a wall in two where you click (X)"/>
                                <RadioButton x:Name="TrimTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Trim}"
                                             Content="Trim / Extend" Checked="OnToolChanged" ToolTip="Click a wall, then the wall to trim or extend it to (T)"/>
                                <RadioButton x:Name="OffsetTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Offset}"
                                             Content="Offset" Checked="OnToolChanged" ToolTip="Make a parallel copy of a wall a set distance away (O)"/>
                                <RadioButton x:Name="MirrorTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Mirror}"
                                             Content="Mirror" Checked="OnToolChanged" ToolTip="Reflect the selection about a line (I)"/>
                                <RadioButton x:Name="ArrayTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Array}"
                                             Content="Array" Checked="OnToolChanged" ToolTip="Repeat the selection at a regular spacing (Y)"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Delete}"
                                        Content="Delete" Command="Delete" ToolTip="Delete the selection (Del)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- =========================== ANNOTATE =========================== -->
                <TabItem Header="Annotate" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Dimension" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="DimensionTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Dimension}"
                                         Content="Aligned" Checked="OnToolChanged" ToolTip="Measure between two points or elements (M)"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Tag" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="TagTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Tag}"
                                         Content="Tag" Checked="OnToolChanged" ToolTip="Label an element with one of its parameters (A)"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Text" Style="{StaticResource RibbonPanel}">
                            <RadioButton x:Name="TextTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Text}"
                                         Content="Text" Checked="OnToolChanged" ToolTip="Write a note on the drawing (E)"/>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================= VIEW ============================= -->
                <TabItem Header="View" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Graphics" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <RadioButton x:Name="DetailCoarse" GroupName="Detail" Style="{StaticResource RibbonSmallRadio}"
                                                 Tag="{StaticResource Icon.Detail}" Content="Coarse" Click="OnDetailLevelChanged"/>
                                    <RadioButton x:Name="DetailMedium" GroupName="Detail" Style="{StaticResource RibbonSmallRadio}"
                                                 Tag="{StaticResource Icon.Detail}" Content="Medium" Click="OnDetailLevelChanged"/>
                                    <RadioButton x:Name="DetailFine" GroupName="Detail" Style="{StaticResource RibbonSmallRadio}"
                                                 Tag="{StaticResource Icon.Detail}" Content="Fine" IsChecked="True" Click="OnDetailLevelChanged"/>
                                </StackPanel>
                                <ToggleButton x:Name="UnderlayMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Underlay}"
                                              Content="Storey Below" IsChecked="True" Click="OnToggleUnderlay"
                                              ToolTip="Show the storey below faintly under the plan"/>
                                <Button x:Name="WallFunctionsButton" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Filter}"
                                        Content="Wall Functions" Click="OnWallFunctionsButton"
                                        ToolTip="Show or hide walls by function, separately in each view">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="WallFunctionsMenu" Opened="OnWallFunctionsMenuOpened">
                                            <MenuItem Header="(views)"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Create" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ModelMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.View3D}"
                                              Content="3D View" Click="OnToggle3D" ToolTip="Ctrl+3"/>
                                <RadioButton x:Name="SectionTool" Style="{StaticResource RibbonTool}" Tag="{StaticResource Icon.Section}"
                                             Content="Section" Checked="OnToolChanged" ToolTip="Cut a section through the building (C)"/>
                                <ToggleButton x:Name="SectionMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Plan}"
                                              Content="Section View" Click="OnToggleSection" ToolTip="Show or hide the section under the plan"/>
                                <ToggleButton x:Name="ScheduleMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Schedule}"
                                              Content="Schedules" Click="OnToggleSchedules" ToolTip="Ctrl+T"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Takeoff}"
                                        Content="Material Takeoff" Click="OnShowTakeoff"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Sheet Composition" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="SheetMenuItem" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Sheet}"
                                              Content="Sheet" Click="OnToggleSheet" ToolTip="Ctrl+H"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Sheet}"
                                            Content="New Sheet" Click="OnNewSheet"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.PlaceView}"
                                            Content="Place View" Click="OnPlaceViewOnSheet"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Delete}"
                                            Content="Delete Sheet" Click="OnDeleteSheet"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Windows" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="TileToggle" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Tile}"
                                              Content="Tile Views" Click="OnToggleTile"
                                              ToolTip="The plan and the 3D view side by side, the section under the plan"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Plan}"
                                        Content="Zoom to Fit" Click="OnZoomToFit" ToolTip="F"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ============================ MANAGE ============================ -->
                <TabItem Header="Manage" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Settings" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.WallTypes}"
                                        Content="Wall Types" Click="OnManageWallTypes"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Level}"
                                        Content="Levels" Click="OnManageLevels"/>
                                <ToggleButton x:Name="DarkThemeToggle" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Theme}"
                                              Content="Dark Theme" Click="OnToggleDarkTheme"
                                              ToolTip="Light or dark. Takes effect the next time BIMDesigner starts."/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Export" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Export}"
                                        Content="IFC" Click="OnExportIfc" ToolTip="Export the model as IFC4"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Pdf}"
                                        Content="PDF Set" Click="OnExportDrawingSetPdf" ToolTip="Every sheet to one PDF"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Print}"
                                        Content="Print" Click="OnPrintSheets" ToolTip="Ctrl+P"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ====================== MODIFY | CATEGORY ====================== -->
                <!-- Shown only while something is selected, holding what can be done to it. -->
                <TabItem x:Name="ContextTab" Header="Modify" Style="{StaticResource ContextRibbonTab}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl x:Name="ContextPropertiesPanel" Header="Properties" Style="{StaticResource ContextRibbonPanel}">
                            <Button x:Name="ContextEditType" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.EditType}"
                                    Content="Edit Type" Click="OnEditSelectedType"
                                    ToolTip="Change the type the selection is built from, or duplicate it"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Clipboard" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Margin="2,0,0,0">
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Copy}"
                                        Content="Copy" Click="OnCopy" ToolTip="Copy the selection (Ctrl+C)"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Paste}"
                                        Content="Paste" Click="OnPaste" ToolTip="Paste onto the current level (Ctrl+V)"/>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Paste}"
                                        Content="Paste in Place" Click="OnPasteInPlace" ToolTip="Paste where it came from (Ctrl+Shift+V)"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Modify" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ContextSplit" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Split}"
                                        Content="Split" Click="OnContextTool" CommandParameter="Split" ToolTip="Split a wall in two where you click (X)"/>
                                <Button x:Name="ContextTrim" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Trim}"
                                        Content="Trim / Extend" Click="OnContextTool" CommandParameter="Trim" ToolTip="Click a wall, then the wall to trim or extend it to (T)"/>
                                <Button x:Name="ContextOffset" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Offset}"
                                        Content="Offset" Click="OnContextTool" CommandParameter="Offset" ToolTip="Make a parallel copy of a wall a set distance away (O)"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Mirror}"
                                        Content="Mirror" Click="OnContextTool" CommandParameter="Mirror" ToolTip="Reflect the selection about a line (I)"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Array}"
                                        Content="Array" Click="OnContextTool" CommandParameter="Array" ToolTip="Repeat the selection at a regular spacing (Y)"/>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Delete}"
                                        Content="Delete" Command="Delete" ToolTip="Delete the selection (Del)"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextShapePanel" Header="Shape" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ContextAddPoint" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.AddPoint}"
                                              Content="Add Point" Click="OnAddWallPoint"
                                              ToolTip="Click on a wall to add a corner point, then drag the round grip to pull the wall straight to wherever you put it. Double-clicking the wall does the same; double-click a point to take it out"/>
                                <Button x:Name="ContextStraighten" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Straighten}"
                                        Content="Straighten" Click="OnStraightenWalls"
                                        ToolTip="Take every point and bend off the selected walls, back to a straight line between their ends"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextModePanel" Header="Mode" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Profile}"
                                        Content="Edit Profile" Click="OnEditProfile"
                                        ToolTip="Change the outline of the selected straight wall seen square-on"/>
                                <Button x:Name="ContextResetProfile" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.ResetProfile}"
                                        Content="Reset Profile" Click="OnResetProfile"
                                        ToolTip="Take the edited outline off the selected walls, back to the plain rectangle"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextWallPanel" Header="Modify Wall" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ContextCurtainGrid" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.CurtainGrid}"
                                        Content="Curtain Grid" Click="OnEditCurtainGrid"
                                        ToolTip="Add, move or delete the grid lines of the selected curtain wall"/>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachTop}"
                                            Content="Attach Top" Click="OnAttachTops"
                                            ToolTip="Take the selected walls up to the floor, ceiling or roof over each"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.AttachBase}"
                                            Content="Attach Base" Click="OnAttachBases"
                                            ToolTip="Stand the selected walls on the floor under each"/>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Detach}"
                                            Content="Detach Top/Base" Click="OnDetachWalls"
                                            ToolTip="Detach the tops and bases of the selected walls"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="ContextSweepPanel" Header="Profile" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ContextAddRemoveWalls" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.AddRemoveWalls}"
                                              Content="Add/Remove Walls" Click="OnAddRemoveSweepWalls"
                                              ToolTip="Click walls to carry the sweep on to them, or take it off them"/>
                                <ToggleButton x:Name="ContextModifyReturns" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Returns}"
                                              Content="Modify Returns" Click="OnModifySweepReturns"
                                              ToolTip="Click an end of the sweep to cut it straight or return it round the wall end"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <!-- ==================== MODIFY | PLACE WALL ==================== -->
                <!-- Shown while the Wall tool is on: how the walls are drawn, as Revit's contextual tab. -->
                <TabItem x:Name="PlaceWallTab" Header="Modify | Place Wall" Style="{StaticResource ContextRibbonTab}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Draw" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeLine" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawLine}"
                                                 Content="Line" CommandParameter="Line" ToolTip="One straight wall at a time, chained click to click"/>
                                    <RadioButton x:Name="ShapeArc" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawArc}"
                                                 Content="Arc" CommandParameter="Arc" ToolTip="Start, end, then a point the arc passes through"/>
                                    <RadioButton x:Name="ShapePick" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawPick}"
                                                 Content="Pick Lines" CommandParameter="Pick" ToolTip="Click a gridline to put a wall along it"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeRectangle" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawRectangle}"
                                                 Content="Rectangle" CommandParameter="Rectangle" ToolTip="Two opposite corners; Shift for a square"/>
                                    <RadioButton x:Name="ShapePolygon" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawPolygon}"
                                                 Content="Polygon" CommandParameter="Polygon" ToolTip="The centre, then a corner; sides on the option bar"/>
                                    <RadioButton x:Name="ShapeCircle" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawCircle}"
                                                 Content="Circle" CommandParameter="Circle" ToolTip="The centre, then a point on the circle"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeOval" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawOval}"
                                                 Content="Oval" CommandParameter="Oval" ToolTip="Two opposite corners of its box"/>
                                    <RadioButton x:Name="ShapeEllipse" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawEllipse}"
                                                 Content="Ellipse" CommandParameter="Ellipse" ToolTip="Two opposite corners of its box"/>
                                    <RadioButton x:Name="ShapePartialEllipse" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawHalfEllipse}"
                                                 Content="Partial Ellipse" CommandParameter="PartialEllipse" ToolTip="Both ends of an axis, then a point it passes through"/>
                                </StackPanel>
                                <StackPanel Margin="2,0">
                                    <RadioButton x:Name="ShapeSpline" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawSpline}"
                                                 Content="Spline" CommandParameter="Spline" ToolTip="Click points the wall curves through; Enter or a double click finishes"/>
                                    <RadioButton x:Name="ShapeFreehand" Style="{StaticResource WallShapeRadio}" Tag="{StaticResource Icon.DrawFreehand}"
                                                 Content="Freehand" CommandParameter="Freehand" ToolTip="Hold the mouse button and draw the wall"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Placement" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ShapeBySegment" Style="{StaticResource WallShapeLargeRadio}" Tag="{StaticResource Icon.PlaceBySegment}"
                                             Content="Place by Segment" CommandParameter="BySegment"
                                             ToolTip="Click beside a wall: a new wall runs along that face, on the side clicked"/>
                                <RadioButton x:Name="ShapeByRoom" Style="{StaticResource WallShapeLargeRadio}" Tag="{StaticResource Icon.PlaceByRoom}"
                                             Content="Place by Room" CommandParameter="ByRoom"
                                             ToolTip="Click inside a room: a new wall goes along every face round it"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Join" Style="{StaticResource ContextRibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="PlaceAutoJoin" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.AutoJoin}"
                                              Content="Auto Join" Click="OnPlaceWallJoinChanged"
                                              ToolTip="Join a new wall to the walls its faces lie against: their doors and windows cut through both"/>
                                <ToggleButton x:Name="PlaceLock" Style="{StaticResource RibbonToggle}" Tag="{StaticResource Icon.Lock}"
                                              Content="Lock" Click="OnPlaceWallJoinChanged"
                                              ToolTip="Auto Join and Lock: the joined walls also move together"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>


        <!-- =================== OPTIONS BAR (active tool) =================== -->
        <Border Grid.Row="2" Background="{StaticResource Bg.Elevated}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal">
                <!-- Selecting: says what is picked, as the contextual tab does. -->
                <TextBlock x:Name="ModifyCaption" Text="Modify" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,18,0" Visibility="Collapsed"/>
                <TextBlock x:Name="TypeLabel" Text="Wall type" Style="{StaticResource OptionLabel}"/>
                <ComboBox x:Name="WallTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveWallTypeChanged"
                          ToolTip="The assembly new walls are built from"/>

                <ComboBox x:Name="DoorTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveDoorTypeChanged"
                          Visibility="Collapsed" ToolTip="The type new doors are placed as"/>

                <ComboBox x:Name="WindowTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveWindowTypeChanged"
                          Visibility="Collapsed" ToolTip="The type new windows are placed as"/>

                <ComboBox x:Name="SlabTypePicker" Style="{StaticResource OptionCombo}" MinWidth="250"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveSlabTypeChanged"
                          Visibility="Collapsed" ToolTip="The build-up new slabs are placed as"/>

                <ComboBox x:Name="SweepTypePicker" Style="{StaticResource OptionCombo}" MinWidth="220"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveSweepTypeChanged"
                          Visibility="Collapsed" ToolTip="The sweep or reveal type to place"/>

                <TextBlock Text="Level" Style="{StaticResource OptionLabel}"/>
                <ComboBox x:Name="LevelPicker" Style="{StaticResource OptionCombo}" MinWidth="140"
                          DisplayMemberPath="Name" SelectionChanged="OnActiveLevelChanged"
                          ToolTip="The level new walls are hosted on"/>

                <TextBlock x:Name="LocationLineLabel" Text="Location line" Style="{StaticResource OptionLabel}"/>
                <ComboBox x:Name="LocationLinePicker" Style="{StaticResource OptionCombo}" MinWidth="175"
                          SelectionChanged="OnActiveLocationLineChanged"
                          ToolTip="Which line of the assembly you are drawing to"/>

                <WrapPanel x:Name="WallDrawOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="HeightModePicker" Style="{StaticResource OptionCombo}" MinWidth="80"
                              SelectedIndex="0" SelectionChanged="OnNewWallHeightChanged"
                              ToolTip="Height: the wall rises from its level. Depth: it hangs down from it, like a foundation wall.">
                        <ComboBoxItem Content="Height"/>
                        <ComboBoxItem Content="Depth"/>
                    </ComboBox>
                    <ComboBox x:Name="NewWallTopPicker" Style="{StaticResource OptionCombo}" MinWidth="170"
                              SelectionChanged="OnNewWallHeightChanged"
                              ToolTip="Up to a level, so the wall follows it, or unconnected at the height given"/>
                    <TextBox x:Name="NewWallHeightBox" Width="80" VerticalAlignment="Center" Text="3000 mm"
                             Margin="0,0,18,0" LostFocus="OnNewWallHeightChanged"
                             ToolTip="The unconnected height, or the depth below the level"/>
                    <TextBlock Text="Shape" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="WallShapePicker" Style="{StaticResource OptionCombo}" MinWidth="90"
                              SelectedIndex="0" SelectionChanged="OnWallShapeChanged"
                              ToolTip="One wall at a time, straight or arc, or a whole shape of walls placed with two clicks">
                        <ComboBoxItem Content="Line"/>
                        <ComboBoxItem Content="Arc"/>
                        <ComboBoxItem Content="Rectangle"/>
                        <ComboBoxItem Content="Polygon"/>
                        <ComboBoxItem Content="Circle"/>
                        <ComboBoxItem Content="Oval"/>
                        <ComboBoxItem Content="Ellipse"/>
                        <ComboBoxItem Content="Partial ellipse"/>
                        <ComboBoxItem Content="Pick lines"/>
                        <ComboBoxItem Content="Spline"/>
                        <ComboBoxItem Content="Freehand"/>
                        <ComboBoxItem Content="By segment"/>
                        <ComboBoxItem Content="By room"/>
                    </ComboBox>
                    <StackPanel x:Name="PolygonOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Sides" Style="{StaticResource OptionLabel}"/>
                        <TextBox x:Name="PolygonSidesBox" Width="44" VerticalAlignment="Center" Text="6"
                                 Margin="0,0,12,0" LostFocus="OnPolygonSidesChanged"
                                 ToolTip="3 for a triangle, up to 32"/>
                        <CheckBox x:Name="PolygonInscribedBox" Content="Click a corner" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,18,0" Click="OnPolygonInscribedChanged"
                                  ToolTip="On: the second click is a corner. Off: it is the middle of a side."/>
                    </StackPanel>
                    <TextBlock Text="Offset" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="WallOffsetBox" Width="90" VerticalAlignment="Center"
                             Text="0 mm" LostFocus="OnWallOffsetChanged" KeyDown="OnWallOffsetKeyDown"
                             ToolTip="Build the wall this far off the line you click, toward its exterior. Negative goes the other way."/>
                    <CheckBox x:Name="AutoJoinBox" Content="Auto Join" VerticalAlignment="Center" Margin="4,0,10,0"
                              Click="OnAutoJoinChanged"
                              ToolTip="Join a new wall to the walls its faces lie against: their doors and windows cut through both"/>
                    <CheckBox x:Name="LockJoinBox" Content="Lock" VerticalAlignment="Center" Margin="0,0,14,0"
                              Click="OnLockJoinChanged"
                              ToolTip="Auto Join and Lock: the joined walls also move together"/>
                    <TextBlock Text="Space flips" Style="{StaticResource OptionLabel}" Opacity="0.6"/>
                </WrapPanel>

                <!-- Editing tool settings, shown only while their tool is active. -->
                <StackPanel x:Name="SweepOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Placement" Style="{StaticResource OptionLabel}"/>
                    <ComboBox x:Name="SweepPlacementPicker" Style="{StaticResource OptionCombo}" MinWidth="110"
                              SelectedIndex="0" SelectionChanged="OnSweepPlacementChanged"
                              ToolTip="Horizontal runs along the wall at a height; vertical stands full height where you click">
                        <ComboBoxItem Content="Horizontal"/>
                        <ComboBoxItem Content="Vertical"/>
                    </ComboBox>
                    <TextBlock x:Name="SweepHeightLabel" Text="Offset from base" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="SweepHeightBox" Width="80" VerticalAlignment="Center" Text="0 mm"
                             LostFocus="OnSweepHeightChanged" ToolTip="How high above the wall's base, e.g. 0 for a skirting, 900 for a dado rail"/>
                </StackPanel>

                <!-- Modify Returns: what a click on a sweep's end turns it into. -->
                <StackPanel x:Name="SweepReturnOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <RadioButton x:Name="StraightCutChoice" Content="Straight Cut" GroupName="SweepReturn" VerticalAlignment="Center"
                                 Margin="4,0,12,0" Click="OnSweepReturnChoiceChanged"
                                 ToolTip="The clicked end stops square at the wall end"/>
                    <RadioButton x:Name="ReturnChoice" Content="Return" GroupName="SweepReturn" VerticalAlignment="Center" IsChecked="True"
                                 Click="OnSweepReturnChoiceChanged"
                                 ToolTip="The clicked end turns 90 degrees round the wall end back to the wall face"/>
                </StackPanel>

                <StackPanel x:Name="OffsetOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Distance" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="OffsetDistanceBox" Width="90" VerticalAlignment="Center"
                             Text="1000 mm" LostFocus="OnOffsetDistanceChanged"
                             ToolTip="How far away the parallel copy goes, e.g. 1500, 1.5 m"/>
                </StackPanel>

                <StackPanel x:Name="MirrorOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <CheckBox x:Name="MirrorKeepOriginalBox" Content="Keep originals" IsChecked="True"
                              VerticalAlignment="Center" Click="OnMirrorKeepOriginalChanged"
                              ToolTip="Mirror copies and leave the selection where it is"/>
                </StackPanel>

                <StackPanel x:Name="ArrayOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Count" Style="{StaticResource OptionLabel}"/>
                    <TextBox x:Name="ArrayCountBox" Width="60" VerticalAlignment="Center"
                             Text="3" LostFocus="OnArrayCountChanged"
                             ToolTip="How many in total, including the original"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ========================= WORKSPACE ========================= -->
        <!--
            Palettes docked on the left - properties over the project browser - and the views
            filling the rest, as desktop BIM tools lay themselves out.
        -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="140"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="2*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Properties, generated from the selected element's own parameters -->
                <Border Grid.Row="0" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaletteTitle}">
                            <TextBlock Text="Properties" FontWeight="SemiBold"/>
                        </Border>

                    <TextBlock x:Name="NoSelectionHint" DockPanel.Dock="Top" Margin="14,0,14,14" Visibility="Collapsed"
                               TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Text.Muted}"
                               Text="Nothing selected."/>

                    <ScrollViewer x:Name="PropertyScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- The type selector: a picture of what it is, its family and type, and the list of types. -->
                            <Border Background="{StaticResource Bg.Elevated}" Padding="10,10,10,8"
                                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Width="50" Height="50" Background="{StaticResource Bg.Field}" CornerRadius="3"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <Image x:Name="SelectedTypeImage" Width="34" Height="34"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedFamilyName" Foreground="{StaticResource Text.Muted}"
                                                   FontSize="{StaticResource UiFontSizeSmall}"/>
                                        <TextBlock x:Name="SelectedTypeName" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <ComboBox x:Name="SelectedTypePicker" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                              DisplayMemberPath="Name" SelectionChanged="OnSelectedTypeChanged"
                                              ToolTip="Change the type of the selection. Every element of a type shares its type properties."/>
                                </Grid>
                            </Border>

                            <!-- Which of the selection these properties are for, and its type's own editor. -->
                            <Border Padding="8,6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PropertyCategoryPicker" SelectionChanged="OnPropertyCategoryChanged"
                                              ToolTip="Which of the selected elements these properties are for"/>
                                    <Button x:Name="EditTypeButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,3"
                                            Click="OnEditSelectedType"
                                            ToolTip="Edit the type: its layers, or its type properties, or duplicate it to make a new one">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource Icon.EditType}" Width="14" Height="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Edit Type" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- This element's own parameters, in folding groups. -->
                            <ItemsControl x:Name="InstanceParameterList" Style="{StaticResource ParameterList}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource PaletteGroup}"/>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>

                            <!-- The type's parameters: shared by every element of it. -->
                            <StackPanel x:Name="TypeSection">
                                <Border Style="{StaticResource PaletteSectionBand}">
                                    <StackPanel>
                                        <TextBlock Text="Type Properties" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TypeHint" TextWrapping="Wrap" FontSize="{StaticResource UiFontSizeSmall}"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="TypeParameterList" Style="{StaticResource ParameterList}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource PaletteGroup}"/>
                                    </ItemsControl.GroupStyle>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The assembly the type is built from. Walls and slabs. -->
                            <StackPanel x:Name="StructureSection" Margin="0,0,0,16">
                                <Border Style="{StaticResource PaletteSectionBand}">
                                    <StackPanel>
                                        <TextBlock Text="Structure" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StructureHint" FontSize="{StaticResource UiFontSizeSmall}"
                                                   Foreground="{StaticResource Text.Muted}" Text="Exterior face to interior face."/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="LayerList" Margin="10,4,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="9" RadiusX="2" RadiusY="2"
                                                           Margin="0,3,10,3" Fill="{Binding Swatch}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MaterialName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding MaterialName}"/>
                                                    <TextBlock Text="{Binding FunctionName}"
                                                               FontSize="{StaticResource UiFontSizeSmall}"
                                                               Foreground="{StaticResource Text.Muted}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Thickness}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource Line}" ResizeDirection="Rows"/>

                <!-- Project browser -->
                <Border Grid.Row="2" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaletteTitle}">
                            <TextBlock Text="Project Browser" FontWeight="SemiBold"/>
                        </Border>
                        <TreeView x:Name="ProjectBrowser" Margin="4,4,4,8"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Line}" ResizeBehavior="PreviousAndNext"/>

            <!--
                The views. The plan, with the section under it and a sheet over it, fills the
                first column; the 3D view either covers it or, tiled, takes a column of its own.
            -->
            <Grid x:Name="ViewArea" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition x:Name="TileSplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="TileColumn" Width="0"/>
                </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 2D plan view: drawn in C#, not composed from XAML controls -->
                <Border Grid.Row="0" Background="{StaticResource Bg.Field}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ViewTitle}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource Icon.Plan}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PlanTitle" Text="Floor Plan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- The view control bar: how this plan is drawn and what it is placed on a sheet at. -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ViewControlBar}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="PlanScalePicker" Style="{StaticResource ViewControlCombo}" MinWidth="78"
                                          SelectionChanged="OnPlanScaleChanged"
                                          ToolTip="View scale: what this plan is placed on a sheet at"/>
                                <Image Source="{StaticResource Icon.Detail}" Width="14" Height="14" Margin="0,0,4,0" ToolTip="Detail level"/>
                                <ComboBox x:Name="PlanDetailPicker" Style="{StaticResource ViewControlCombo}" MinWidth="78"
                                          SelectionChanged="OnPlanDetailChanged"
                                          ToolTip="Detail level: coarse draws walls as outlines, fine shows every layer">
                                    <ComboBoxItem Content="Coarse"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Fine"/>
                                </ComboBox>
                                <ToggleButton x:Name="PlanUnderlayToggle" Style="{StaticResource ViewControlToggle}" IsChecked="True"
                                              Content="Storey Below" Click="OnPlanUnderlayToggled"
                                              ToolTip="Show the storey below faintly under the plan"/>
                                <Button Style="{StaticResource ViewControlButton}" Content="Zoom to Fit" Click="OnPlanZoomToFit"
                                        ToolTip="Frame the whole plan (F)"/>
                            </StackPanel>
                        </Border>
                        <controls:PlanView x:Name="Plan"/>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="SectionSplitter" Grid.Row="1" Height="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{StaticResource Line}" ResizeDirection="Rows"
                              Visibility="Collapsed"/>

                <Border x:Name="SectionPanel" Grid.Row="2" Height="300" Visibility="Collapsed"
                        Background="{StaticResource Bg.Field}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,7" Background="{StaticResource Bg.Elevated}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBlock Text="Section" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox x:Name="SectionPicker" Style="{StaticResource OptionCombo}"
                                              MinWidth="180" SelectionChanged="OnActiveSectionChanged"
                                              ToolTip="Which section marker this view cuts along"/>
                                    <TextBlock x:Name="SectionSummary" VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Flip" Padding="12,5" Margin="0,0,8,0"
                                            Click="OnFlipSection"
                                            ToolTip="Look the other way along the cut"/>
                                    <Button Content="Zoom to Fit" Padding="12,5" Margin="0,0,8,0"
                                            Click="OnZoomSectionToFit"/>
                                    <Button Content="Close" Padding="12,5" Click="OnCloseSection"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:SectionView x:Name="Section"/>
                    </DockPanel>
                </Border>

                <!--
                    A sheet covers the whole drawing area rather than sharing it. A sheet is
                    a different thing to be looking at, not another panel of the model: you
                    are looking at the drawing set, and it needs the room.
                -->
                <Border x:Name="SheetPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                        Background="{StaticResource Bg.Field}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,7" Background="{StaticResource Bg.Elevated}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <!--
                                Two columns, not two StackPanels sharing one cell. Overlapping
                                panels look fine on a wide window and silently stack the right
                                buttons on top of the left ones when it narrows - which hides
                                a button behind another button that still takes the click.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sheet" Style="{StaticResource OptionLabel}"/>
                                        <ComboBox x:Name="SheetPicker" Style="{StaticResource OptionCombo}"
                                                  MinWidth="185" SelectionChanged="OnActiveSheetChanged"
                                                  ToolTip="Which sheet of the drawing set is open"/>

                                        <TextBlock Text="Place" Style="{StaticResource OptionLabel}"/>
                                        <ComboBox x:Name="SheetViewPicker" Style="{StaticResource OptionCombo}"
                                                  MinWidth="160" Margin="0,0,8,0" DisplayMemberPath="Display"
                                                  ToolTip="A view from the project to drop onto this sheet"/>
                                        <Button Content="Add" Padding="14,5" Margin="0,0,18,0"
                                                Click="OnPlaceViewOnSheet"
                                                ToolTip="Place the chosen view on this sheet"/>

                                        <TextBlock Text="Scale" Style="{StaticResource OptionLabel}"/>
                                        <ComboBox x:Name="ViewportScalePicker" Style="{StaticResource OptionCombo}"
                                                  MinWidth="90" IsEnabled="False"
                                                  SelectionChanged="OnViewportScaleChanged"
                                                  ToolTip="The scale the selected view is drawn at"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Export PDF" Padding="12,5" Margin="0,0,8,0"
                                            Click="OnExportSheetPdf"
                                            ToolTip="Write this sheet out as a PDF"/>
                                    <Button x:Name="RemoveViewportButton" Content="Remove View" Padding="12,5"
                                            Margin="0,0,8,0" IsEnabled="False" Click="OnRemoveViewport"/>
                                    <Button Content="Zoom to Fit" Padding="12,5" Margin="0,0,8,0"
                                            Click="OnZoomSheetToFit"/>
                                    <Button Content="Close" Padding="12,5" Click="OnCloseSheet"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:SheetView x:Name="SheetSurface"/>
                    </DockPanel>
                </Border>

            </Grid>

                <GridSplitter x:Name="TileSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{StaticResource Line}" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>

                <Border x:Name="ModelPanel" Grid.Column="0" Panel.ZIndex="2" Visibility="Collapsed"
                        Background="{StaticResource Bg.Field}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,7" Background="{StaticResource Bg.Elevated}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Show" Style="{StaticResource OptionLabel}"/>
                                        <CheckBox x:Name="ShowRoofsBox" Content="Roofs" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Lift the roofs off to look inside"/>
                                        <CheckBox x:Name="ShowCeilingsBox" Content="Ceilings" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"/>
                                        <CheckBox x:Name="ShowFloorsBox" Content="Floors" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"/>
                                        <CheckBox x:Name="ShowGroundBox" Content="Ground" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Hide the ground to see what is below ground level"/>
                                        <CheckBox x:Name="ShowEdgesBox" Content="Edges" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,22,0"
                                                  Click="OnModelCategoryToggled"
                                                  ToolTip="Draw the model's edges over the shading"/>

                                        <TextBlock Text="Storeys" Style="{StaticResource OptionLabel}"/>
                                        <ItemsControl x:Name="StoreyToggles" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Close" Padding="12,5" Click="OnClose3D"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- The view control bar: how this view is drawn, as under every Revit view. -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ViewControlBar}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="3D View" Style="{StaticResource ViewControlCaption}"/>
                                    <Image Source="{StaticResource Icon.View3D}" Width="14" Height="14" Margin="0,0,4,0"
                                           ToolTip="Visual style"/>
                                    <ComboBox x:Name="VisualStylePicker" Style="{StaticResource ViewControlCombo}"
                                              MinWidth="110" SelectionChanged="OnVisualStyleChanged"
                                              ToolTip="Visual style: shaded, flat colours, or see-through"/>
                                    <Button Style="{StaticResource ViewControlButton}" Content="Zoom to Fit" Click="OnZoom3DToFit"
                                            ToolTip="Frame the whole model (F)"/>
                                    <Button Style="{StaticResource ViewControlButton}" Content="Reset" Click="OnReset3DView"
                                            ToolTip="Back to the three-quarter view (Home)"/>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                           Text="Drag to orbit  ·  right-drag to pan  ·  scroll to zoom  ·  click to select"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <controls:ModelView x:Name="Model3D"/>

                            <!-- The ViewCube and navigation bar, top right, as in Revit. -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                                <controls:ViewCube x:Name="Cube"/>
                                <Border Style="{StaticResource NavigationBar}">
                                    <StackPanel>
                                        <Button Style="{StaticResource NavigationButton}" Click="OnZoom3DToFit" ToolTip="Zoom to fit (F)"
                                                AutomationProperties.Name="Zoom to Fit">
                                            <Path Data="M1,5 L1,1 L5,1 M11,1 L15,1 L15,5 M15,11 L15,15 L11,15 M5,15 L1,15 L1,11 M5,5 L11,5 L11,11 L5,11 Z"/>
                                        </Button>
                                        <Button Style="{StaticResource NavigationButton}" Click="OnZoom3DIn" ToolTip="Zoom in"
                                                AutomationProperties.Name="Zoom In">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8"/>
                                        </Button>
                                        <Button Style="{StaticResource NavigationButton}" Click="OnZoom3DOut" ToolTip="Zoom out"
                                                AutomationProperties.Name="Zoom Out">
                                            <Path Data="M2,8 L14,8"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>


        <!-- ======================== SCHEDULE VIEW ======================== -->
        <GridSplitter x:Name="ScheduleSplitter" Grid.Row="4" Height="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{StaticResource Line}" ResizeDirection="Rows"
                      Visibility="Collapsed"/>

        <Border x:Name="SchedulePanel" Grid.Row="5" Height="280" Visibility="Collapsed"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,8" Background="{StaticResource Bg.Elevated}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                            <TextBlock Text="Schedule" Style="{StaticResource OptionLabel}"/>
                            <ComboBox x:Name="SchedulePicker" Style="{StaticResource OptionCombo}"
                                      MinWidth="220" SelectionChanged="OnScheduleChanged"/>
                            <TextBlock x:Name="ScheduleSummary" VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Muted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ExportCsvButton" Content="Export CSV..." Padding="12,5"
                                    Margin="0,0,8,0" Click="OnExportSchedule"/>
                            <Button Content="Close" Padding="12,5" Click="OnCloseSchedule"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12,7"
                        Background="{StaticResource Bg.Elevated}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="ScheduleTotals" Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <DataGrid x:Name="ScheduleGrid" CellEditEnding="OnScheduleCellEdited"
                          SelectionChanged="OnScheduleSelectionChanged"
                          PreviewKeyDown="OnScheduleKeyDown">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg.Elevated}" Padding="10,5" Margin="0,4,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" — " Foreground="{StaticResource Text.Muted}"/>
                                            <Run Text="{Binding ItemCount, Mode=OneWay}"
                                                 Foreground="{StaticResource Text.Muted}"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ========================= STATUS BAR ========================= -->
        <Border Grid.Row="6" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusX" Text="X: 0 mm" MinWidth="96" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusY" Text="Y: 0 mm" MinWidth="96" Style="{StaticResource StatusText}"/>
                    <TextBlock Text="Grid: 100 mm" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusZoom" Text="Zoom 100%" MinWidth="86" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusDetail" Text="Detail: Fine" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StatusSaved" Text="Unsaved project" Style="{StaticResource StatusText}"/>
                </StackPanel>

                <TextBlock x:Name="StatusHint" Grid.Column="2" Text="Ready"
                           Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
