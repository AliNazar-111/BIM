<Window x:Class="BIMDesigner.UI.EditCurtainGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BIMDesigner.UI.Controls"
        Title="Edit Curtain Grid" Height="640" Width="1040" MinHeight="480" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,10,16,14"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#E8806A"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="OK" Padding="22,5" Margin="0,0,8,0" IsDefault="True" Click="OnOk"
                            ToolTip="Give the wall this grid and these panels"/>
                    <Button Content="Cancel" Padding="18,5" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock x:Name="WallCaption" DockPanel.Dock="Top" Text="ELEVATION" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Bg.Panel}">
                    <controls:CurtainGridEditor x:Name="Editor"/>
                </Border>
            </DockPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="CLICK A PANEL TO MAKE IT" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <RadioButton x:Name="GlazedChoice" Content="Glass" IsChecked="True" Margin="0,0,0,6" Checked="OnFillChanged"/>
                <RadioButton x:Name="SolidChoice" Content="Solid panel" Margin="0,0,0,6" Checked="OnFillChanged"/>
                <RadioButton x:Name="EmptyChoice" Content="Empty" Margin="0,0,0,6" Checked="OnFillChanged"/>
                <RadioButton x:Name="DoorChoice" Content="Door (bottom panels)" Margin="0,0,0,16" Checked="OnFillChanged"/>

                <TextBlock Text="ADD A GRID LINE" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="VerticalAtBox" Padding="6,3" MinHeight="28" VerticalContentAlignment="Center"
                             ToolTip="How far along the wall, such as 2400 or 2.4 m"/>
                    <Button Grid.Column="2" Content="Vertical" Padding="12,4" Click="OnAddVertical"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HorizontalAtBox" Padding="6,3" MinHeight="28" VerticalContentAlignment="Center"
                             ToolTip="How high above the base, such as 2100 or 2.1 m"/>
                    <Button Grid.Column="2" Content="Horizontal" Padding="12,4" Click="OnAddHorizontal"/>
                </Grid>
                <Button Content="Delete Selected Line" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,16" Click="OnDeleteLine"/>

                <TextBlock Text="START AGAIN" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <Button Content="Follow the Type" Padding="12,5" HorizontalAlignment="Left" Click="OnFollowType"
                        ToolTip="Put back the grid the wall type sets out, with every panel glass"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
