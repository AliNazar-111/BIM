<Window x:Class="BIMDesigner.UI.FamilyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BIMDesigner.UI.Controls"
        Title="Family Editor" Height="700" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <!-- The family: its name and category, how it is put in, and the size of its box. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="NAME" Style="{StaticResource Caption}"/>
                <TextBox x:Name="NameBox" Width="230" Padding="4,1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Text="CATEGORY" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="CategoryPicker" Width="170" Margin="0,0,16,0" SelectionChanged="OnFamilyChoiceChanged"/>
                <TextBlock Text="PLACED" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="PlacementPicker" Width="150" Margin="0,0,16,0" SelectionChanged="OnFamilyChoiceChanged"
                          ToolTip="Freestanding stands on the floor; face-based is fixed to a wall or a ceiling; work-plane-based may be either"/>
                <CheckBox x:Name="AgainstWallBox" Content="Backs onto a wall" VerticalAlignment="Center" Click="OnFamilyChoiceChanged"
                          ToolTip="Put down near a wall, it backs onto it and faces the room"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="SIZE" Style="{StaticResource Caption}"
                           ToolTip="The family's box: what it takes up in plan and how high it is. Its solids and model stretch with it"/>
                <TextBlock Text="Width" Style="{StaticResource Caption}"/>
                <TextBox x:Name="WidthBox" Style="{StaticResource Field}" LostFocus="OnSizeCommitted" KeyDown="OnFieldKey"/>
                <TextBlock Text="Depth" Style="{StaticResource Caption}"/>
                <TextBox x:Name="DepthBox" Style="{StaticResource Field}" LostFocus="OnSizeCommitted" KeyDown="OnFieldKey"/>
                <TextBlock Text="Height" Style="{StaticResource Caption}"/>
                <TextBox x:Name="HeightBox" Style="{StaticResource Field}" LostFocus="OnSizeCommitted" KeyDown="OnFieldKey"/>
                <Button Content="Fit to Solids" Padding="10,2" Click="OnFitSize"
                        ToolTip="Make the box snug round its solids and model, nothing moving"/>
                <TextBlock x:Name="SizeHint" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Muted}"
                           Text="Changing the size stretches what it is drawn with."/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Note" TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}" Margin="0,0,200,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Padding="24,5" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
                <Button Content="Cancel" Padding="18,5" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- What it is drawn with: its solids, and a 3D model. -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="3D MODEL" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ModelText" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource Text.Muted}" Text="None loaded."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Drawn in" Style="{StaticResource Caption}"/>
                        <ComboBox x:Name="UnitsPicker" Width="130"
                                  ToolTip="The units the model was drawn in. Auto guesses from its size, as a piece of furniture would be"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="Load Model..." Style="{StaticResource Small}" Click="OnLoadModel"
                                ToolTip="An OBJ or STL file: its shape, in the family's colour or material"/>
                        <Button x:Name="StandUpButton" Content="Stand Up" Style="{StaticResource Small}" Click="OnStandUp"
                                ToolTip="Turn it a quarter about its width: for a model that came in lying on its back"/>
                        <Button x:Name="TurnButton" Content="Turn Round" Style="{StaticResource Small}" Click="OnTurnRound"
                                ToolTip="Turn it a quarter about the vertical: for one facing the wrong way"/>
                        <Button x:Name="RemoveModelButton" Content="Remove" Style="{StaticResource Small}" Click="OnRemoveModel"/>
                    </WrapPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="SOLIDS" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button Content="+ Box" Style="{StaticResource Small}" Tag="Box" Click="OnAddSolid"/>
                    <Button Content="+ Cylinder" Style="{StaticResource Small}" Tag="Cylinder" Click="OnAddSolid"/>
                    <Button Content="+ Disc" Style="{StaticResource Small}" Tag="Disc" Click="OnAddSolid" ToolTip="A cylinder lying front to back: a wheel, a dial"/>
                    <Button Content="+ Sphere" Style="{StaticResource Small}" Tag="Sphere" Click="OnAddSolid"/>
                    <Button Content="+ Cone" Style="{StaticResource Small}" Tag="Cone" Click="OnAddSolid"/>
                    <Button Content="+ Wedge" Style="{StaticResource Small}" Tag="Wedge" Click="OnAddSolid" ToolTip="Full height at the back, sloping down to the front"/>
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="DuplicateSolidButton" Content="Duplicate" Style="{StaticResource Small}" Click="OnDuplicateSolid"/>
                    <Button x:Name="DeleteSolidButton" Content="Delete" Style="{StaticResource Small}" Click="OnDeleteSolid"/>
                </WrapPanel>
                <ListBox x:Name="SolidList" SelectionChanged="OnSolidPicked" Background="{StaticResource Bg.Panel}"
                         BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}"/>
            </DockPanel>

            <!-- How it looks: click a solid here to pick it. -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="3D" Style="{StaticResource Small}" Tag="3D" Click="OnLook"/>
                    <Button Content="Front" Style="{StaticResource Small}" Tag="Front" Click="OnLook"/>
                    <Button Content="Side" Style="{StaticResource Small}" Tag="Side" Click="OnLook"/>
                    <Button Content="Top" Style="{StaticResource Small}" Tag="Top" Click="OnLook"/>
                    <Button Content="Zoom to Fit" Style="{StaticResource Small}" Click="OnFit"/>
                    <TextBlock Text="Click a solid to pick it. Drag to turn the view." VerticalAlignment="Center" Margin="8,0,0,6"
                               Foreground="{StaticResource Text.Muted}"/>
                </StackPanel>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <controls:ModelView x:Name="Preview"/>
                </Border>
            </DockPanel>

            <!-- The solid picked: its shape and finish, where it is and how big. -->
            <StackPanel x:Name="SolidPanel" Grid.Column="4">
                <TextBlock Text="SOLID" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="SolidNameBox" Grid.Column="1" Padding="4,1" VerticalAlignment="Center" LostFocus="OnSolidCommitted" KeyDown="OnFieldKey"/>
                    <TextBlock Grid.Row="1" Text="Shape" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="ShapePicker" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnSolidChoiceChanged"/>
                    <TextBlock Grid.Row="2" Text="Finish" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="FinishPicker" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnSolidChoiceChanged"
                              ToolTip="Its family's own colour or material, or a fixed finish: white, black, stainless steel, glass, bark, skin"/>

                    <TextBlock Grid.Row="4" Text="Across" Style="{StaticResource Caption}" ToolTip="Its middle, left (-) or right (+) of the family's middle, as it faces you"/>
                    <TextBox x:Name="AcrossBox" Grid.Row="4" Grid.Column="1" Padding="4,1" VerticalAlignment="Center" LostFocus="OnSolidCommitted" KeyDown="OnFieldKey"/>
                    <TextBlock Grid.Row="5" Text="Forward" Style="{StaticResource Caption}" ToolTip="Its middle, toward the front (+) or the back (-) of the family's middle"/>
                    <TextBox x:Name="ForwardBox" Grid.Row="5" Grid.Column="1" Padding="4,1" VerticalAlignment="Center" LostFocus="OnSolidCommitted" KeyDown="OnFieldKey"/>
                    <TextBlock Grid.Row="6" Text="Bottom" Style="{StaticResource Caption}" ToolTip="How high its underside is, above the family's base"/>
                    <TextBox x:Name="BottomBox" Grid.Row="6" Grid.Column="1" Padding="4,1" VerticalAlignment="Center" LostFocus="OnSolidCommitted" KeyDown="OnFieldKey"/>

                    <TextBlock Grid.Row="8" Text="Width" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="SolidWidthBox" Grid.Row="8" Grid.Column="1" Padding="4,1" VerticalAlignment="Center" LostFocus="OnSolidCommitted" KeyDown="OnFieldKey"/>
                    <TextBlock Grid.Row="9" Text="Depth" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="SolidDepthBox" Grid.Row="9" Grid.Column="1" Padding="4,1" VerticalAlignment="Center" LostFocus="OnSolidCommitted" KeyDown="OnFieldKey"/>
                    <TextBlock Grid.Row="10" Text="Height" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="SolidHeightBox" Grid.Row="10" Grid.Column="1" Padding="4,1" VerticalAlignment="Center" LostFocus="OnSolidCommitted" KeyDown="OnFieldKey"/>
                </Grid>
                <TextBlock x:Name="SolidHint" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource Text.Muted}"
                           Text="In millimetres, in the family's own frame: its front toward you."/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
