<Window x:Class="BIMDesigner.UI.TypePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BIMDesigner.UI.ViewModels"
        Title="Type Properties" Height="680" Width="540" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One parameter: its name on the left, the editor it asks for on the right - as in Properties. -->
        <DataTemplate x:Key="ParameterRowTemplate" DataType="{x:Type vm:ParameterRow}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="55*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,0,6,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Text, Mode=OneWay}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="6,0" Foreground="{StaticResource Text.Muted}"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center" Margin="2,1" Padding="4,1" MinHeight="22"
                             Visibility="{Binding IsEditableText, Converter={StaticResource BoolToVisibility}}"/>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding SelectedChoice}" VerticalAlignment="Center" Margin="2,1" Padding="6,1" MinHeight="22"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"/>

                    <CheckBox Grid.Column="1" IsChecked="{Binding Flag}" VerticalAlignment="Center" Margin="6,0"
                              Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16,14,16,14">
        <!-- Which family, and which of its types: Duplicate makes one of your own from it. -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="FAMILY" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="FamilyText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="TYPE" Style="{StaticResource Caption}"/>
            <ComboBox x:Name="TypePicker" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnTypePicked"
                      ToolTip="The type to edit - and, with something selected, the type it is given"/>

            <WrapPanel Grid.Row="4" Grid.Column="1">
                <Button Content="Duplicate..." Padding="12,5" Margin="0,0,8,0" Click="OnDuplicate"
                        ToolTip="A new type starting as this one is, given to what is selected - change its size or material without touching the others"/>
                <Button Content="Rename..." Padding="12,5" Margin="0,0,8,0" Click="OnRename"/>
                <Button x:Name="DeleteButton" Content="Delete" Padding="12,5" Margin="0,0,8,0" Click="OnDelete"
                        ToolTip="Only a type nothing is placed from can be deleted"/>
                <Button x:Name="EditFamilyButton" Content="Edit Family..." Padding="12,5" Click="OnEditFamily" Visibility="Collapsed"
                        ToolTip="Draw it from simple solids, or load a 3D model into it, in the family editor"/>
            </WrapPanel>
        </Grid>

        <TextBlock x:Name="Hint" DockPanel.Dock="Top" Margin="0,12,0,8" TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Padding="20,5" IsCancel="True" IsDefault="True" Click="OnClose"/>
        </StackPanel>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Bg.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Parameters" ItemTemplate="{StaticResource ParameterRowTemplate}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
