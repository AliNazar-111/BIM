<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The light palette: the same names as Palette.xaml, in the pale greys and white
        drawing areas of a desktop CAD application. Swapped in for the dark one at start-up
        when the light theme is chosen; nothing else in the application changes.
    -->

    <!-- Surfaces: the drawing area white, panels a little greyer, the window greyer still -->
    <Color x:Key="Colour.Field">#FFFFFFFF</Color>
    <Color x:Key="Colour.Window">#FFE9EAEC</Color>
    <Color x:Key="Colour.Panel">#FFF5F6F7</Color>
    <Color x:Key="Colour.Elevated">#FFFFFFFF</Color>
    <Color x:Key="Colour.Hover">#FFE1EEF8</Color>

    <!-- Lines -->
    <Color x:Key="Colour.Line">#FFD2D5DA</Color>
    <Color x:Key="Colour.LineStrong">#FFB4B9C1</Color>

    <!-- Text -->
    <Color x:Key="Colour.Text">#FF1F2328</Color>
    <Color x:Key="Colour.TextMuted">#FF5B6470</Color>
    <Color x:Key="Colour.TextDisabled">#FF9AA2AD</Color>

    <!-- Accent -->
    <Color x:Key="Colour.Accent">#FF0B6FC2</Color>
    <Color x:Key="Colour.AccentDim">#FFCDE4F7</Color>

    <SolidColorBrush x:Key="Bg.Field" Color="{StaticResource Colour.Field}"/>
    <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Colour.Window}"/>
    <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource Colour.Panel}"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="{StaticResource Colour.Elevated}"/>
    <SolidColorBrush x:Key="Bg.Hover" Color="{StaticResource Colour.Hover}"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="{StaticResource Colour.AccentDim}"/>

    <SolidColorBrush x:Key="Line" Color="{StaticResource Colour.Line}"/>
    <SolidColorBrush x:Key="Line.Strong" Color="{StaticResource Colour.LineStrong}"/>

    <SolidColorBrush x:Key="Text" Color="{StaticResource Colour.Text}"/>
    <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Colour.TextMuted}"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="{StaticResource Colour.TextDisabled}"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource Colour.Accent}"/>
    <SolidColorBrush x:Key="Accent.Dim" Color="{StaticResource Colour.AccentDim}"/>

    <SolidColorBrush x:Key="Thumb" Color="#FFC4C9D0"/>
    <SolidColorBrush x:Key="Thumb.Hover" Color="#FFA4ABB5"/>

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="UiFontSize">12.5</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="UiFontSizeSmall">11</system:Double>

</ResourceDictionary>
