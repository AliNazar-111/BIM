<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The ribbon: tabs of panels, each panel a row of large buttons with an icon over a
        label and the panel's name underneath, the way desktop CAD applications lay out their
        tools. The icon of a button is its Tag; its label is its Content.
    -->

    <!-- The chrome shared by every large ribbon button: highlighted on hover, filled when on. -->
    <ControlTemplate x:Key="RibbonLargeTemplate" TargetType="ButtonBase">
        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="2" Padding="{TemplateBinding Padding}">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="{TemplateBinding Tag}" Width="32" Height="32" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="70" Margin="0,3,0,0" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                           Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line.Strong}"/>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RibbonTool" TargetType="RadioButton">
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="GroupName" Value="Tools"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template" Value="{StaticResource RibbonLargeTemplate}"/>
    </Style>

    <Style x:Key="RibbonButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template" Value="{StaticResource RibbonLargeTemplate}"/>
    </Style>

    <Style x:Key="RibbonToggle" TargetType="ToggleButton">
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template" Value="{StaticResource RibbonLargeTemplate}"/>
    </Style>

    <!-- Small ribbon buttons: a little icon and a label side by side, stacked three high. -->
    <ControlTemplate x:Key="RibbonSmallTemplate" TargetType="ButtonBase">
        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="2" Padding="4,1,8,1">
            <StackPanel Orientation="Horizontal">
                <Image Source="{TemplateBinding Tag}" Width="16" Height="16" Margin="0,0,5,0"/>
                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line.Strong}"/>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent.Dim}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RibbonSmallButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template" Value="{StaticResource RibbonSmallTemplate}"/>
    </Style>

    <Style x:Key="RibbonSmallToggle" TargetType="ToggleButton">
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template" Value="{StaticResource RibbonSmallTemplate}"/>
    </Style>

    <Style x:Key="RibbonSmallRadio" TargetType="RadioButton">
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template" Value="{StaticResource RibbonSmallTemplate}"/>
    </Style>

    <!-- A panel: its buttons, its name along the bottom, a rule on its right. -->
    <Style x:Key="RibbonPanel" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="4,4,4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Header}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource Text.Muted}" Margin="0,2,0,3"
                                       FontSize="{StaticResource UiFontSizeSmall}"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tab strip over the panels. -->
    <Style x:Key="RibbonTabs" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Window}">
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,-1"/>
                        </Border>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,0,1" Height="96">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1,1,1,0" Padding="13,4,13,5">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Elevated}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line}"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The "Modify | Walls" tab that appears for a selection: green, as contextual tabs are in
         Revit, so it reads as belonging to what is picked rather than to the application. -->
    <SolidColorBrush x:Key="Context.Accent" Color="#FF3F9A3F"/>
    <SolidColorBrush x:Key="Context.Wash" Color="#2A3F9A3F"/>

    <Style x:Key="ContextRibbonTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Background="{StaticResource Context.Wash}" BorderBrush="{StaticResource Context.Accent}"
                            BorderThickness="1,3,1,0" Padding="13,2,13,5" Margin="6,0,0,0">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Elevated}"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A panel on the contextual tab: its caption in the tab's green. -->
    <Style x:Key="ContextRibbonPanel" TargetType="HeaderedContentControl" BasedOn="{StaticResource RibbonPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="4,4,4,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource Context.Wash}" Margin="-4,2,-4,0">
                                <TextBlock Text="{TemplateBinding Header}" HorizontalAlignment="Center"
                                           Foreground="{StaticResource Text}" Margin="0,1,0,2"
                                           FontSize="{StaticResource UiFontSizeSmall}"/>
                            </Border>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The File button at the head of the tabs: the one coloured tab, as it is in CAD ribbons. -->
    <Style x:Key="FileTabButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="#FF1E6FC0" Padding="16,4,16,5">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF2B82D6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quick access buttons: just the icon, small, across the top of the window. -->
    <Style x:Key="QuickButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="2" Padding="3">
                        <Image Source="{TemplateBinding Tag}" Width="18" Height="18"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The strip across the top of each view: its name, and a close button where it has one. -->
    <Style x:Key="ViewTitle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- The heading over a docked palette: "Properties", "Project Browser". -->
    <Style x:Key="PaletteTitle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Window}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
</ResourceDictionary>
