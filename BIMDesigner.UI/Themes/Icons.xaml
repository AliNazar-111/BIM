<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The ribbon's icons, drawn as vectors on a 32 by 32 square so they stay sharp at any
        size and any display scaling. Each starts with a clear square the full size, so every
        icon scales by the same amount and they line up.

        Colours say what a thing is made of, the way a CAD ribbon's do: grey for walls and
        structure, brown for timber doors, blue for glass, red for roofs, green for rooms and
        annotation that follows the model, blue for the selection and editing tools.
    -->

    <SolidColorBrush x:Key="Ink.Line" Color="#FF3C4148"/>
    <SolidColorBrush x:Key="Ink.Wall" Color="#FFB9BDC3"/>
    <SolidColorBrush x:Key="Ink.WallTop" Color="#FFDCDFE3"/>
    <SolidColorBrush x:Key="Ink.WallSide" Color="#FF8F949B"/>
    <SolidColorBrush x:Key="Ink.Glass" Color="#FF7FC4EA"/>
    <SolidColorBrush x:Key="Ink.Timber" Color="#FFB07A48"/>
    <SolidColorBrush x:Key="Ink.Roof" Color="#FFC8503C"/>
    <SolidColorBrush x:Key="Ink.Blue" Color="#FF1E7FD0"/>
    <SolidColorBrush x:Key="Ink.Green" Color="#FF2E9E5B"/>
    <SolidColorBrush x:Key="Ink.Orange" Color="#FFE08A1E"/>
    <SolidColorBrush x:Key="Ink.Purple" Color="#FF7B5EA7"/>
    <SolidColorBrush x:Key="Ink.Red" Color="#FFD23A2E"/>
    <SolidColorBrush x:Key="Ink.Room" Color="#FFF3C9C3"/>
    <SolidColorBrush x:Key="Ink.Paper" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Ink.Yellow" Color="#FFF2C84B"/>

    <Pen x:Key="Stroke" Brush="{StaticResource Ink.Line}" Thickness="1.2" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
    <Pen x:Key="Stroke.Blue" Brush="{StaticResource Ink.Blue}" Thickness="2" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
    <Pen x:Key="Stroke.Green" Brush="{StaticResource Ink.Green}" Thickness="1.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
    <Pen x:Key="Stroke.Purple" Brush="{StaticResource Ink.Purple}" Thickness="1.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
    <Pen x:Key="Stroke.Red" Brush="{StaticResource Ink.Red}" Thickness="2.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
    <Pen x:Key="Stroke.Orange" Brush="{StaticResource Ink.Orange}" Thickness="1.6" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
    <Pen x:Key="Stroke.Dash" Brush="{StaticResource Ink.Line}" Thickness="1.2" DashStyle="{x:Static DashStyles.Dash}"/>

    <RectangleGeometry x:Key="Frame" Rect="0,0,32,32"/>

