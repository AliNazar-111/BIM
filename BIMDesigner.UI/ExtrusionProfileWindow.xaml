<Window x:Class="BIMDesigner.UI.ExtrusionProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BIMDesigner.UI.Controls"
        Title="Roof Profile" Height="640" Width="1080" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Preset" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <EventSetter Event="Click" Handler="OnPreset"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- What the profile comes to, or what is wrong with it; and the buttons that finish. -->
        <Border DockPanel.Dock="Bottom" Padding="16,9,16,12"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Text.Muted}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OkButton" Content="Finish" Padding="22,5" Margin="0,0,8,0" IsDefault="True"
                            Click="OnOk" ToolTip="Make the roof with this profile"/>
                    <Button Content="Cancel" Padding="18,5" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Where to start from, and the numbers the starting shapes are set out by. -->
        <Border DockPanel.Dock="Left" Width="230" Padding="16,4,16,12"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="START FROM" Style="{StaticResource Caption}"/>
                <Button Style="{StaticResource Preset}" Content="Gable" Tag="Gable"
                        ToolTip="Up to a ridge over the middle and down again"/>
                <Button Style="{StaticResource Preset}" Content="Gambrel" Tag="Gambrel"
                        ToolTip="Two pitches a side: steep below, shallow above - the barn roof"/>
                <Button Style="{StaticResource Preset}" Content="Barrel Vault" Tag="Barrel"
                        ToolTip="An arch over the span"/>
                <Button Style="{StaticResource Preset}" Content="Shed" Tag="Shed"
                        ToolTip="One pitch, rising across the span"/>
                <Button Style="{StaticResource Preset}" Content="Butterfly" Tag="Freeform"
                        ToolTip="Two pitches falling to a gutter in the middle"/>
                <Button Style="{StaticResource Preset}" Content="Flat" Tag="Flat"
                        ToolTip="Level across the span"/>

                <TextBlock Text="SET OUT BY" Style="{StaticResource Caption}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rise" Style="{StaticResource Field}"/>
                    <TextBox Grid.Column="1" x:Name="RiseBox" Style="{StaticResource Num}"
                             ToolTip="How high the profile rises above its eaves, for the shapes above"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Overhang" Style="{StaticResource Field}"/>
                    <TextBox Grid.Column="1" x:Name="OverhangBox" Style="{StaticResource Num}"
                             ToolTip="How far the eaves carry on past each side of the span, down at their own pitch"/>
                </Grid>

                <TextBlock Text="ROOF" Style="{StaticResource Caption}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Base" Style="{StaticResource Field}"/>
                    <TextBox Grid.Column="1" x:Name="BaseBox" Style="{StaticResource Num}"
                             ToolTip="How far above its level the roof's base is - where its underside sits on the walls"/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource Text.Muted}"
                           FontSize="{StaticResource UiFontSizeSmall}"
                           Text="Drag a point to move it. Drag the diamond in the middle of a line to bend it into an arc, and back to straighten it. Double-click a line to add a point on it; right-click a point to take it out. The profile is the roof's underside: its build-up stands on it."/>
            </StackPanel>
        </Border>

        <controls:ExtrusionProfileEditor x:Name="Editor" Margin="4"/>
    </DockPanel>
</Window>
