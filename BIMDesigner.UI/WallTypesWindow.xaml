<Window x:Class="BIMDesigner.UI.WallTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BIMDesigner.UI.Controls"
        Title="Wall Types" Height="980" Width="1060" MinHeight="520" MinWidth="940"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Buttons along the bottom -->
        <Border DockPanel.Dock="Bottom" Padding="16,10,16,14"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ProblemText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="#E8806A"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RevertButton" Content="Revert" Padding="14,5" Margin="0,0,8,0"
                            Click="OnRevert" ToolTip="Throw away the changes not yet applied"/>
                    <Button x:Name="ApplyButton" Content="Apply" Padding="18,5" Margin="0,0,8,0"
                            Click="OnApply" ToolTip="Apply to this type - every wall of it changes"/>
                    <Button Content="Close" Padding="18,5" IsCancel="True" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- On a short screen the editor scrolls rather than squeezing the layers table to nothing. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,14,16,12" MinHeight="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The types in the project -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="WALL TYPES" Style="{StaticResource Caption}"/>

                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="Duplicate" Padding="12,5" Margin="0,0,8,8" Click="OnDuplicate"
                            ToolTip="A new type starting from this one, to change without touching its walls"/>
                    <Button x:Name="DeleteButton" Content="Delete" Padding="12,5" Margin="0,0,8,8" Click="OnDelete"
                            ToolTip="Only a type no wall uses can be deleted"/>
                    <Button Content="New Stacked" Padding="12,5" Margin="0,0,8,8" Click="OnNewStacked"
                            ToolTip="A wall of other wall types one above another"/>
                    <Button Content="New Curtain" Padding="12,5" Margin="0,0,8,8" Click="OnNewCurtain"
                            ToolTip="A wall of glass panels held in mullions"/>
                </WrapPanel>

                <ListBox x:Name="TypeList" Margin="0,8,0,0" SelectionChanged="OnTypeSelected"
                         Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Line}"
                         Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,5">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Text.Muted}"
                                           FontSize="{StaticResource UiFontSizeSmall}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- The type being edited -->
            <DockPanel x:Name="LayeredPanel" Grid.Column="2">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="4" TextChanged="OnDesignChanged"/>

                    <TextBlock Grid.Row="2" Text="Function" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="FunctionPicker" Grid.Row="2" Grid.Column="1" SelectionChanged="OnDesignChanged"
                              ToolTip="Where this wall sits in the building - used by view filters and schedules"/>

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Width" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="WidthText" Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="4" Text="Wrap at openings" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="InsertWrapPicker" Grid.Row="4" Grid.Column="1" SelectionChanged="OnDesignChanged"
                              ToolTip="Which finishes return into door and window openings"/>

                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Wrap at ends" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="EndWrapPicker" Grid.Row="4" Grid.Column="4" SelectionChanged="OnDesignChanged"
                              ToolTip="Which finishes turn round an exposed wall end"/>
                </Grid>

                <controls:WallTypePreview x:Name="Preview" DockPanel.Dock="Bottom" Height="130" Margin="0,12,0,0"/>

                <!-- Bands of other materials up a layer: a tile band at the foot of the plaster -->
                <DockPanel x:Name="BandSection" DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="BANDS" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="BandHint" Visibility="Collapsed" Margin="0,3,0,0" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                                   Text="This type has no bands yet. Pick the layer in LAYERS above - or none for the inside finish - and click Add Band."/>
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Text.Disabled}"
                                   FontSize="{StaticResource UiFontSizeSmall}" TextWrapping="Wrap"
                                   Text="A layer made of another material between two heights - a tile band at the foot of the plaster, brick under render. From and To are up from the bottom of the wall; leave To empty to run to the top. Later bands lie over earlier ones."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add Band" Padding="12,5" Margin="0,0,8,0" Click="OnAddBand"
                                ToolTip="Split a band off the selected layer - or the inside finish - and give it another material"/>
                        <Button x:Name="RemoveBandButton" Content="Remove" Padding="12,5" Click="OnRemoveBand"
                                ToolTip="Merge the band back into its layer"/>
                    </StackPanel>

                    <DataGrid x:Name="BandGrid" Height="96" AutoGenerateColumns="False" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False" SelectionMode="Single" RowHeight="40"
                              SelectionChanged="OnBandSelected">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="3,3"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="28"/>
                            </Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Layer" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding Layers}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding Layer, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="The layer the band is split off"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Material" Width="200">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="What the band is made of"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="From" Width="90">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding BottomText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="How far up from the bottom of the wall the band starts"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="To" Width="90">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding TopText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="How far up it stops; empty runs to the top of the wall"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Profiles along the faces: skirtings, plinths, cornices, grooves -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="SWEEPS AND REVEALS" Style="{StaticResource Caption}"/>
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Text.Disabled}"
                                   FontSize="{StaticResource UiFontSizeSmall}" TextWrapping="Wrap"
                                   Text="A sweep stands out from the face, a reveal is cut into it. Depth is how far out or in; Distance is up from the base or down from the top; Offset moves it off the face. Scroll right for Setback, Flip, Cuts Wall, Cuttable and Returns."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add Sweep" Padding="12,5" Margin="0,0,8,0" Click="OnAddSweep"/>
                        <Button Content="Add Reveal" Padding="12,5" Margin="0,0,8,0" Click="OnAddReveal"/>
                        <Button x:Name="RemoveSweepButton" Content="Remove" Padding="12,5" Margin="0,0,8,0" Click="OnRemoveSweep"/>
                        <Button Content="Profiles..." Padding="12,5" Click="OnSweepProfiles"
                                ToolTip="Draw your own sweep shapes to use here and in placed sweeps"/>
                    </StackPanel>

                    <DataGrid x:Name="SweepGrid" Height="130" AutoGenerateColumns="False" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False" SelectionMode="Single" RowHeight="40"
                              SelectionChanged="OnSweepSelected">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="3,3"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="28"/>
                            </Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Kind" Width="90">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding KindChoices}" SelectedItem="{Binding KindName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Profile" Width="100">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding ProfileChoices}" IsEnabled="{Binding HasProfile}"
                                              SelectedItem="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Side" Width="90">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding SideChoices}" SelectedItem="{Binding SideName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Depth" Width="80">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding DepthText, UpdateSourceTrigger=LostFocus}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Height" Width="80">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding HeightText, UpdateSourceTrigger=LostFocus}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="From" Width="72">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding FromChoices}" SelectedItem="{Binding FromName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Distance" Width="80">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding ElevationText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="How far up from the wall's base, or down from its top"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Material" Width="140">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Offset" Width="72">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding OffsetText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Off the face; negative sets it into the wall"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Setback" Width="72">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding SetbackText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="How far it stops short of the wall's ends"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Flip" Width="44">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding Flip, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              ToolTip="Turn the profile upside down"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cuts Wall" Width="70">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding CutsWall, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              ToolTip="Set into the wall with a negative offset, it cuts its own recess"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cuttable" Width="66">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding Cuttable, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              ToolTip="Broken by doors and windows"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Returns" Width="62">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding Returns, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              ToolTip="Turn round an exposed wall end instead of stopping flat"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add Layer" Padding="12,5" Margin="0,0,8,0" Click="OnAddLayer"
                            ToolTip="Add a layer below the selected one"/>
                    <Button x:Name="RemoveLayerButton" Content="Remove" Padding="12,5" Margin="0,0,8,0" Click="OnRemoveLayer"/>
                    <Button x:Name="UpButton" Content="Move Out" Padding="12,5" Margin="0,0,8,0" Click="OnMoveUp"
                            ToolTip="Toward the exterior face"/>
                    <Button x:Name="DownButton" Content="Move In" Padding="12,5" Click="OnMoveDown"
                            ToolTip="Toward the interior face"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,6">
                    <TextBlock Text="LAYERS" Style="{StaticResource Caption}"/>
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Text.Disabled}"
                               FontSize="{StaticResource UiFontSizeSmall}" TextWrapping="Wrap"
                               Text="Exterior face at the top, interior face at the bottom. The number is the join priority: where walls meet, lower numbers join first. The core runs from the first Structure layer to the last; only layers outside it wrap. A membrane is a line with no thickness."/>
                </StackPanel>

                <DataGrid x:Name="LayerGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserSortColumns="False" SelectionMode="Single"
                          RowHeight="40" 
                          SelectionChanged="OnLayerSelected">
                    <!-- The theme's rows are sized for text. These hold combo boxes and text boxes,
                         which need the height and less padding round them. -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Resources>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="MinHeight" Value="28"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="14" Height="14" Background="{Binding Swatch}"
                                            BorderBrush="{StaticResource Line.Strong}" BorderThickness="1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Function" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding FunctionChoices}"
                                              SelectedItem="{Binding FunctionName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Material" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thickness" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ThicknessText, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanEditThickness}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Wraps" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Wraps, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanWrap}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Core" Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCore}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- A stacked type: its tiers, top of the wall first -->
            <DockPanel x:Name="StackedPanel" Grid.Column="2" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StackNameBox" Grid.Column="1" TextChanged="OnDesignChanged"/>
                </Grid>

                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,6">
                    <TextBlock Text="TIERS" Style="{StaticResource Caption}"/>
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Text.Disabled}"
                               FontSize="{StaticResource UiFontSizeSmall}" TextWrapping="Wrap"
                               Text="Top of the wall first. Each tier is a wall type and a height; exactly one is variable and takes whatever height the wall has left. Plans show the tier 1200 mm above the base."/>
                </StackPanel>

                <controls:StackedWallPreview x:Name="StackPreview" DockPanel.Dock="Bottom" Height="170" Margin="0,12,0,0"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add Tier" Padding="12,5" Margin="0,0,8,0" Click="OnAddTier"
                            ToolTip="Add a tier below the selected one"/>
                    <Button x:Name="RemoveTierButton" Content="Remove" Padding="12,5" Margin="0,0,8,0" Click="OnRemoveTier"/>
                    <Button x:Name="TierUpButton" Content="Move Up" Padding="12,5" Margin="0,0,8,0" Click="OnTierUp"/>
                    <Button x:Name="TierDownButton" Content="Move Down" Padding="12,5" Click="OnTierDown"/>
                </StackPanel>

                <DataGrid x:Name="TierGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserSortColumns="False" SelectionMode="Single" RowHeight="40"
                          SelectionChanged="OnTierSelected">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Padding" Value="4,3"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Wall type" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding WallTypes}" DisplayMemberPath="Name"
                                              SelectedValuePath="Id" VerticalAlignment="Center"
                                              SelectedValue="{Binding WallTypeId, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Height" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding HeightText, UpdateSourceTrigger=LostFocus}" MinHeight="28"
                                             IsEnabled="{Binding CanEditHeight}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Variable" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsVariable, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- A curtain wall type: its grid, panels and mullions -->
            <DockPanel x:Name="CurtainPanel" Grid.Column="2" Visibility="Collapsed">
                <controls:CurtainWallPreview x:Name="CurtainPreview" DockPanel.Dock="Bottom" Height="190" Margin="0,12,0,0"/>

                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CurtainNameBox" Grid.Column="1" Grid.ColumnSpan="4" TextChanged="OnDesignChanged"/>

                    <TextBlock Grid.Row="2" Text="Function" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CurtainFunctionPicker" Grid.Row="2" Grid.Column="1" SelectionChanged="OnDesignChanged"/>

                    <!-- Grid lines -->
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="VERTICAL GRID  (ALONG THE WALL)" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Text="HORIZONTAL GRID  (UP THE WALL)" Style="{StaticResource Caption}"/>

                    <TextBlock Grid.Row="6" Text="Layout" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="VerticalLayoutPicker" Grid.Row="6" Grid.Column="1" SelectionChanged="OnDesignChanged"/>
                    <TextBlock Grid.Row="6" Grid.Column="3" Text="Layout" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="HorizontalLayoutPicker" Grid.Row="6" Grid.Column="4" SelectionChanged="OnDesignChanged"/>

                    <TextBlock Grid.Row="8" Text="Spacing" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="VerticalSpacingBox" Width="90" TextChanged="OnDesignChanged"
                                 ToolTip="Between lines for a fixed distance; the widest a panel may be for a maximum spacing"/>
                        <TextBlock Text="Panels" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"/>
                        <TextBox x:Name="VerticalCountBox" Width="44" TextChanged="OnDesignChanged"
                                 ToolTip="How many equal panels along the wall, for a fixed number"/>
                    </StackPanel>
                    <TextBlock Grid.Row="8" Grid.Column="3" Text="Spacing" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="8" Grid.Column="4" Orientation="Horizontal">
                        <TextBox x:Name="HorizontalSpacingBox" Width="90" TextChanged="OnDesignChanged"/>
                        <TextBlock Text="Panels" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"/>
                        <TextBox x:Name="HorizontalCountBox" Width="44" TextChanged="OnDesignChanged"/>
                    </StackPanel>

                    <TextBlock Grid.Row="10" Text="Start from" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="VerticalJustificationPicker" Grid.Row="10" Grid.Column="1" SelectionChanged="OnDesignChanged"
                              ToolTip="For a fixed distance: which end the lines are measured from, which is where the odd-sized panel goes"/>
                    <TextBlock Grid.Row="10" Grid.Column="3" Text="Start from" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="HorizontalJustificationPicker" Grid.Row="10" Grid.Column="4" SelectionChanged="OnDesignChanged"/>

                    <!-- Panels -->
                    <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="PANELS" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Row="12" Grid.Column="3" Grid.ColumnSpan="2" Text="MULLIONS" Style="{StaticResource Caption}"/>

                    <TextBlock Grid.Row="14" Text="Thickness" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PanelThicknessBox" Grid.Row="14" Grid.Column="1" Width="90" HorizontalAlignment="Left" TextChanged="OnDesignChanged"/>
                    <TextBlock Grid.Row="14" Grid.Column="3" Text="Profile" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="14" Grid.Column="4" Orientation="Horizontal">
                        <ComboBox x:Name="MullionProfilePicker" Width="120" SelectionChanged="OnDesignChanged"/>
                        <CheckBox x:Name="BorderMullionsBox" Content="Border mullions" Margin="12,0,0,0" VerticalAlignment="Center"
                                  Checked="OnDesignChanged" Unchecked="OnDesignChanged"
                                  ToolTip="Frame the ends, top and bottom of the wall as well as the lines between panels"/>
                    </StackPanel>

                    <TextBlock Grid.Row="16" Text="Glass" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="GlassPicker" Grid.Row="16" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="OnDesignChanged"/>
                    <TextBlock Grid.Row="16" Grid.Column="3" Text="Size" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="16" Grid.Column="4" Orientation="Horizontal">
                        <TextBox x:Name="MullionWidthBox" Width="70" TextChanged="OnDesignChanged"
                                 ToolTip="Width seen face-on, or the diameter of a round mullion. 0 for no mullions"/>
                        <TextBlock Text="by" Style="{StaticResource FieldLabel}" Margin="8,0,8,0"/>
                        <TextBox x:Name="MullionDepthBox" Width="70" TextChanged="OnDesignChanged"
                                 ToolTip="How deep a rectangular mullion is through the wall"/>
                    </StackPanel>

                    <TextBlock Grid.Row="18" Text="Solid panel" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="SolidPicker" Grid.Row="18" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="OnDesignChanged"/>
                    <TextBlock Grid.Row="18" Grid.Column="3" Text="Material" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MullionMaterialPicker" Grid.Row="18" Grid.Column="4" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="OnDesignChanged"/>

                    <CheckBox x:Name="EmbedBox" Grid.Row="20" Grid.ColumnSpan="5" Content="Automatically embed: drawn inside another wall, cut an opening in it"
                              Checked="OnDesignChanged" Unchecked="OnDesignChanged"/>
                </Grid>
            </DockPanel>
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
