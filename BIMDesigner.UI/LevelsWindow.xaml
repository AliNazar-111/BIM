<Window x:Class="BIMDesigner.UI.LevelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Levels" Height="440" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,14,16,10">
            <StackPanel>
                <TextBlock Text="STOREYS" Foreground="{StaticResource Text.Muted}"
                           FontSize="{StaticResource UiFontSizeSmall}" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{StaticResource Text.Muted}"
                           Text="Edit a name or an elevation in place. Moving a level moves everything hosted on it, and every wall that reaches up to it follows."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10,16,14"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Add Level" Padding="12,5" Margin="0,0,8,0" Click="OnAddLevel"/>
                    <Button x:Name="DeleteButton" Content="Delete Level" Padding="12,5"
                            IsEnabled="False" Click="OnDeleteLevel"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Close" Padding="18,5" IsCancel="True" IsDefault="True"
                        Click="OnClose"/>
            </Grid>
        </Border>

        <DataGrid x:Name="LevelGrid" Margin="16,0,16,12"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  SelectionChanged="OnSelectionChanged"
                  CellEditEnding="OnCellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Elevation" Width="150" Binding="{Binding Elevation}"/>
                <DataGridTextColumn Header="On this level" Width="110" IsReadOnly="True"
                                    Binding="{Binding Contents, Mode=OneWay}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
