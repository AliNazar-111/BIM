<Window x:Class="BIMDesigner.UI.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Properties" Height="600" Width="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,14,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox x:Name="NameBox" Grid.Column="1" LostFocus="OnNameChanged"/>
                <TextBlock Grid.Column="3" Text="Category" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CategoryPicker" Grid.Column="4" SelectionChanged="OnCategoryChanged"
                          ToolTip="What the schedule lists. Changing it keeps only the fields the new category has"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10,16,14"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Problem" VerticalAlignment="Center" Foreground="#C0392B" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="OK" Padding="22,5" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
                    <Button Content="Cancel" Padding="14,5" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="16,0,16,12">
            <TabItem Header="Fields">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Available fields" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Grid.Column="2" Text="Scheduled fields, in order" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="AvailableList" Grid.Row="1" SelectionMode="Extended" MouseDoubleClick="OnAddField"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <Button Content="Add →" Padding="10,4" Margin="0,0,0,6" Click="OnAddField"/>
                        <Button Content="← Remove" Padding="10,4" Click="OnRemoveField"/>
                    </StackPanel>
                    <ListBox x:Name="ScheduledList" Grid.Row="1" Grid.Column="2" MouseDoubleClick="OnRemoveField"/>
                    <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Content="Up" Padding="10,4" Margin="0,0,0,6" Click="OnFieldUp"/>
                        <Button Content="Down" Padding="10,4" Click="OnFieldDown"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Calculated">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add" Padding="12,4" Margin="0,0,8,0" Click="OnAddCalculated"/>
                            <Button Content="Remove" Padding="12,4" Click="OnRemoveCalculated"/>
                        </StackPanel>
                        <ListBox x:Name="CalculatedList" SelectionChanged="OnCalculatedPicked"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CalculatedDetails"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Filter">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                               Text="Only the rows that pass every filter are listed. Numbers are compared as numbers: lengths in millimetres, areas in square metres."/>
                    <Button DockPanel.Dock="Bottom" Content="Add Filter" Padding="12,4" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnAddFilter"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FilterRows"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Sorting/Grouping">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SortingDetails" Margin="10"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Formatting">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                               Text="A cell is coloured where it passes a rule for its field - the first that passes. Between takes two values, from and to."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add Rule" Padding="12,4" Margin="0,0,16,0" Click="OnAddFormat"/>
                        <CheckBox x:Name="FormatsOnSheetsBox" Content="Show the colours on sheets too" VerticalAlignment="Center" Click="OnFormatsOnSheets"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FormatRows"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
